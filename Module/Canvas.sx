use GFX.Color
use GFX.Canvas.Canvas as AuthoredCanvas
use GFX.Canvas.Geometry.Mesh
use GFX.Canvas.Prepared
use GFX.Canvas.Snapshot
use GFX.Canvas.TextLayer
use GFX.Scene2D.Transform
use STD.Math

public enum Space {
    world
    viewport
}

struct AffineModel {
    let x:Math.Vec2
    let y:Math.Vec2
    let translation:Math.Vec2
}

// Retained Canvas content placed by Transform in either the Y-up 2D world or
// the top-left, Y-down logical application viewport. Authored Canvas content
// remains Y-down in both spaces and is oriented internally for the world.
public struct Canvas {
    private var authored:AuthoredCanvas
    private var authored_revision:int
    private var prepared:Prepared
    private var current_revision:int
    private let drawing_width:int
    private let drawing_height:int
    private let framed:bool
    var space:Space
    var anchor:Math.Vec2
    var size:Math.Vec2
    var pivot:Math.Vec2
    var color:Color
    var layer:int
    var depth:float
    var visible:bool

    init(drawing:AuthoredCanvas, width:int, height:int) {
        if width <= 0 || height <= 0 {
            panic("GFX.Scene2D.Canvas dimensions must be positive")
        }
        self.authored = drawing
        self.authored_revision = drawing.revision()
        self.prepared = Prepared()
        drawing.prepare(self.prepared, width, height)
        self.current_revision = 1
        self.drawing_width = width
        self.drawing_height = height
        self.framed = true
        self.space = Space.world
        self.anchor = Math.Vec2()
        self.size = Math.Vec2()
        self.pivot = Math.Vec2(0.5)
        self.color = Color.white()
        self.layer = 0
        self.depth = 0.0
        self.visible = true
    }

    init(drawing:AuthoredCanvas) {
        self.authored = drawing
        self.authored_revision = drawing.revision()
        self.prepared = Prepared()
        drawing.prepare(self.prepared)
        self.current_revision = 1
        self.drawing_width = 0
        self.drawing_height = 0
        self.framed = false
        self.space = Space.world
        self.anchor = Math.Vec2()
        self.size = Math.Vec2()
        self.pivot = Math.Vec2()
        self.color = Color.white()
        self.layer = 0
        self.depth = 0.0
        self.visible = true
    }

    func replace(drawing:AuthoredCanvas) {
        self.authored = drawing
        self.refresh()
        self.authored_revision = drawing.revision()
    }

    func snapshot() Snapshot {
        var drawing = self.authored
        if self.framed {
            return drawing.snapshot(self.drawing_width, self.drawing_height)
        }
        return drawing.snapshot()
    }
    func revision() int { return self.current_revision }
    func width() int { return self.drawing_width }
    func height() int { return self.drawing_height }
    func is_framed() bool { return self.framed }
    module func prepared_revision() int { return self.prepared.revision() }
    module func geometry_revision() int { return self.prepared.geometry_revision() }
    module func geometry() Mesh { return self.prepared.geometry() }
    module func has_text() bool { return self.prepared.has_text() }
    module func text_layers() TextLayer[] { return self.prepared.text_layers() }
    module func uses_viewport() bool { return self.space == Space.viewport }

    module func synchronize() {
        let revision = self.authored.revision()
        if revision == self.authored_revision { return }
        self.refresh()
        self.authored_revision = revision
    }

    private func refresh() {
        var drawing = self.authored
        if self.framed {
            drawing.prepare(self.prepared, self.drawing_width, self.drawing_height)
        } else {
            drawing.prepare(self.prepared)
        }
        self.current_revision++
    }

    module func display_size() Math.Vec2 {
        if self.size.x > 0.0 && self.size.y > 0.0 { return self.size }
        return Math.Vec2(self.drawing_width as float, self.drawing_height as float)
    }

    module func affine_model(transform:@Transform, viewport:Math.Vec2) AffineModel {
        let position = self.placed_position(transform, viewport)
        let transform_x = transform.scale.x
        let transform_y = self.oriented_scale_y(transform.scale.y)
        if !self.framed {
            if transform.rotation == 0.0 {
                return AffineModel(
                    x:Math.Vec2(transform_x, 0.0),
                    y:Math.Vec2(0.0, transform_y),
                    translation:position
                )
            }
            let cosine = Math.cos(transform.rotation)
            let sine = Math.sin(transform.rotation)
            return AffineModel(
                x:Math.Vec2(cosine * transform_x, sine * transform_x),
                y:Math.Vec2(-sine * transform_y, cosine * transform_y),
                translation:position
            )
        }
        let displayed = self.display_size()
        let resized = self.size.x > 0.0 && self.size.y > 0.0
        let scale_x = affine_scale(
            transform_x,
            displayed.x,
            self.drawing_width,
            resized
        )
        let scale_y = affine_scale(
            transform_y,
            displayed.y,
            self.drawing_height,
            resized
        )
        let pivot_x = -self.pivot.x * displayed.x
        let pivot_y = -self.pivot.y * displayed.y
        if transform.rotation == 0.0 {
            return AffineModel(
                x:Math.Vec2(scale_x, 0.0),
                y:Math.Vec2(0.0, scale_y),
                translation:Math.Vec2(
                    position.x + transform_x * pivot_x,
                    position.y + transform_y * pivot_y
                )
            )
        }
        let cosine = Math.cos(transform.rotation)
        let sine = Math.sin(transform.rotation)
        return AffineModel(
            x:Math.Vec2(cosine * scale_x, sine * scale_x),
            y:Math.Vec2(-sine * scale_y, cosine * scale_y),
            translation:Math.Vec2(
                position.x + cosine * transform_x * pivot_x -
                    sine * transform_y * pivot_y,
                position.y + sine * transform_x * pivot_x +
                    cosine * transform_y * pivot_y
            )
        )
    }

    package func model(transform:@Transform, viewport:Math.Vec2) Math.Mat4 {
        let affine = self.affine_model(transform, viewport)
        return Math.Mat4(
            Math.Vec4(affine.x.x, affine.x.y, 0.0, 0.0),
            Math.Vec4(affine.y.x, affine.y.y, 0.0, 0.0),
            Math.Vec4(0.0, 0.0, 1.0, 0.0),
            Math.Vec4(
                affine.translation.x,
                affine.translation.y,
                self.depth,
                1.0
            )
        )
    }

    module func text_model(transform:@Transform, viewport:Math.Vec2) Math.Mat4 {
        let position = self.placed_position(transform, viewport)
        let scale_y = self.oriented_scale_y(transform.scale.y)
        return Math.Mat4.transform(
            Math.Vec3(position.x, position.y, 0.0),
            Math.Quat.angle_axis(transform.rotation, Math.Vec3.back()).to_mat3(),
            Math.Vec3(transform.scale.x, scale_y, 1.0)
        )
    }

    module func text_size(content:Math.Vec2) Math.Vec2 {
        if !self.framed { return content }
        let displayed = self.display_size()
        return Math.Vec2(
            content.x * displayed.x / self.drawing_width as float,
            content.y * displayed.y / self.drawing_height as float
        )
    }

    module func text_pivot(origin:Math.Vec2, content:Math.Vec2) Math.Vec2 {
        if !self.framed {
            if content.x <= 0.0 || content.y <= 0.0 { return Math.Vec2() }
            return Math.Vec2(-origin.x / content.x, -origin.y / content.y)
        }
        let displayed = self.display_size()
        let resolved_x = content.x * displayed.x / self.drawing_width as float
        let resolved_y = content.y * displayed.y / self.drawing_height as float
        if resolved_x <= 0.0 || resolved_y <= 0.0 { return Math.Vec2() }
        let pivot_x = (self.pivot.x * displayed.x - origin.x * displayed.x /
            self.drawing_width as float) / resolved_x
        let pivot_y = (self.pivot.y * displayed.y - origin.y * displayed.y /
            self.drawing_height as float) / resolved_y
        return Math.Vec2(pivot_x, pivot_y)
    }

    private func placed_position(transform:@Transform, viewport:Math.Vec2) Math.Vec2 {
        if self.space == Space.viewport {
            return Math.Vec2(
                viewport.x * self.anchor.x + transform.position.x,
                viewport.y * self.anchor.y + transform.position.y
            )
        }
        return transform.position
    }

    private func oriented_scale_y(value:float) float {
        if self.space == Space.world { return -value }
        return value
    }
}

local func affine_scale(
    transform:float,
    displayed:float,
    authored:int,
    resized:bool
) float {
    if resized { return transform * displayed / authored as float }
    return transform
}
