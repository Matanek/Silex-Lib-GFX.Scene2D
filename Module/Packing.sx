use GFX.Color
use GFX.Assets.Image
use GFX.Canvas.Geometry
use GFX.Canvas.ImageContent
use GFX.Canvas.ImageFit
use GFX.Canvas.ImageMappingKind
use GFX.Scene2D.Grid
use Interop.C
use STD.Math

func drawing_vertices(mesh:@Geometry.Mesh) str {
    let source = mesh.vertices()
    var bytes = storage(source.count() * 36)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    var index = 0
    while index < source.count() {
        let vertex = source[index]
        let offset = index * 36
        write_vec3(address, offset, vertex.position)
        write_vec3(address, offset + 12, vertex.normal)
        write_vec2(address, offset + 24, vertex.uv)
        write_rgba8(address, offset + 32, vertex.color)
        index++
    }
    return bytes
}

func drawing_instance(model:Math.Mat4, color:Color) str {
    var bytes = storage(80)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    write_affine_instance(
        address,
        0,
        Math.Vec2(model.x.x, model.x.y),
        Math.Vec2(model.y.x, model.y.y),
        Math.Vec2(model.w.x, model.w.y),
        model.w.z,
        color
    )
    return bytes
}

func shadow_vertices(mesh:@Geometry.Mesh) str {
    let source = mesh.vertices()
    if source.count() != 6 {
        panic("GFX.Scene2D analytic shadow requires one six-vertex quad")
    }
    let horizontal = Math.Vec2(
        source[1].position.x - source[0].position.x,
        source[1].position.y - source[0].position.y
    )
    let vertical = Math.Vec2(
        source[5].position.x - source[0].position.x,
        source[5].position.y - source[0].position.y
    )
    let axis = horizontal.divide(Math.sqrt(horizontal.length_squared()))
    let normal = vertical.divide(Math.sqrt(vertical.length_squared()))
    let first = source[0]
    let center = Math.Vec2(first.position.x, first.position.y)
        .subtract(axis.multiply(first.uv.x))
        .subtract(normal.multiply(first.uv.y))
    var bytes = storage(source.count() * 60)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    var index = 0
    while index < source.count() {
        let vertex = source[index]
        let offset = index * 60
        write_vec3(address, offset, vertex.position)
        write_vec3(address, offset + 12, vertex.normal)
        write_vec2(address, offset + 24, vertex.uv)
        write_rgba8(address, offset + 32, vertex.color)
        write_vec2(address, offset + 36, center)
        write_vec2(address, offset + 44, axis)
        write_vec2(address, offset + 52, normal)
        index++
    }
    return bytes
}

func image_drawing_uniform(content:@ImageContent) str {
    var paint = content.paint()
    let image = paint.image()
    let mapping = content.mapping()
    var region = Image.Region(0, 0, image.width(), image.height())
    if let selected = mapping.region() { region = selected }
    var destination_origin = mapping.frame().position
    var destination_size = mapping.frame().size
    if mapping.kind() == ImageMappingKind.fit && mapping.mode() != ImageFit.stretch {
        let source_size = Math.Vec2(region.width as float, region.height as float)
        let scale_x = mapping.frame().size.x / source_size.x
        let scale_y = mapping.frame().size.y / source_size.y
        var scale = Math.min(scale_x, scale_y)
        if mapping.mode() == ImageFit.cover { scale = Math.max(scale_x, scale_y) }
        destination_size = source_size.multiply(scale)
        destination_origin = mapping.frame().position.add(
            mapping.frame().size.subtract(destination_size).multiply(mapping.alignment())
        )
    }
    var bytes = storage(80)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    write_vec4(address, 0, Math.Vec4(
        mapping.frame().position.x,
        mapping.frame().position.y,
        mapping.frame().size.x,
        mapping.frame().size.y
    ))
    write_vec4(address, 16, Math.Vec4(
        destination_origin.x,
        destination_origin.y,
        destination_size.x,
        destination_size.y
    ))
    write_vec4(address, 32, Math.Vec4(
        region.x as float,
        region.y as float,
        region.width as float,
        region.height as float
    ))
    write_vec4(address, 48, Math.Vec4(
        mapping.origin().x,
        mapping.origin().y,
        mapping.texel_size().x,
        mapping.texel_size().y
    ))
    var kind = 0.0
    if mapping.kind() == ImageMappingKind.tile { kind = 1.0 }
    var sampling = 0.0
    if mapping.sampling() == GFX.Canvas.ImageSampling.pixelated { sampling = 1.0 }
    write_vec4(address, 64, Math.Vec4(
        image.width() as float,
        image.height() as float,
        kind,
        sampling
    ))
    return bytes
}

func view_projection(value:Math.Mat4) str {
    var bytes = storage(64)
    write_mat4(C.address_bits(C.mutable_string_pointer(bytes)), 0, value)
    return bytes
}

func coverage_draw_uniform(
    view_projection:Math.Mat4,
    model_x:Math.Vec2,
    model_y:Math.Vec2,
    model_translation:Math.Vec2,
    clip:Math.Vec4
) str {
    var bytes = storage(112)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    write_mat4(address, 0, view_projection)
    write_vec2(address, 64, model_x)
    write_vec2(address, 72, model_y)
    write_vec2(address, 80, model_translation)
    write_vec2(address, 88, Math.Vec2())
    write_vec4(address, 96, clip)
    return bytes
}

func grid(inverse_view_projection:Math.Mat4, value:Grid) str {
    var bytes = storage(144)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    write_mat4(address, 0, inverse_view_projection)
    write_color(address, 64, value.minor_color)
    write_color(address, 80, value.major_color)
    write_color(address, 96, value.x_axis_color)
    write_color(address, 112, value.y_axis_color)
    write_vec4(address, 128, Math.Vec4(
        value.spacing,
        value.major_every as float,
        value.line_width,
        value.axis_width
    ))
    return bytes
}

func sprite_uniform(
    model:Math.Mat4,
    projection:Math.Mat4,
    size:Math.Vec2,
    pivot:Math.Vec2,
    color:Color
) str {
    var bytes = storage(256)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    write_mat4(address, 0, model)
    write_mat4(address, 64, Math.Mat4.identity())
    write_mat4(address, 128, projection)
    write_vec2(address, 192, size)
    write_vec2(address, 200, pivot)
    write_color(address, 208, color)
    write_float(address, 224, 0.0)
    write_float(address, 228, 0.0)
    write_vec4(address, 240, Math.Vec4(0.0, 0.0, 1.0, 1.0))
    return bytes
}

func scene_sprite_uniform(
    model:Math.Mat4,
    view_projection:Math.Mat4,
    size:Math.Vec2,
    pivot:Math.Vec2,
    color:Color,
    depth:float,
    region:Math.Vec4
) str {
    var bytes = storage(256)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    write_mat4(address, 0, model)
    write_mat4(address, 64, Math.Mat4.identity())
    write_mat4(address, 128, view_projection)
    write_vec2(address, 192, size)
    write_vec2(address, 200, pivot)
    write_color(address, 208, color)
    write_float(address, 224, depth)
    write_float(address, 228, 0.0)
    write_vec4(address, 240, region)
    return bytes
}

func canvas_effect_uniform(
    width:int,
    height:int,
    direction:Math.Vec2,
    radius:float,
    mode:float,
    offset:Math.Vec2 = Math.Vec2(),
    opacity:float = 1.0,
    shadow:Color = Color.transparent()
) str {
    var bytes = storage(64)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    write_vec4(address, 0, Math.Vec4(
        1.0 / width as float,
        1.0 / height as float,
        width as float,
        height as float
    ))
    write_vec4(address, 16, Math.Vec4(
        direction.x,
        direction.y,
        radius,
        mode
    ))
    write_vec4(address, 32, Math.Vec4(
        offset.x,
        offset.y,
        opacity,
        0.0
    ))
    write_color(address, 48, shadow)
    return bytes
}

func canvas_filter_uniform(
    bounds:GFX.Canvas.Shapes.Rect,
    width:int,
    height:int
) str {
    var bytes = exact_storage(96)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    write_mat4(address, 0, Math.Mat4(
        Math.Vec4(2.0, 0.0, 0.0, 0.0),
        Math.Vec4(0.0, -2.0, 0.0, 0.0),
        Math.Vec4(0.0, 0.0, 1.0, 0.0),
        Math.Vec4(-1.0, 1.0, 0.0, 1.0)
    ))
    write_vec2(address, 64, bounds.position)
    write_vec2(address, 72, bounds.size)
    write_vec2(address, 80, Math.Vec2(width as float, height as float))
    write_vec2(address, 88, Math.Vec2(
        1.0 / width as float,
        1.0 / height as float
    ))
    return bytes
}

func quad_vertices() str {
    var bytes = storage(64)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    write_vec2(address, 0, Math.Vec2(0.0, 0.0)); write_vec2(address, 8, Math.Vec2(0.0, 0.0))
    write_vec2(address, 16, Math.Vec2(1.0, 0.0)); write_vec2(address, 24, Math.Vec2(1.0, 0.0))
    write_vec2(address, 32, Math.Vec2(1.0, 1.0)); write_vec2(address, 40, Math.Vec2(1.0, 1.0))
    write_vec2(address, 48, Math.Vec2(0.0, 1.0)); write_vec2(address, 56, Math.Vec2(0.0, 1.0))
    return bytes
}

func quad_indices() str {
    var bytes = storage(24)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    let values:uint32[] = [0, 1, 2, 0, 2, 3]
    var index = 0
    while index < values.count() {
        let stored = C.store<uint32>(address, (index * 4) as uint, values[index])
        index++
    }
    return bytes
}

func bordered_coverage(alpha:@str, width:int, height:int) str {
    let padded_width = width + 2
    let byte_count = padded_width * (height + 2)
    var bytes = storage(byte_count)
    let source = C.address_bits(C.pointer(alpha))
    let destination = C.address_bits(C.mutable_string_pointer(bytes))
    var y = 0
    while y < height {
        var x = 0
        while x < width {
            let value = C.load<uint8>(source, (y * width + x) as uint)
            let stored = C.store<uint8>(
                destination,
                ((y + 1) * padded_width + x + 1) as uint,
                value
            )
            x++
        }
        y++
    }
    return bytes
}

func write_coverage_instance(
    address:uint,
    offset:int,
    x:Math.Vec2,
    y:Math.Vec2,
    translation:Math.Vec2,
    depth:float,
    region:Math.Vec4,
    color:Color
) {
    write_vec2(address, offset, x)
    write_vec2(address, offset + 8, y)
    write_vec2(address, offset + 16, translation)
    write_float(address, offset + 24, depth)
    write_float(address, offset + 28, 0.0)
    write_vec4(address, offset + 32, region)
    write_color(address, offset + 48, color)
}

func storage(minimum:int) str {
    var bytes = "\0"
    while C.byte_count(bytes) < minimum as uint { bytes = bytes + bytes }
    return bytes
}

func exact_storage(count:int) str {
    var bytes:uint8[] = []
    var index = 0
    while index < count {
        bytes.append(0 as uint8)
        index++
    }
    return C.string(@bytes[0:bytes.count()])
}

local func write_float(address:uint, offset:int, value:float) {
    let stored = C.store<float32>(address, offset as uint, value as float32)
}

local func write_vec2(address:uint, offset:int, value:Math.Vec2) {
    write_float(address, offset, value.x)
    write_float(address, offset + 4, value.y)
}

local func write_vec3(address:uint, offset:int, value:Math.Vec3) {
    write_float(address, offset, value.x)
    write_float(address, offset + 4, value.y)
    write_float(address, offset + 8, value.z)
}

local func write_vec4(address:uint, offset:int, value:Math.Vec4) {
    write_float(address, offset, value.x)
    write_float(address, offset + 4, value.y)
    write_float(address, offset + 8, value.z)
    write_float(address, offset + 12, value.w)
}

func write_mat4(address:uint, offset:int, value:Math.Mat4) {
    write_vec4(address, offset, value.x)
    write_vec4(address, offset + 16, value.y)
    write_vec4(address, offset + 32, value.z)
    write_vec4(address, offset + 48, value.w)
}

func write_affine_instance(
    address:uint,
    offset:int,
    x:Math.Vec2,
    y:Math.Vec2,
    translation:Math.Vec2,
    depth:float,
    color:Color
) {
    write_vec2(address, offset, x)
    write_vec2(address, offset + 8, y)
    write_vec2(address, offset + 16, translation)
    write_float(address, offset + 24, depth)
    write_float(address, offset + 28, 0.0)
    write_color(address, offset + 32, color)
    write_vec2(address, offset + 48, Math.Vec2())
    write_float(address, offset + 56, 0.0)
    write_float(address, offset + 60, 0.0)
    write_color(address, offset + 64, Color.transparent())
}

func write_shadow_instance(
    address:uint,
    offset:int,
    model_x:Math.Vec2,
    model_y:Math.Vec2,
    translation:Math.Vec2,
    depth:float,
    color:Color,
    shadow_offset:Math.Vec2,
    shadow_radius:float,
    shadow_color:Color
) {
    write_affine_instance(
        address,
        offset,
        model_x,
        model_y,
        translation,
        depth,
        color
    )
    write_vec2(address, offset + 48, shadow_offset)
    write_float(address, offset + 56, shadow_radius)
    write_color(address, offset + 64, shadow_color)
}

func copy_affine_instance(
    destination:uint,
    destination_offset:int,
    source:uint,
    source_offset:int
) {
    var byte_offset = 0
    while byte_offset < 80 {
        let value = C.load<uint64>(source, (source_offset + byte_offset) as uint)
        let stored = C.store<uint64>(
            destination,
            (destination_offset + byte_offset) as uint,
            value
        )
        byte_offset += 8
    }
}

func copy_affine_instances(destination:uint, source:uint, count:int) {
    var index = 0
    while index < count {
        copy_affine_instance(destination, index * 80, source, index * 80)
        index++
    }
}

func write_color(address:uint, offset:int, value:Color) {
    write_float(address, offset, value.r)
    write_float(address, offset + 4, value.g)
    write_float(address, offset + 8, value.b)
    write_float(address, offset + 12, value.a)
}

local func write_rgba8(address:uint, offset:int, value:Color) {
    let red = C.store<uint8>(address, offset as uint, color_byte(value.r))
    let green = C.store<uint8>(address, (offset + 1) as uint, color_byte(value.g))
    let blue = C.store<uint8>(address, (offset + 2) as uint, color_byte(value.b))
    let alpha = C.store<uint8>(address, (offset + 3) as uint, color_byte(value.a))
}

local func color_byte(value:float) uint8 {
    return Math.round(Math.clamp(value, 0.0, 1.0) * 255.0) as uint8
}
