    }
    package func coverage_block_cache_index_is_consistent() bool {
        if self.coverage_block_cache_indices.count() !=
            self.coverage_block_cache.count()
        {
            return false
        }
        var index = 0
        while index < self.coverage_block_cache.count() {
            let identity = self.coverage_block_cache[index].identity
            if identity <= 0 || !self.coverage_block_cache_indices.contains(identity) {
                return false
            }
            index++
        }
        var entries = self.coverage_block_cache_indices.iterator()
        while entry = entries.next() {
            if entry.value < 0 || entry.value >= self.coverage_block_cache.count() {
                return false
            }
            if self.coverage_block_cache[entry.value].identity != entry.key {
                return false
            }
        }
        return true
    }
    package func glyph_mesh_count() int {
        var count = 0
        for slot in self.glyph_mesh_cache {
            if slot.drawing != null { count++ }
        }
        return count
    }

    private func cache_index_for_image(
        kind:int,
        index:int,
        generation:int
    ) int {
        let key = image_cache_key(kind, index, generation)
        if self.image_cache_indices.contains(key) {
            return self.image_cache_indices.get(key) + 0
        }
        var created = CachedImage(kind, index, generation)
        self.image_cache.append(created)
        let created_index = self.image_cache.count() - 1
        self.image_cache_indices.set(key, created_index)
        return created_index
    }

    private func refresh_image(
        device:@GPU.Device,
        cache:&CachedImage,
        revision:int,
        image:@Image,
        name:str
    ) {
        if cache.texture != null && cache.revision == revision { return }
        cache.texture = upload_texture(device, image, name)
        cache.revision = revision
        self.image_uploads++
    }

    private func refresh_text_image(
        device:@GPU.Device,
        cache:&CachedImage,
        cache_index:int,
        revision:int,
        image:@Image,
        name:str
    ) {
        if cache.texture != null && cache.revision == revision { return }
        if cache.texture == null || cache.texture_width < image.width() ||
            cache.texture_height < image.height()
        {
            var width = image.width()
            var height = image.height()
            if cache.texture_width > 0 {
                width = cache.texture_width * 2
                if width < image.width() { width = image.width() }
            }
            if cache.texture_height > 0 {
                height = cache.texture_height * 2
                if height < image.height() { height = image.height() }
            }
            cache.texture = device.texture(GPU.TextureSettings(
                format:GPU.TextureFormat.rgba8_unorm,
                width:width,
                height:height,
                usage:GPU.TextureUsage.for_sampling(),
                name:name
            ))
            cache.texture_width = width
            cache.texture_height = height
        }
        let pixel_count = image.byte_count()
        self.text_pixels_uploaded += image.width() * image.height()
        if cache.upload == null || cache.upload_capacity < pixel_count {
            cache.upload = device.upload_buffer(pixel_count, name + " upload")
            cache.upload_capacity = pixel_count
        }
        if let upload = cache.upload {
            upload.write_packed(image.packed_pixels(), pixel_count, cycle:true)
        }
        cache.upload_width = image.width()
        cache.upload_height = image.height()
        self.pending_image_uploads.append(cache_index)
        cache.revision = revision
    }

    private func submit_image_uploads(device:@GPU.Device) {
        if self.pending_image_uploads.is_empty() { return }
        var commands = device.commands()
        var transfer = commands.copy()
        for cache_index in self.pending_image_uploads {
            var cache = self.image_cache[cache_index]
            if let upload = cache.upload {
                if let texture = cache.texture {
                    transfer.upload(
                        upload,
                        GPU.TextureRegion(
                            texture:texture,
                            width:cache.upload_width,
                            height:cache.upload_height
                        ),
                        cache.upload_width,
                        cache.upload_height
                    )
                }
            }
        }
        transfer.finish()
        commands.submit()
        self.pending_image_uploads.clear()
    }

    private func submit_coverage_uploads(device:@GPU.Device) {
        if self.pending_coverage_uploads.is_empty() { return }
        if let upload = self.coverage_upload {
            var commands = device.commands()
            var transfer = commands.copy()
            for pending in self.pending_coverage_uploads {
                var page = self.coverage_atlas_pages[pending.page]
                if let texture = page.texture {
                    transfer.upload(
                        upload,
                        GPU.TextureRegion(
                            texture:texture,
                            x:pending.x,
                            y:pending.y,
                            width:pending.width,
                            height:pending.height
                        ),
                        pending.width,
                        pending.height,
                        pending.offset,
                        false
                    )
                }
            }
            transfer.finish()
            commands.submit()
        }
        self.pending_coverage_uploads.clear()
    }

    private func prepare_coverage_instances(device:@GPU.Device) {
        if self.coverage_glyph_instances.is_empty() {
            self.coverage_instance_active_slot = -1
            return
        }
        let byte_count = self.coverage_glyph_instances.count() * 64
        var packed = pack_coverage_instances(
            self.coverage_glyph_instances
        )
        if self.coverage_instance_active_slot >= 0 &&
            packed == self.coverage_instance_packed
        { return }
        while self.coverage_instance_ring.count() < 4 {
            self.coverage_instance_ring.append(CoverageInstanceSlot())
        }
        self.coverage_instance_ring_cursor =
            (self.coverage_instance_ring_cursor + 1) % self.coverage_instance_ring.count()
        self.coverage_instance_active_slot = self.coverage_instance_ring_cursor
        var slot = self.coverage_instance_ring[self.coverage_instance_active_slot]
        if slot.instances == null || slot.capacity < byte_count {
            var capacity = 4096
            while capacity < byte_count { capacity *= 2 }
            slot.upload = device.upload_buffer(
                capacity,
                "GFX.Scene2D coverage glyph instances upload"
            )
            slot.instances = device.buffer(GPU.BufferSettings(
                size:capacity,
                usage:GPU.BufferUsage.vertex(),
                name:"GFX.Scene2D coverage glyph instances"
            ))
            slot.capacity = capacity
            self.coverage_instance_allocations++
        }
        self.coverage_instance_packed = move packed
        if let upload = slot.upload {
            if let destination = slot.instances {
                upload.write_packed(
                    self.coverage_instance_packed,
                    byte_count
                )
                copy_buffer(device, upload, destination, byte_count, cycle:false)
                self.coverage_instance_uploads++
            }
        }
    }

    private func prepare_tile_instances(device:@GPU.Device) {
        if self.tile_instances.is_empty() { return }
        let byte_count = self.tile_instances.count() * 24
        var packed = pack_tile_instances(self.tile_instances)
        if self.tile_instance_buffer != null && packed == self.tile_instance_packed {
            return
        }
        if self.tile_instance_buffer == null || self.tile_instance_capacity < byte_count {
            var capacity = 4096
            while capacity < byte_count { capacity *= 2 }
            self.tile_instance_upload = device.upload_buffer(
                capacity,
                "GFX.Scene2D tile instances upload"
            )
            self.tile_instance_buffer = device.buffer(GPU.BufferSettings(
                size:capacity,
                usage:GPU.BufferUsage.vertex(),
                name:"GFX.Scene2D tile instances"
            ))
            self.tile_instance_capacity = capacity
            self.tile_instance_allocations++
        }
        self.tile_instance_packed = move packed
        if let upload = self.tile_instance_upload {
            if let destination = self.tile_instance_buffer {
                upload.write_packed(self.tile_instance_packed, byte_count, cycle:true)
                copy_buffer(device, upload, destination, byte_count)
                self.tile_instance_uploads++
            }
        }
    }

    private func prepare_sprite_instances(device:@GPU.Device) {
        if self.sprite_draws.is_empty() { return }
        let byte_count = self.sprite_draws.count() * 80
        var packed = Packing.storage(byte_count)
        let address = C.address_bits(C.mutable_string_pointer(packed))
        self.sprite_instance_indices.clear()
        while self.sprite_instance_indices.count() < self.sprite_draws.count() {
            self.sprite_instance_indices.append(0)
        }
        var instance = 0
        for entry in self.scene_entries {
            if entry.kind == 1 {
                let draw = self.sprite_draws[entry.index]
                self.sprite_instance_indices[entry.index] = instance
                Packing.write_sprite_instance(
                    address,
                    instance * 80,
                    draw.model,
                    draw.size,
                    draw.pivot,
                    draw.color,
                    draw.depth,
                    draw.region
                )
                instance++
            }
        }
        assert(instance == self.sprite_draws.count())
        if self.sprite_instance_buffer != null && packed == self.sprite_instance_packed {
            return
        }
        if self.sprite_instance_buffer == null || self.sprite_instance_capacity < byte_count {
            var capacity = 4096
            while capacity < byte_count { capacity *= 2 }
            self.sprite_instance_upload = device.upload_buffer(
                capacity,
                "GFX.Scene2D sprite instances upload"
            )
            self.sprite_instance_buffer = device.buffer(GPU.BufferSettings(
                size:capacity,
                usage:GPU.BufferUsage.vertex(),
                name:"GFX.Scene2D sprite instances"
            ))
            self.sprite_instance_capacity = capacity
        }
        self.sprite_instance_packed = move packed
        if let upload = self.sprite_instance_upload {
            if let destination = self.sprite_instance_buffer {
                upload.write_packed(self.sprite_instance_packed, byte_count, cycle:true)
                copy_buffer(device, upload, destination, byte_count)
            }
        }
    }

    private func ensure_scene_instance_storage(byte_count:int) {
        if self.drawing_instance_storage_capacity >= byte_count { return }
        var grown = Packing.storage(byte_count)
        let destination = C.address_bits(C.mutable_string_pointer(grown))
        if self.drawing_instance_write_address != 0 {
            Packing.copy_affine_instances(
                destination,
                self.drawing_instance_write_address,
                self.scene_draws.count()
            )
        }
        self.drawing_instance_packed = grown
        self.drawing_instance_storage_capacity = C.byte_count(grown) as int
        self.drawing_instance_write_address = destination
    }

    private func reorder_scene_instances(byte_count:int) {
        var reordered = self.drawing_instance_scratch
        if C.byte_count(reordered) < byte_count as uint {
            reordered = Packing.storage(byte_count)
        }
        let destination = C.address_bits(C.mutable_string_pointer(reordered))
        var index = 0
        while index < self.scene_draws.count() {
            Packing.copy_affine_instance(
                destination,
                index * 80,
                self.drawing_instance_write_address,
                self.scene_draws[index].instance * 80
            )
            index++
        }
        self.drawing_instance_scratch = self.drawing_instance_packed
        self.drawing_instance_packed = reordered
        self.drawing_instance_storage_capacity = C.byte_count(reordered) as int
        self.drawing_instance_write_address = destination
    }

    private func prepare_scene_instances(device:@GPU.Device, reordered:bool) {
        if self.scene_draws.count() == 0 { return }
        let byte_count = self.scene_draws.count() * 80
        if reordered { self.reorder_scene_instances(byte_count) }
        if self.drawing_instances == null || self.drawing_instance_capacity < byte_count {
            self.drawing_instance_upload = device.upload_buffer(
                byte_count,
                "GFX.Scene2D retained drawing instance upload"
            )
            self.drawing_instances = device.buffer(GPU.BufferSettings(
                size:byte_count,
                usage:GPU.BufferUsage.vertex(),
                name:"GFX.Scene2D retained drawing instances"
            ))
            self.drawing_instance_capacity = byte_count
        }
        var bytes = self.drawing_instance_packed
        self.drawing_instance_packed = bytes
        if let upload = self.drawing_instance_upload {
            if let destination = self.drawing_instances {
                upload.write_packed(bytes, byte_count, cycle:true)
                copy_buffer(device, upload, destination, byte_count)
            }
        }
    }

    private func rebuild_scene_entries() {
        self.scene_entries.clear()
        self.append_scene_entries(false)
        let viewport_start = self.scene_entries.count()
        self.append_scene_entries(true)
        sort_scene_entries(self.scene_entries, 0, viewport_start)
        sort_scene_entries(
            self.scene_entries,
            viewport_start,
            self.scene_entries.count()
        )
    }

    private func append_scene_entries(viewport:bool) {
        var index = 0
        while index < self.scene_draws.count() {
            if self.scene_draws[index].viewport == viewport {
                self.scene_entries.append(drawing_entry(
                    index,
                    self.scene_draws[index]
                ))
            }
            index++
        }
        index = 0
        while index < self.sprite_draws.count() {
            if self.sprite_draws[index].viewport == viewport {
                self.scene_entries.append(scene_entry(
                    1,
                    index,
                    self.sprite_draws[index]
                ))
            }
            index++
        }
        index = 0
        while index < self.tile_map_draws.count() {
            if !viewport {
                self.scene_entries.append(tile_map_entry(
                    index,
                    self.tile_map_draws[index]
                ))
            }
            index++
        }
        index = 0
        while index < self.surface_draws.count() {
            if self.surface_draws[index].viewport == viewport {
                self.scene_entries.append(surface_entry(
                    index,
                    self.surface_draws[index]
                ))
            }
            index++
        }
        index = 0
        while index < self.coverage_glyph_draws.count() {
            if self.coverage_glyph_draws[index].viewport == viewport {
                self.scene_entries.append(coverage_entry(
                    index,
                    self.coverage_glyph_draws[index]
                ))
            }
            index++
        }
    }

}

package func analytic_shadow_eligible(content:@Content[]) bool {
    return analytic_shadow_eligible_view(@content[0:content.count()])
}

func analytic_shadow_eligible_view(content:@Content[..]) bool {
    if content.count() != 1 { return false }
    match content[0] {
        layer(value) => { return analytic_shadow_layer(value) != null }
        else => { return false }
    }
}

package func analytic_shadow_diagnostic() str {
    return "GFX.Scene2D Canvas filtered layer is not eligible for the " +
        "analytic shadow path; the GPU effect compositor is not available"
}

// CPU mirror of the shader's one-dimensional Gaussian edge response. Tests
// compare it with Canvas's separable software oracle independently of timing.
package func analytic_blurred_coverage(edge:float, radius:float) float {
    if radius <= 0.0 {
        if edge < 0.0 { return 1.0 }
        return 0.0
    }
    let sigma = Math.max(radius / 3.0, 1.0 / 3.0)
    let value = edge / (sigma * 1.41421356237)
    var sign = 1.0
    if value < 0.0 { sign = -1.0 }
    let x = Math.abs(value)
    if x >= 1.75 {
        return Math.clamp(0.5 * (1.0 - sign), 0.0, 1.0)
    }
    let squared = x * x
    let polynomial = 1.128269906 + squared * (-0.374057723 +
        squared * (0.106547438 + squared * (-0.019925391 +
        squared * 0.001756081)))
    let error = sign * x * polynomial
    return Math.clamp(0.5 * (1.0 - error), 0.0, 1.0)
}

func analytic_shadow_layer(value:@LayerContent) AnalyticShadowIntent? {
    let effects = value.effects()
    if effects.count() != 1 { return null }
    var shadow:ShadowEffect? = null
    match effects[0].value() {
        shadow(effect) => { shadow = effect }
        else => { return null }
    }
    let content = value.content_view()
    if content.count() != 1 { return null }
    match content[0] {
        geometry(mesh) => {
            if !analytic_shadow_geometry(mesh) { return null }
            if let effect = shadow {
                return AnalyticShadowIntent(geometry:mesh, effect:effect)
            }
        }
        else => {}
    }
    return null
}

func analytic_shadow_geometry(mesh:@Mesh) bool {
    if mesh.vertex_count() != 6 || mesh.index_count() != 6 { return false }
    let vertices = mesh.vertices()
    if vertices[0].position.z < 0.0 { return false }
    let alpha = vertices[0].color.a
    let shape = vertices[0].normal
    let mode = vertices[0].position.z
    for vertex in vertices {
        if vertex.position.z != mode || vertex.normal != shape ||
            vertex.color.a != alpha
        {
            return false
        }
    }
    return true
}

local func empty_coverage_glyph_table() int[] {
    var result:int[] = []
    while result.count() < 32_768 { result.append(-1) }
    return result
}

local func pack_coverage_instances(values:@CoverageGlyphInstance[]) str {
    var bytes = Packing.storage(values.count() * 64)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    var index = 0
    while index < values.count() {
        let value = values[index]
        Packing.write_coverage_instance(
            address,
            index * 64,
            value.x,
            value.y,
            value.translation,
            value.depth,
            value.region,
            value.color
        )
        index++
    }
    return bytes
}

local func pack_tile_instances(values:@TileInstance[]) str {
    var bytes = Packing.storage(values.count() * 24)
    let address = C.address_bits(C.mutable_string_pointer(bytes))
    var index = 0
    while index < values.count() {
        let value = values[index]
        Packing.write_tile_instance(
            address,
            index * 24,
            value.translation,
            value.region
        )
        index++
    }
    return bytes
}

local func color_target(format:GPU.TextureFormat) GPU.ColorTargetFormat[] {
    var targets:GPU.ColorTargetFormat[] = []
    targets.append(GPU.ColorTargetFormat(
        format:format,
        blend:GPU.BlendState(
            source_color:GPU.BlendFactor.source_alpha,
            destination_color:GPU.BlendFactor.one_minus_source_alpha,
            source_alpha:GPU.BlendFactor.one,
            destination_alpha:GPU.BlendFactor.one_minus_source_alpha,
            enabled:true
        )
    ))
    return targets
}

local func premultiplied_color_target(
    format:GPU.TextureFormat
) GPU.ColorTargetFormat[] {
    var targets:GPU.ColorTargetFormat[] = []
    targets.append(GPU.ColorTargetFormat(
        format:format,
        blend:GPU.BlendState(
            source_color:GPU.BlendFactor.one,
            destination_color:GPU.BlendFactor.one_minus_source_alpha,
            source_alpha:GPU.BlendFactor.one,
            destination_alpha:GPU.BlendFactor.one_minus_source_alpha,
            enabled:true
        )
    ))
    return targets
}

package func upload_buffer(
    device:@GPU.Device,
    bytes:str,
    byte_count:int,
    usage:GPU.BufferUsage,
    name:str
) GPU.Buffer {
    var upload = device.upload_buffer(byte_count, name + " upload")
    upload.write_packed(bytes, byte_count)
    var destination = device.buffer(GPU.BufferSettings(
        size:byte_count,
        usage:usage,
        name:name
    ))
    copy_buffer(device, upload, destination, byte_count)
    return destination
}

local func copy_buffer(
    device:@GPU.Device,
    upload:@GPU.TransferBuffer,
    destination:@GPU.Buffer,
    count:int,
    cycle:bool = true
) {
    var commands = device.commands()
    var transfer = commands.copy()
    transfer.upload(upload, destination, count, cycle:cycle)
    transfer.finish()
    commands.submit()
}

local func copy_buffer_on(
    commands:&GPU.CommandBuffer,
    upload:@GPU.TransferBuffer,
    destination:@GPU.Buffer,
    count:int,
    cycle:bool = true
) {
    var transfer = commands.copy()
    transfer.upload(upload, destination, count, cycle:cycle)
    transfer.finish()
}

local func upload_texture(
    device:@GPU.Device,
    image:@Image,
    name:str = "GFX.Scene2D drawing text"
) GPU.Texture {
    var texture = device.texture(GPU.TextureSettings(
        format:GPU.TextureFormat.rgba8_unorm,
        width:image.width(),
        height:image.height(),
        usage:GPU.TextureUsage.for_sampling(),
        name:name
    ))
    let pixel_count = image.byte_count()
    var upload = device.upload_buffer(pixel_count, name + " upload")
    upload.write_packed(image.packed_pixels(), pixel_count)
    var commands = device.commands()
    var transfer = commands.copy()
    transfer.upload(
        upload,
        GPU.TextureRegion(texture:texture, width:image.width(), height:image.height()),
        image.width(),
        image.height()
    )
    transfer.finish()
    commands.submit()
    return texture
}

local func normalized_region(image:@Image, selected:Image.Region?) Math.Vec4 {
    if let region = selected {
        if region.x + region.width > image.width() ||
            region.y + region.height > image.height()
        {
            panic("GFX.Scene2D sprite region exceeds its image dimensions")
        }
        return Math.Vec4(
            region.x as float / image.width() as float,
            region.y as float / image.height() as float,
            region.width as float / image.width() as float,
            region.height as float / image.height() as float
        )
    }
    return Math.Vec4(0.0, 0.0, 1.0, 1.0)
}

local func scene_draw_before(left:@SceneDraw, right:@SceneDraw) bool {
    if left.viewport != right.viewport { return !left.viewport }
    if left.layer != right.layer { return left.layer < right.layer }
    if left.depth != right.depth { return left.depth < right.depth }
    if left.order != right.order { return left.order < right.order }
    if left.kind != right.kind { return left.kind < right.kind }
    return left.cache < right.cache
}

local func composed_affine(authored:AffineModel, glyph:@VectorGlyph) AffineModel {
    return AffineModel(
        x:Math.Vec2(
            authored.x.x * glyph.x.x + authored.y.x * glyph.x.y,
            authored.x.y * glyph.x.x + authored.y.y * glyph.x.y
        ),
        y:Math.Vec2(
            authored.x.x * glyph.y.x + authored.y.x * glyph.y.y,
            authored.x.y * glyph.y.x + authored.y.y * glyph.y.y
        ),
        translation:Math.Vec2(
            authored.translation.x + authored.x.x * glyph.translation.x +
                authored.y.x * glyph.translation.y,
            authored.translation.y + authored.x.y * glyph.translation.x +
                authored.y.y * glyph.translation.y
        )
    )
}

local func translated_affine(authored:AffineModel, position:Math.Vec2) AffineModel {
    return AffineModel(
        x:authored.x,
        y:authored.y,
        translation:Math.Vec2(
            authored.translation.x + authored.x.x * position.x + authored.y.x * position.y,
            authored.translation.y + authored.x.y * position.x + authored.y.y * position.y
        )
    )
}

local func coverage_clip(
    canvas:@SceneCanvas,
    layer:@TextLayer,
    layer_position:Math.Vec2
) Math.Vec4 {
    var left = -1_000_000.0
    var top = -1_000_000.0
    var right = 1_000_000.0
    var bottom = 1_000_000.0
    if canvas.is_framed() {
        left = 0.0
        top = 0.0
        right = canvas.width() as float
        bottom = canvas.height() as float
    }
    if let bounds = layer.clip() {
        left = Math.max(left, bounds.position.x)
        top = Math.max(top, bounds.position.y)
        right = Math.min(right, bounds.position.x + bounds.size.x)
        bottom = Math.min(bottom, bounds.position.y + bounds.size.y)
    }
    return Math.Vec4(
        left - layer_position.x,
        top - layer_position.y,
        right - layer_position.x,
        bottom - layer_position.y
    )
}

local func multiplied_color(first:Color, second:Color) Color {
    return Color(
        r:first.r * second.r,
        g:first.g * second.g,
        b:first.b * second.b,
        a:first.a * second.a
    )
}

local func same_color(first:Color, second:Color) bool {
    return first.r == second.r && first.g == second.g &&
        first.b == second.b && first.a == second.a
}

local func coverage_draws_are_contiguous(
    first:@CoverageGlyphDraw,
    second:@CoverageGlyphDraw
) bool {
    return first.block_cache < 0 && second.block_cache < 0 &&
        first.page == second.page && first.layer == second.layer &&
        first.depth == second.depth && first.viewport == second.viewport &&
        first.model.x == second.model.x && first.model.y == second.model.y &&
        first.model.translation == second.model.translation &&
        first.clip == second.clip &&
        first.first_instance + first.instance_count == second.first_instance
}

local func world_image_model(transform:@Transform) Math.Mat4 {
    return Math.Mat4.transform(
        Math.Vec3(transform.position.x, transform.position.y, 0.0),
        Math.Quat.angle_axis(transform.rotation, Math.Vec3.back()).to_mat3(),
        Math.Vec3(transform.scale.x, -transform.scale.y, 1.0)
    )
}

struct LocalBounds {
    let minimum:Math.Vec2
    let maximum:Math.Vec2
}

local func viewport_bounds_in_local_space(
    view_projection:Math.Mat4,
    transform:@Transform
) LocalBounds {
    let inverse_view_projection = view_projection.inverted()
    let inverse_model = transform.view_matrix()
    let first = local_from_clip(inverse_view_projection, inverse_model, -1.0, -1.0)
    var minimum = first
    var maximum = first
    let second = local_from_clip(inverse_view_projection, inverse_model, 1.0, -1.0)
    minimum = Math.Vec2(Math.min(minimum.x, second.x), Math.min(minimum.y, second.y))
    maximum = Math.Vec2(Math.max(maximum.x, second.x), Math.max(maximum.y, second.y))
    let third = local_from_clip(inverse_view_projection, inverse_model, 1.0, 1.0)
    minimum = Math.Vec2(Math.min(minimum.x, third.x), Math.min(minimum.y, third.y))
    maximum = Math.Vec2(Math.max(maximum.x, third.x), Math.max(maximum.y, third.y))
    let fourth = local_from_clip(inverse_view_projection, inverse_model, -1.0, 1.0)
    minimum = Math.Vec2(Math.min(minimum.x, fourth.x), Math.min(minimum.y, fourth.y))
    maximum = Math.Vec2(Math.max(maximum.x, fourth.x), Math.max(maximum.y, fourth.y))
    return LocalBounds(minimum:minimum, maximum:maximum)
}

local func local_from_clip(
    inverse_view_projection:Math.Mat4,
    inverse_model:Math.Mat4,
    x:float,
    y:float
) Math.Vec2 {
    let homogeneous = inverse_view_projection.multiply(Math.Vec4(x, y, 0.0, 1.0))
    var world = homogeneous
    if homogeneous.w != 0.0 { world = homogeneous.divide(homogeneous.w) }
    let point = inverse_model.multiply(world)
    return Math.Vec2(point.x, point.y)
}

local func affine_matrix(
    model:AffineModel,
    depth:float,
    local_origin:Math.Vec2 = Math.Vec2()
) Math.Mat4 {
    return Math.Mat4(
        Math.Vec4(model.x.x, model.x.y, 0.0, 0.0),
        Math.Vec4(model.y.x, model.y.y, 0.0, 0.0),
        Math.Vec4(0.0, 0.0, 1.0, 0.0),
        Math.Vec4(
            model.translation.x + model.x.x * local_origin.x +
                model.y.x * local_origin.y,
            model.translation.y + model.x.y * local_origin.x +
                model.y.y * local_origin.y,
            depth,
            1.0
        )
    )
}

local func effect_density(model:AffineModel, display_scale:float) float {
    let x = Math.sqrt(model.x.length_squared())
    let y = Math.sqrt(model.y.length_squared())
    return Math.max(0.25, Math.max(x, y) * display_scale)
}

local func sprite_draw_before(left:@SpriteDraw, right:@SpriteDraw) bool {
    if left.layer != right.layer { return left.layer < right.layer }
    if left.depth != right.depth { return left.depth < right.depth }
    return left.order < right.order
}

local func sprite_draws_are_compatible(left:@SpriteDraw, right:@SpriteDraw) bool {
    return left.cache == right.cache &&
        left.sampling == right.sampling &&
        left.viewport == right.viewport
}

local func scene_draw_before_sprite(left:@SceneDraw, right:@SpriteDraw) bool {
    if left.layer != right.layer { return left.layer < right.layer }
    if left.depth != right.depth { return left.depth < right.depth }
    return left.order < right.order
}

local func scene_entry_before(left:@SceneEntry, right:@SceneEntry) bool {
    if left.layer != right.layer { return left.layer < right.layer }
    if left.depth != right.depth { return left.depth < right.depth }
    return left.order < right.order
}

local func sort_scene_entries(entries:&SceneEntry[], start:int, end:int) {
    var ordered = start + 1
    while ordered < end &&
        !scene_entry_before(entries[ordered], entries[ordered - 1])
    {
        ordered++
    }
    if ordered == end { return }
    var index = ordered
    while index < end {
        let selected = entries[index]
        var cursor = index
        while cursor > start &&
            scene_entry_before(selected, entries[cursor - 1])
        {
            entries[cursor] = entries[cursor - 1]
            cursor--
        }
        entries[cursor] = selected
        index++
    }
}

local func sort_scene_draws(
    draws:&SceneDraw[],
    scratch:&SceneDraw[],
    counts:&int[],
    positions:&int[]
) bool {
    if draws.count() < 2 { return false }
    var ordered = 1
    while ordered < draws.count() &&
        !scene_draw_before(draws[ordered], draws[ordered - 1])
    {
        ordered++
    }
    if ordered == draws.count() { return false }

    var minimum_layer = draws[0].layer
    var maximum_layer = draws[0].layer
    for draw in draws {
        if draw.layer < minimum_layer { minimum_layer = draw.layer }
        if draw.layer > maximum_layer { maximum_layer = draw.layer }
    }
    let maximum_linear_range = draws.count() * 4 + 256
    if maximum_layer - minimum_layer <= maximum_linear_range {
        let layer_range = maximum_layer - minimum_layer + 1
        let bucket_count = layer_range * 2
        scratch.clear()
        counts.clear()
        positions.clear()
        while counts.count() < bucket_count { counts.append(0) }
        for draw in draws {
            scratch.append(draw)
            var bucket = draw.layer - minimum_layer
            if draw.viewport { bucket += layer_range }
            counts[bucket]++
        }
        var running = 0
        var bucket = 0
        while bucket < bucket_count {
            positions.append(running)
            running += counts[bucket]
            bucket++
        }
        for draw in scratch {
            bucket = draw.layer - minimum_layer
            if draw.viewport { bucket += layer_range }
            let destination = positions[bucket]
            draws[destination] = draw
            positions[bucket]++
        }
        ordered = 1
        while ordered < draws.count() &&
            !scene_draw_before(draws[ordered], draws[ordered - 1])
        {
            ordered++
        }
        if ordered == draws.count() { return true }
    }
    quick_sort_scene_draws(draws, 0, draws.count() - 1)
    return true
}

local func quick_sort_scene_draws(
    draws:&SceneDraw[],
    first:int,
    last:int
) {
    var low = first
    var high = last
    while low < high {
        let pivot = draws[low + (high - low) / 2]
        var left = low
        var right = high
        while left <= right {
            while scene_draw_before(draws[left], pivot) { left++ }
            while scene_draw_before(pivot, draws[right]) { right-- }
            if left <= right {
                draws.swap(left, right)
                left++
                right--
            }
        }
        // Recurse into the smaller partition and continue with the larger
        // one so stack usage remains logarithmic even for ordered scenes.
        if right - low < high - left {
            if low < right { quick_sort_scene_draws(draws, low, right) }
            low = left
        } else {
            if left < high { quick_sort_scene_draws(draws, left, high) }
            high = right
        }
    }
}

local func sort_sprite_draws(draws:&SpriteDraw[]) {
    var ordered = 1
    while ordered < draws.count() &&
        !sprite_draw_before(draws[ordered], draws[ordered - 1])
    {
        ordered++
    }
    if ordered == draws.count() { return }
    var index = 1
    while index < draws.count() {
        var cursor = index
        while cursor > 0 && sprite_draw_before(draws[cursor], draws[cursor - 1]) {
            draws.swap(cursor, cursor - 1)
            cursor--
        }
        index++
    }
}

local func drawing_entry(index:int, draw:SceneDraw) SceneEntry {
    return SceneEntry(
        kind:0,
        index:index,
        layer:draw.layer,
        depth:draw.depth,
        order:draw.order
    )
}

local func scene_entry(kind:int, index:int, draw:SpriteDraw) SceneEntry {
    return SceneEntry(
        kind:kind,
        index:index,
        layer:draw.layer,
        depth:draw.depth,
        order:draw.order
    )
}

local func coverage_entry(index:int, draw:CoverageGlyphDraw) SceneEntry {
    return SceneEntry(
        kind:2,
        index:index,
        layer:draw.layer,
        depth:draw.depth,
        order:draw.order
    )
}

local func tile_map_entry(index:int, draw:TileMapDraw) SceneEntry {
    return SceneEntry(
        kind:3,
        index:index,
        layer:draw.layer,
        depth:draw.depth,
        order:draw.order
    )
}

local func surface_entry(index:int, draw:SurfaceDraw) SceneEntry {
    return SceneEntry(
        kind:4,
        index:index,
        layer:draw.layer,
        depth:draw.depth,
        order:draw.order
    )
}
