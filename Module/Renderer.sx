struct GroupedCoverageInstances {
    let instances:CoverageGlyphInstance[]
    let ranges:CoverageBlockRange[]
}

// Atlas allocation order must never leak into the draw-call count. Glyphs are
// translucent quads carrying the same layer color, so they can be stably
// grouped by atlas page without changing their visual result. A retained block
// then emits at most one draw per page instead of one draw per page transition
// in its source text.
func grouped_coverage_instances(
    values:@CoverageGlyphInstance[],
    pages:@int[],
    page_count:int
) GroupedCoverageInstances {
    assert(values.count() == pages.count())
    var grouped:CoverageGlyphInstance[] = []
    var ranges:CoverageBlockRange[] = []
    var page = 0
    while page < page_count {
        let first = grouped.count()
        var index = 0
        while index < values.count() {
            if pages[index] == page { grouped.append(values[index]) }
            index++
        }
        let count = grouped.count() - first
        if count > 0 {
            ranges.append(CoverageBlockRange(
                page:page,
                first_instance:first,
                instance_count:count
            ))
        }
        page++
    }
    return GroupedCoverageInstances(instances:grouped, ranges:ranges)
}

struct SceneEntry {
    let kind:int
    let index:int
    let layer:int
