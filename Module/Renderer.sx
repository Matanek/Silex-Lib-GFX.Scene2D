use GFX.Assets.Image
use GFX.Color
use GFX.Canvas.TextLayer
use GFX.ECS
use GFX.GPU
use GFX.Scene2D.Camera
use GFX.Scene2D.Canvas as SceneCanvas
use GFX.Scene2D.Canvas.AffineModel
use GFX.Scene2D.Canvas.TextMode
use GFX.Scene2D.Grid
use GFX.Scene2D.Packing
use GFX.Scene2D.Sprite
use GFX.Scene2D.Transform
use GFX.Scene2D.VectorText
use GFX.Window
use Interop.C
use STD.Collections.Dictionary
use STD.Collections.Hashing
use STD.Math

class CachedSceneDrawing {
    var snapshot_id:int
    var geometry_revision:int
    var geometry_hash:uint
    var packed_vertices:str
    var vertices:GPU.Buffer? = null
    var upload:GPU.TransferBuffer? = null
    var vertex_count:int
    var vertex_capacity:int
    var dirty:bool
    let mutable:bool

    init(
        snapshot_id:int,
        geometry_revision:int,
        geometry_hash:uint,
        packed_vertices:str,
        vertex_count:int,
        mutable:bool = false
    ) {
        self.snapshot_id = snapshot_id
        self.geometry_revision = geometry_revision
        self.geometry_hash = geometry_hash
        self.packed_vertices = packed_vertices
        self.vertex_count = vertex_count
        self.vertex_capacity = 0
        self.dirty = true
        self.mutable = mutable
    }

    func bytes() str { return self.packed_vertices }

    func retain_snapshot(snapshot_id:int) { self.snapshot_id = snapshot_id }

    func replace(
        snapshot_id:int,
        geometry_revision:int,
        geometry_hash:uint,
        packed_vertices:str,
        vertex_count:int
    ) {
        self.snapshot_id = snapshot_id
        self.geometry_revision = geometry_revision
        self.geometry_hash = geometry_hash
        self.packed_vertices = packed_vertices
        self.vertex_count = vertex_count
        self.dirty = true
    }
}

class CachedImage {
    let kind:int
    let index:int
    let generation:int
    var revision:int
    var texture:GPU.Texture? = null
    var texture_width:int
    var texture_height:int
    var upload:GPU.TransferBuffer? = null
    var upload_capacity:int
    var upload_width:int
    var upload_height:int
    var text_origin:Math.Vec2
    var text_size:Math.Vec2

    init(kind:int, index:int, generation:int) {
        self.kind = kind
        self.index = index
        self.generation = generation
        self.revision = 0
        self.texture_width = 0
        self.texture_height = 0
        self.upload_capacity = 0
        self.upload_width = 0
        self.upload_height = 0
        self.text_origin = Math.Vec2()
        self.text_size = Math.Vec2()
    }

    func region(width:int, height:int) Math.Vec4 {
        return Math.Vec4(
            0.0,
            0.0,
            width as float / self.texture_width as float,
            height as float / self.texture_height as float
        )
    }
}

class GlyphMeshSlot {
    var key:str
    var drawing:CachedSceneDrawing? = null

    init() { self.key = "" }
}

struct VectorGlyph {
    let key:str
    let cache:int
    let x:Math.Vec2
    let y:Math.Vec2
    let translation:Math.Vec2
}

class CachedVectorLayer {
    let identity:int
    let shaping_revision:int
    let detail:int
    let glyphs:VectorGlyph[]

    init(identity:int, shaping_revision:int, detail:int, glyphs:VectorGlyph[]) {
        self.identity = identity
        self.shaping_revision = shaping_revision
        self.detail = detail
        self.glyphs = glyphs
    }
}

class VectorLayerSlot {
    var key:int
    var layer:CachedVectorLayer? = null

    init() { self.key = -1 }
}

func image_cache_key(kind:int, index:int, generation:int) int {
    if kind < 0 || index < 0 || generation < 0 {
        panic("GFX.Scene2D image cache keys must not be negative")
    }
    let sum = index + generation
    return (sum * (sum + 1) / 2 + generation) * 2 + kind
}

struct SceneDraw {
    let kind:int
    let cache:int
    let instance:int
    let layer:int
    let depth:float
    let order:int
    let viewport:bool
}

struct SpriteDraw {
    let cache:int
    let model:Math.Mat4
    let size:Math.Vec2
    let pivot:Math.Vec2
    let color:Color
    let region:Math.Vec4
    let sampling:int
    let layer:int
    let depth:float
    let order:int
    let viewport:bool
}

struct SceneEntry {
    let kind:int
    let index:int
    let layer:int
    let depth:float
    let order:int
}

package class Renderer {
    private var drawing_pipeline:GPU.GraphicsPipeline? = null
    private var sprite_pipeline:GPU.GraphicsPipeline? = null
    private var grid_pipeline:GPU.GraphicsPipeline? = null
    private var sampler:GPU.Sampler? = null
    private var pixelated_sampler:GPU.Sampler? = null
    private var quad_vertices:GPU.Buffer? = null
    private var quad_indices:GPU.Buffer? = null
    private var scene_drawing_cache:CachedSceneDrawing[]
    private var scene_drawing_snapshots:Dictionary<int, int>
    private var scene_drawing_snapshot_generations:Dictionary<int, int>
    private var mutable_scene_drawings:Dictionary<int, int>
    private var last_scene_snapshot_id:int
    private var last_scene_cache_index:int
    private var last_synchronized_scene_snapshot_id:int
    private var last_synchronized_scene_cache_index:int
    private var last_synchronized_scene_generation:int
    private var previous_synchronized_scene_snapshot_id:int
    private var previous_synchronized_scene_cache_index:int
    private var previous_synchronized_scene_generation:int
    private var prepare_generation:int
    private var geometry_refreshes:int
    private var canvas_synchronizations:int
    private var image_cache:CachedImage[]
    private var image_cache_indices:Dictionary<int, int>
    private var pending_image_uploads:int[]
    private var glyph_mesh_cache:GlyphMeshSlot[]
    private var glyph_mesh_cache_indices:Dictionary<str, int>
    private var vector_layer_cache:VectorLayerSlot[]
    private var outline_cache_hits:int
    private var glyph_tessellations:int
    private var vector_instances:int
    private var coverage_rasters:int
    private var text_pixels_uploaded:int
    private var scene_draws:SceneDraw[]
    private var scene_draw_scratch:SceneDraw[]
    private var scene_layer_counts:int[]
    private var scene_layer_positions:int[]
    private var sprite_draws:SpriteDraw[]
    private var scene_entries:SceneEntry[]
    private var drawing_instances:GPU.Buffer? = null
    private var drawing_instance_upload:GPU.TransferBuffer? = null
    private var drawing_instance_capacity:int
    private var drawing_instance_packed:str
    private var drawing_instance_scratch:str
    private var drawing_instance_storage_capacity:int
    private var drawing_instance_write_address:uint
    private var projection:Math.Mat4
    private var scene_view_projection:Math.Mat4
    private var viewport:Math.Vec2
    private var display_scale:float
    private var selected_camera:bool
    private var selected_camera_order:int
    private var camera_ready:bool
    private var grid:Grid? = null

    init() {
        self.scene_drawing_cache = []
        self.scene_drawing_snapshots = Dictionary<int, int>(minimum_capacity:256)
        self.scene_drawing_snapshot_generations = Dictionary<int, int>(minimum_capacity:256)
        self.mutable_scene_drawings = Dictionary<int, int>(minimum_capacity:64)
        self.last_scene_snapshot_id = -1
        self.last_scene_cache_index = -1
        self.last_synchronized_scene_snapshot_id = -1
        self.last_synchronized_scene_cache_index = -1
        self.last_synchronized_scene_generation = -1
        self.previous_synchronized_scene_snapshot_id = -1
        self.previous_synchronized_scene_cache_index = -1
        self.previous_synchronized_scene_generation = -1
        self.prepare_generation = 0
        self.geometry_refreshes = 0
        self.canvas_synchronizations = 0
        self.image_cache = []
        self.image_cache_indices = Dictionary<int, int>(minimum_capacity:256)
        self.pending_image_uploads = []
        self.glyph_mesh_cache = []
        self.glyph_mesh_cache_indices = Dictionary<str, int>(minimum_capacity:1024)
        self.vector_layer_cache = []
        self.outline_cache_hits = 0
        self.glyph_tessellations = 0
        self.vector_instances = 0
        self.coverage_rasters = 0
        self.text_pixels_uploaded = 0
        self.scene_draws = []
        self.scene_draw_scratch = []
        self.scene_layer_counts = []
        self.scene_layer_positions = []
        self.sprite_draws = []
        self.scene_entries = []
        self.drawing_instance_capacity = 0
        self.drawing_instance_packed = "\0"
        self.drawing_instance_scratch = "\0"
        self.drawing_instance_storage_capacity = 1
        self.drawing_instance_write_address = 0
        self.projection = Math.Mat4.identity()
        self.scene_view_projection = Math.Mat4.identity()
        self.viewport = Math.Vec2(1.0)
        self.display_scale = 1.0
        self.selected_camera = false
        self.selected_camera_order = 0
        self.camera_ready = false
    }

    func start(
        device:@GPU.Device,
        surface:@GPU.Surface,
        samples:GPU.Samples
    ) {
        let target = color_target(surface.format())

        var drawing_buffers:GPU.VertexBufferLayout[] = []
        drawing_buffers.append(GPU.VertexBufferLayout(slot:0, pitch:36))
        drawing_buffers.append(GPU.VertexBufferLayout(
            slot:1,
            pitch:48,
            rate:GPU.VertexRate.instance
        ))
        var drawing_attributes:GPU.VertexAttribute[] = []
        drawing_attributes.append(GPU.VertexAttribute(location:0, buffer_slot:0, format:GPU.VertexFormat.float_32x3, offset:0))
        drawing_attributes.append(GPU.VertexAttribute(location:1, buffer_slot:0, format:GPU.VertexFormat.float_32x3, offset:12))
        drawing_attributes.append(GPU.VertexAttribute(location:2, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:24))
        drawing_attributes.append(GPU.VertexAttribute(location:3, buffer_slot:0, format:GPU.VertexFormat.unsigned_8x4_normalized, offset:32))
        drawing_attributes.append(GPU.VertexAttribute(location:4, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:0))
        drawing_attributes.append(GPU.VertexAttribute(location:5, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:8))
        drawing_attributes.append(GPU.VertexAttribute(location:6, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:16))
        drawing_attributes.append(GPU.VertexAttribute(location:7, buffer_slot:1, format:GPU.VertexFormat.float_32, offset:24))
        drawing_attributes.append(GPU.VertexAttribute(location:8, buffer_slot:1, format:GPU.VertexFormat.float_32x4, offset:32))
        self.drawing_pipeline = device.graphics_pipeline(
            GPU.ShaderProgram.hlsl(file:"../Shaders/Drawing.hlsl"),
            GPU.GraphicsPipelineSettings(
                vertex_buffers:drawing_buffers,
                attributes:drawing_attributes,
                rasterizer:GPU.RasterizerState(cull:GPU.Cull.none),
                multisample:GPU.MultisampleState(samples:samples),
                color_targets:target,
                name:"GFX.Scene2D vector drawing"
            )
        )

        var sprite_buffers:GPU.VertexBufferLayout[] = []
        sprite_buffers.append(GPU.VertexBufferLayout(slot:0, pitch:16))
        var sprite_attributes:GPU.VertexAttribute[] = []
        sprite_attributes.append(GPU.VertexAttribute(location:0, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:0))
        sprite_attributes.append(GPU.VertexAttribute(location:1, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:8))
        self.sprite_pipeline = device.graphics_pipeline(
            GPU.ShaderProgram.hlsl(file:"../Shaders/Sprite.hlsl"),
            GPU.GraphicsPipelineSettings(
                vertex_buffers:sprite_buffers,
                attributes:sprite_attributes,
                rasterizer:GPU.RasterizerState(cull:GPU.Cull.none),
                multisample:GPU.MultisampleState(samples:samples),
                color_targets:target,
                name:"GFX.Scene2D drawing text"
            )
        )
        if self.grid != null {
            self.grid_pipeline = device.graphics_pipeline(
                GPU.ShaderProgram.hlsl(file:"../Shaders/Grid.hlsl"),
                GPU.GraphicsPipelineSettings(
                    rasterizer:GPU.RasterizerState(cull:GPU.Cull.none),
                    multisample:GPU.MultisampleState(samples:samples),
                    color_targets:target,
                    name:"GFX.Scene2D viewport grid"
                )
            )
        }
        self.sampler = device.sampler(GPU.SamplerSettings(
            min_filter:GPU.Filter.linear,
            mag_filter:GPU.Filter.linear,
            address_u:GPU.AddressMode.clamp_to_edge,
            address_v:GPU.AddressMode.clamp_to_edge,
            name:"GFX.Scene2D text sampler"
        ))
        self.pixelated_sampler = device.sampler(GPU.SamplerSettings(
            min_filter:GPU.Filter.nearest,
            mag_filter:GPU.Filter.nearest,
            address_u:GPU.AddressMode.clamp_to_edge,
            address_v:GPU.AddressMode.clamp_to_edge,
            name:"GFX.Scene2D pixelated sprite sampler"
        ))
        self.quad_vertices = upload_buffer(
            device,
            Packing.quad_vertices(),
            64,
            GPU.BufferUsage.vertex(),
            "GFX.Scene2D text quad vertices"
        )
        self.quad_indices = upload_buffer(
            device,
            Packing.quad_indices(),
            24,
            GPU.BufferUsage.index(),
            "GFX.Scene2D text quad indices"
        )
    }

    func begin_prepare(window:@Window) {
        self.prepare_generation++
        self.canvas_synchronizations = 0
        let pixels = window.pixel_size()
        self.display_scale = window.display_scale()
        if self.display_scale <= 0.0 { self.display_scale = 1.0 }
        self.viewport = Math.Vec2(
            pixels.x / self.display_scale,
            pixels.y / self.display_scale
        )
        self.projection = Math.Mat4.orthographic(
            0.0, self.viewport.x, self.viewport.y, 0.0, -1.0, 1.0
        )
        var default_camera = Camera()
        self.scene_view_projection = default_camera.projection(self.viewport)
        self.camera_ready = true
        self.selected_camera = false
        self.selected_camera_order = 0
        self.scene_draws.clear()
        self.sprite_draws.clear()
        self.scene_entries.clear()
        self.pending_image_uploads.clear()
        self.vector_instances = 0
        self.drawing_instance_write_address = 0
        if self.drawing_instance_storage_capacity >= 48 {
            var bytes = self.drawing_instance_packed
            let address = C.address_bits(C.mutable_string_pointer(bytes))
            self.drawing_instance_packed = bytes
            self.drawing_instance_write_address = address
        }
    }

    func consider_camera(transform:@Transform, camera:@Camera) {
        if camera.is_active() &&
            (!self.selected_camera || camera.render_order() < self.selected_camera_order)
        {
            self.scene_view_projection = camera.projection(self.viewport)
                .multiply(camera.view(transform))
            self.camera_ready = true
            self.selected_camera = true
            self.selected_camera_order = camera.render_order()
        }
    }

    func collect_canvas(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas
    ) {
        if !canvas.visible { return }
        let cache_index = self.prepared_scene_drawing_cache(
            device,
            entity.index,
            canvas
        )
        var cache = self.scene_drawing_cache[cache_index]
        let model = canvas.affine_model(transform, self.viewport)
        let draw_index = self.scene_draws.count()
        self.ensure_scene_instance_storage((draw_index + 1) * 48)
        self.scene_draws.append(SceneDraw(
            kind:0,
            cache:cache_index,
            instance:draw_index,
            layer:canvas.layer,
            depth:canvas.depth,
            order:entity.index * 2,
            viewport:canvas.uses_viewport()
        ))
        Packing.write_affine_instance(
            self.drawing_instance_write_address,
            draw_index * 48,
            model.x,
            model.y,
            model.translation,
            canvas.depth,
            canvas.color
        )
        if canvas.has_text() {
            self.collect_canvas_text(device, entity, transform, canvas)
        }
    }

    private func collect_canvas_text(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas
    ) {
        for layer in canvas.text_layers() {
            if canvas.text_mode == TextMode.coverage {
                self.collect_coverage_text(device, entity, transform, canvas, layer)
                continue
            }
            if self.collect_vector_text(device, entity, transform, canvas, layer) {
                continue
            }
            if canvas.text_mode == TextMode.vector {
                panic("GFX.Scene2D vector text requires an outline for every non-empty glyph")
            }
            self.collect_coverage_text(device, entity, transform, canvas, layer)
        }
    }

    private func collect_coverage_text(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas,
        layer:TextLayer
    ) {
        if canvas.coverage_density <= 0.0 {
            panic("GFX.Scene2D Canvas coverage_density must be positive")
        }
        let density = self.display_scale * canvas.coverage_density
        let scale_key = Math.round(density * 1000.0) as int
        let image_index = self.cache_index_for_image(1, layer.id(), scale_key)
        var image_cache = self.image_cache[image_index]
        if image_cache.texture == null || image_cache.revision != layer.revision() {
            let text = layer.text_layer(density)
            self.refresh_text_image(
                device,
                image_cache,
                image_index,
                layer.revision(),
                text.image,
                "GFX.Scene2D canvas text"
            )
            image_cache.text_origin = text.origin
            image_cache.text_size = text.size
            self.coverage_rasters++
        }
        self.sprite_draws.append(SpriteDraw(
            cache:image_index,
            model:canvas.text_model(transform, self.viewport),
            size:canvas.text_size(image_cache.text_size),
            pivot:canvas.text_pivot(image_cache.text_origin, image_cache.text_size),
            color:canvas.color,
            region:image_cache.region(image_cache.upload_width, image_cache.upload_height),
            sampling:0,
            layer:canvas.layer,
            depth:canvas.depth,
            order:entity.index * 2 + 1,
            viewport:canvas.uses_viewport()
        ))
    }

    private func collect_vector_text(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas,
        layer:TextLayer,
        retried:bool = false
    ) bool {
        let authored = canvas.affine_model(transform, self.viewport)
        let detail = self.vector_detail(layer, authored)
        var cached = self.cached_vector_layer(device, layer, detail)
        if cached == null { return false }
        if let vector_layer = cached {
            let color = multiplied_color(layer.color(), canvas.color)
            for glyph in vector_layer.glyphs {
                if !self.glyph_cache_matches(glyph.cache, glyph.key) {
                    if retried { return false }
                    var refreshed = self.prepare_vector_layer(device, layer, detail)
                    if refreshed == null { return false }
                    return self.collect_vector_text(
                        device,
                        entity,
                        transform,
                        canvas,
                        layer,
                        true
                    )
                }
                let model = composed_affine(authored, glyph)
                let draw_index = self.scene_draws.count()
                self.ensure_scene_instance_storage((draw_index + 1) * 48)
                self.scene_draws.append(SceneDraw(
                    kind:1,
                    cache:glyph.cache,
                    instance:draw_index,
                    layer:canvas.layer,
                    depth:canvas.depth,
                    order:entity.index * 2 + 1,
                    viewport:canvas.uses_viewport()
                ))
                Packing.write_affine_instance(
                    self.drawing_instance_write_address,
                    draw_index * 48,
                    model.x,
                    model.y,
                    model.translation,
                    canvas.depth,
                    color
                )
                self.vector_instances++
            }
        }
        return true
    }

    private func vector_detail(layer:TextLayer, authored:AffineModel) int {
        var size = 1.0
        var runs = layer.glyph_runs()
        if !runs.is_empty() { size = runs[0].instance().size() as float }
        let x_scale = Math.sqrt(authored.x.length_squared())
        let y_scale = Math.sqrt(authored.y.length_squared())
        let physical = Math.max(x_scale, y_scale) * size * self.display_scale
        if physical <= 32.0 { return 0 }
        if physical <= 96.0 { return 1 }
        return 2
    }

    private func cached_vector_layer(
        device:@GPU.Device,
        layer:TextLayer,
        detail:int
    ) CachedVectorLayer? {
        let key = layer.id() * 3 + detail
        for slot in self.vector_layer_cache {
            if slot.key == key {
                if let cached = slot.layer {
                    if cached.identity == layer.id() &&
                        cached.shaping_revision == layer.shaping_revision() &&
                        cached.detail == detail
                    {
                        self.outline_cache_hits++
                        return cached
                    }
                }
            }
        }
        return self.prepare_vector_layer(device, layer, detail)
    }

    private func prepare_vector_layer(
        device:@GPU.Device,
        layer:TextLayer,
        detail:int
    ) CachedVectorLayer? {
        var runs = layer.glyph_runs()
        var instance_identity = "empty"
        var embolden = false
        if !runs.is_empty() {
            var instance = runs[0].instance()
            var face = instance.face()
            instance_identity = face.identity()
            for variation in instance.variations() {
                instance_identity = instance_identity +
                    "|$(variation.tag)=$(variation.value)"
            }
            embolden = instance.synthesis().embolden
        }
        var glyphs:VectorGlyph[] = []
        match layer.vector_outlines() {
            failure(error) => { return null }
            success(placements) => {
                for placement in placements {
                    if let outline = placement.glyph.outline {
                        if outline.is_empty() { continue }
                        let key = instance_identity + "|glyph=$(placement.glyph.glyph_id)|detail=$(detail)"
                        let cache = self.glyph_mesh(device, key, outline, detail)
                        let transform = placement.glyph.transform
                        let placed = VectorGlyph(
                            key:key,
                            cache:cache,
                            x:Math.Vec2(
                                VectorText.coordinate(transform.xx),
                                -VectorText.coordinate(transform.yx)
                            ),
                            y:Math.Vec2(
                                VectorText.coordinate(transform.xy),
                                -VectorText.coordinate(transform.yy)
                            ),
                            translation:Math.Vec2(
                                placement.baseline.x + VectorText.coordinate(transform.dx),
                                placement.baseline.y - VectorText.coordinate(transform.dy)
                            )
                        )
                        glyphs.append(placed)
                        if embolden {
                            glyphs.append(VectorGlyph(
                                key:placed.key,
                                cache:placed.cache,
                                x:placed.x,
                                y:placed.y,
                                translation:placed.translation.add(Math.Vec2(1.0, 0.0))
                            ))
                        }
                    }
                }
            }
        }
        var created = CachedVectorLayer(
            layer.id(),
            layer.shaping_revision(),
            detail,
            glyphs
        )
        let key = layer.id() * 3 + detail
        var slot_index = self.vector_layer_cache.count()
        if slot_index >= 256 { slot_index = key % 256 }
        if slot_index == self.vector_layer_cache.count() {
            self.vector_layer_cache.append(VectorLayerSlot())
        }
        var slot = self.vector_layer_cache[slot_index]
        slot.key = key
        slot.layer = created
        return created
    }

    private func glyph_mesh(
        device:@GPU.Device,
        key:str,
        outline:GFX.Font.GlyphOutline,
        detail:int
    ) int {
        if self.glyph_mesh_cache_indices.contains(key) {
            let index = self.glyph_mesh_cache_indices.get(key) + 0
            var candidate = self.glyph_mesh_cache[index]
            if candidate.drawing != null {
                self.outline_cache_hits++
                return index
            }
        }
        var index = 0
        if self.glyph_mesh_cache.count() < 1024 {
            self.glyph_mesh_cache.append(GlyphMeshSlot())
            index = self.glyph_mesh_cache.count() - 1
        } else {
            index = (Hashing.hash(key) % 1024 as uint) as int
            let previous_key = self.glyph_mesh_cache[index].key
            if previous_key != "" { self.glyph_mesh_cache_indices.remove(previous_key) }
        }
        var slot = self.glyph_mesh_cache[index]
        let mesh = VectorText.tessellate(outline, VectorText.tolerance_for_class(detail))
        let packed = Packing.drawing_vertices(mesh)
        var drawing = CachedSceneDrawing(
            -1,
            1,
            Hashing.hash(packed),
            packed,
            mesh.vertex_count()
        )
        self.refresh_scene_geometry(device, drawing)
        slot.key = key
        slot.drawing = drawing
        self.glyph_mesh_cache_indices.set(key, index)
        self.glyph_tessellations++
        return index
    }

    private func glyph_cache_matches(index:int, key:str) bool {
        if index < 0 || index >= self.glyph_mesh_cache.count() { return false }
        var slot = self.glyph_mesh_cache[index]
        return slot.key == key && slot.drawing != null
    }

    func collect_sprite(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        sprite:@Sprite,
        images:@Image.Store
    ) {
        let handle = sprite.asset()
        if !sprite.is_visible() || !images.contains(handle) { return }
        let image = images.snapshot(handle)
        let cache_index = self.cache_index_for_image(
            0,
            handle.index(),
            handle.generation()
        )
        var cache = self.image_cache[cache_index]
        self.refresh_image(
            device,
            cache,
            images.revision(handle),
            image,
            "GFX.Scene2D sprite"
        )
        self.sprite_draws.append(SpriteDraw(
            cache:cache_index,
            model:world_image_model(transform),
            size:sprite.sprite_size(),
            pivot:sprite.sprite_pivot(),
            color:sprite.tint(),
            region:normalized_region(image, sprite.image_region()),
            sampling:sprite.sampling_mode(),
            layer:sprite.render_layer(),
            depth:sprite.render_depth(),
            order:entity.index * 2,
            viewport:false
        ))
    }

    func finish_prepare(device:@GPU.Device) {
        self.submit_image_uploads(device)
        let reordered = sort_scene_draws(
            self.scene_draws,
            self.scene_draw_scratch,
            self.scene_layer_counts,
            self.scene_layer_positions
        )
        if self.sprite_draws.is_empty() {
            self.scene_entries.clear()
        } else {
            self.rebuild_scene_entries()
        }
        self.prepare_scene_instances(device, reordered)
        self.prune_scene_drawing_snapshots()
    }

    func draw(pass:@GPU.RenderPass) {
        self.draw_grid(pass)
        self.draw_scene(pass)
    }

    func set_grid(value:Grid) { self.grid = value }

    private func draw_grid(pass:@GPU.RenderPass) {
        if !self.camera_ready { return }
        if let configured = self.grid {
            if let pipeline = self.grid_pipeline {
                pass.bind(pipeline)
                var uniform = Packing.grid(
                    self.scene_view_projection.inverted(),
                    configured
                )
                pass.vertex_uniform(0, uniform, 144)
                pass.draw(3)
            }
        }
    }

    private func draw_scene(pass:@GPU.RenderPass) {
        if !self.camera_ready { return }
        if self.sprite_draws.is_empty() {
            self.draw_scene_drawings(pass)
            return
        }
        var cursor = 0
        while cursor < self.scene_entries.count() {
            let entry = self.scene_entries[cursor]
            if entry.kind == 0 {
                let draw = self.scene_draws[entry.index]
                var cache = self.drawing_for(draw)
                var end = cursor + 1
                while end < self.scene_entries.count() {
                    let next = self.scene_entries[end]
                    if next.kind != 0 || next.index != entry.index + end - cursor ||
                        self.scene_draws[next.index].kind != draw.kind ||
                        self.scene_draws[next.index].cache != draw.cache ||
                        self.scene_draws[next.index].viewport != draw.viewport
                    {
                        break
                    }
                    end++
                }
                if cache.vertex_count > 0 {
                    if let pipeline = self.drawing_pipeline {
                        if let vertices = cache.vertices {
                            if let instances = self.drawing_instances {
                                var selected_projection = self.scene_view_projection
                                if draw.viewport { selected_projection = self.projection }
                                var projection = Packing.view_projection(selected_projection)
                                pass.bind(pipeline)
                                pass.vertex_uniform(0, projection, 64)
                                pass.vertex_buffer(0, vertices)
                                pass.vertex_buffer(1, instances)
                                pass.draw(
                                    cache.vertex_count,
                                    end - cursor,
                                    0,
                                    entry.index
                                )
                            }
                        }
                    }
                }
                cursor = end
            } else {
                self.draw_scene_sprite(pass, self.sprite_draws[entry.index])
                cursor++
            }
        }
    }

    private func draw_scene_drawings(pass:@GPU.RenderPass) {
        var cursor = 0
        while cursor < self.scene_draws.count() {
            let draw = self.scene_draws[cursor]
            var cache = self.drawing_for(draw)
            var end = cursor + 1
            while end < self.scene_draws.count() &&
                self.scene_draws[end].kind == draw.kind &&
                self.scene_draws[end].cache == draw.cache &&
                self.scene_draws[end].viewport == draw.viewport
            {
                end++
            }
            if cache.vertex_count > 0 {
                if let pipeline = self.drawing_pipeline {
                    if let vertices = cache.vertices {
                        if let instances = self.drawing_instances {
                            var selected_projection = self.scene_view_projection
                            if draw.viewport { selected_projection = self.projection }
                            var projection = Packing.view_projection(selected_projection)
                            pass.bind(pipeline)
                            pass.vertex_uniform(0, projection, 64)
                            pass.vertex_buffer(0, vertices)
                            pass.vertex_buffer(1, instances)
                            pass.draw(cache.vertex_count, end - cursor, 0, cursor)
                        }
                    }
                }
            }
            cursor = end
        }
    }

    private func drawing_for(draw:@SceneDraw) CachedSceneDrawing {
        if draw.kind == 0 { return self.scene_drawing_cache[draw.cache] }
        var slot = self.glyph_mesh_cache[draw.cache]
        if let drawing = slot.drawing { return drawing }
        panic("GFX.Scene2D vector glyph cache entry was evicted during a frame")
    }

    private func draw_scene_sprite(pass:@GPU.RenderPass, draw:SpriteDraw) {
        var cache = self.image_cache[draw.cache]
        if let texture = cache.texture {
            if let pipeline = self.sprite_pipeline {
                var selected_sampler = self.sampler
                if draw.sampling == 1 { selected_sampler = self.pixelated_sampler }
                if let sampler = selected_sampler {
                    if let vertices = self.quad_vertices {
                        if let indices = self.quad_indices {
                            var selected_projection = self.scene_view_projection
                            if draw.viewport { selected_projection = self.projection }
                            var uniform = Packing.scene_sprite_uniform(
                                draw.model,
                                selected_projection,
                                draw.size,
                                draw.pivot,
                                draw.color,
                                draw.depth,
                                draw.region
                            )
                            pass.bind(pipeline)
                            pass.vertex_uniform(0, uniform, 256)
                            pass.fragment_sampler(0, texture, sampler)
                            pass.vertex_buffer(0, vertices)
                            pass.index_buffer(indices)
                            pass.draw_indexed(6)
                        }
                    }
                }
            }
        }
    }

    private func known_scene_drawing_cache(snapshot_id:int) int {
        if snapshot_id == self.last_scene_snapshot_id {
            return self.last_scene_cache_index
        }
        if self.scene_drawing_snapshots.contains(snapshot_id) {
            let cache_index:int =
                self.scene_drawing_snapshots.get(snapshot_id) + 0
            self.last_scene_snapshot_id = snapshot_id
            self.last_scene_cache_index = cache_index
            return cache_index
        }
        return -1
    }

    private func prepared_scene_drawing_cache(
        device:@GPU.Device,
        entity_index:int,
        canvas:@SceneCanvas
    ) int {
        let previous_snapshot_id = canvas.prepared_revision()
        let synchronized_cache_index =
            self.recently_synchronized_scene_drawing_cache(
                previous_snapshot_id
            )
        if synchronized_cache_index >= 0 { return synchronized_cache_index }
        let previous_cache_index = self.known_scene_drawing_cache(
            previous_snapshot_id
        )
        if previous_cache_index >= 0 &&
            self.scene_drawing_snapshot_was_synchronized(previous_snapshot_id)
        {
            self.remember_synchronized_scene_drawing(
                previous_snapshot_id,
                previous_cache_index
            )
            return previous_cache_index
        }

        canvas.synchronize_retained()
        self.canvas_synchronizations++
        let snapshot_id = canvas.prepared_revision()
        var cache_index = self.known_scene_drawing_cache(snapshot_id)
        if cache_index < 0 {
            cache_index = self.resolve_scene_drawing_cache(
                device,
                entity_index,
                previous_cache_index,
                canvas
            )
        }
        self.retain_scene_drawing_snapshot(snapshot_id, cache_index)
        self.remember_synchronized_scene_drawing(snapshot_id, cache_index)
        return cache_index
    }

    private func recently_synchronized_scene_drawing_cache(
        snapshot_id:int
    ) int {
        if self.last_synchronized_scene_generation == self.prepare_generation &&
            self.last_synchronized_scene_snapshot_id == snapshot_id
        {
            return self.last_synchronized_scene_cache_index
        }
        if self.previous_synchronized_scene_generation == self.prepare_generation &&
            self.previous_synchronized_scene_snapshot_id == snapshot_id
        {
            return self.previous_synchronized_scene_cache_index
        }
        return -1
    }

    private func scene_drawing_snapshot_was_synchronized(
        snapshot_id:int
    ) bool {
        if !self.scene_drawing_snapshot_generations.contains(snapshot_id) {
            return false
        }
        let generation:int =
            self.scene_drawing_snapshot_generations.get(snapshot_id) + 0
        return generation == self.prepare_generation
    }

    private func remember_synchronized_scene_drawing(
        snapshot_id:int,
        cache_index:int
    ) {
        if snapshot_id == self.last_synchronized_scene_snapshot_id {
            self.last_synchronized_scene_cache_index = cache_index
            self.last_synchronized_scene_generation = self.prepare_generation
            return
        }
        self.previous_synchronized_scene_snapshot_id =
            self.last_synchronized_scene_snapshot_id
        self.previous_synchronized_scene_cache_index =
            self.last_synchronized_scene_cache_index
        self.previous_synchronized_scene_generation =
            self.last_synchronized_scene_generation
        self.last_synchronized_scene_snapshot_id = snapshot_id
        self.last_synchronized_scene_cache_index = cache_index
        self.last_synchronized_scene_generation = self.prepare_generation
    }

    private func resolve_scene_drawing_cache(
        device:@GPU.Device,
        entity_index:int,
        previous_cache_index:int,
        canvas:@SceneCanvas
    ) int {
        var cache_index = -1
        if canvas.is_detached() {
            cache_index = self.mutable_scene_drawing(entity_index, canvas)
        } elif previous_cache_index >= 0 &&
            self.scene_drawing_cache[previous_cache_index].mutable
        {
            cache_index = previous_cache_index
            self.refresh_mutable_scene_drawing(cache_index, canvas)
        } elif canvas.revision() > 1 {
            cache_index = self.create_mutable_scene_drawing(canvas)
        } else {
            cache_index = self.register_scene_drawing(canvas)
        }
        var cache = self.scene_drawing_cache[cache_index]
        self.refresh_scene_geometry(device, cache)
        return cache_index
    }

    private func register_scene_drawing(canvas:@SceneCanvas) int {
        let snapshot_id = canvas.prepared_revision()
        let geometry = canvas.geometry()
        let packed = Packing.drawing_vertices(geometry)
        let geometry_hash = Hashing.hash(packed)
        var index = 0
        while index < self.scene_drawing_cache.count() {
            var cache = self.scene_drawing_cache[index]
            if !cache.mutable && cache.geometry_hash == geometry_hash &&
                cache.packed_vertices == packed
            {
                return index
            }
            index++
        }
        var created = CachedSceneDrawing(
            snapshot_id,
            canvas.geometry_revision(),
            geometry_hash,
            packed,
            geometry.vertex_count()
        )
        self.scene_drawing_cache.append(created)
        return self.scene_drawing_cache.count() - 1
    }

    private func retain_scene_drawing_snapshot(snapshot_id:int, cache_index:int) {
        if !self.scene_drawing_snapshots.contains(snapshot_id) {
            self.scene_drawing_snapshots.set(snapshot_id, cache_index)
        }
        self.scene_drawing_snapshot_generations.set(
            snapshot_id,
            self.prepare_generation
        )
        self.last_scene_snapshot_id = snapshot_id
        self.last_scene_cache_index = cache_index
    }

    private func prune_scene_drawing_snapshots() {
        let snapshots = self.scene_drawing_snapshot_generations.get_keys()
        for snapshot_id in snapshots {
            let generation:int =
                self.scene_drawing_snapshot_generations.get(snapshot_id) + 0
            if generation < self.prepare_generation {
                self.scene_drawing_snapshot_generations.remove(snapshot_id)
                self.scene_drawing_snapshots.remove(snapshot_id)
                if self.last_scene_snapshot_id == snapshot_id {
                    self.last_scene_snapshot_id = -1
                    self.last_scene_cache_index = -1
                }
            }
        }
    }

    private func mutable_scene_drawing(
        entity_index:int,
        canvas:@SceneCanvas
    ) int {
        if self.mutable_scene_drawings.contains(entity_index) {
            let cache_index:int = self.mutable_scene_drawings.get(entity_index) + 0
            self.refresh_mutable_scene_drawing(cache_index, canvas)
            return cache_index
        }
        let cache_index = self.create_mutable_scene_drawing(canvas)
        self.mutable_scene_drawings.set(entity_index, cache_index)
        return cache_index
    }

    private func create_mutable_scene_drawing(canvas:@SceneCanvas) int {
        let geometry = canvas.geometry()
        let packed = Packing.drawing_vertices(geometry)
        var created = CachedSceneDrawing(
            canvas.prepared_revision(),
            canvas.geometry_revision(),
            Hashing.hash(packed),
            packed,
            geometry.vertex_count(),
            mutable:true
        )
        self.scene_drawing_cache.append(created)
        return self.scene_drawing_cache.count() - 1
    }

    private func refresh_mutable_scene_drawing(
        cache_index:int,
        canvas:@SceneCanvas
    ) {
        var cache = self.scene_drawing_cache[cache_index]
        if cache.snapshot_id == canvas.prepared_revision() { return }
        if cache.geometry_revision == canvas.geometry_revision() {
            cache.retain_snapshot(canvas.prepared_revision())
            return
        }
        let geometry = canvas.geometry()
        var packed = Packing.drawing_vertices(geometry)
        let geometry_hash = Hashing.hash(packed)
        cache.replace(
            canvas.prepared_revision(),
            canvas.geometry_revision(),
            geometry_hash,
            move packed,
            geometry.vertex_count()
        )
    }

    private func refresh_scene_geometry(
        device:@GPU.Device,
        cache:&CachedSceneDrawing
    ) {
        if !cache.dirty { return }
        if cache.vertex_count == 0 { cache.dirty = false; return }
        let byte_count = cache.vertex_count * 36
        if cache.vertices == null || cache.vertex_capacity < byte_count {
            cache.upload = device.upload_buffer(
                byte_count,
                "GFX.Scene2D retained drawing upload"
            )
            cache.vertices = device.buffer(GPU.BufferSettings(
                size:byte_count,
                usage:GPU.BufferUsage.vertex(),
                name:"GFX.Scene2D retained drawing vertices"
            ))
            cache.vertex_capacity = byte_count
        }
        if let upload = cache.upload {
            if let destination = cache.vertices {
                upload.write_packed(cache.bytes(), byte_count, cycle:true)
                copy_buffer(device, upload, destination, byte_count)
            }
        }
        self.geometry_refreshes++
        cache.dirty = false
    }

    package func drawing_cache_count() int {
        return self.scene_drawing_cache.count()
    }

    package func drawing_snapshot_count() int {
        return self.scene_drawing_snapshots.count()
    }

    package func geometry_refresh_count() int { return self.geometry_refreshes }

    package func canvas_synchronization_count() int {
        return self.canvas_synchronizations
    }

    package func image_cache_count() int { return self.image_cache.count() }

    package func vector_outline_cache_hit_count() int { return self.outline_cache_hits }
    package func vector_tessellation_count() int { return self.glyph_tessellations }
    package func vector_instance_count() int { return self.vector_instances }
    package func coverage_raster_count() int { return self.coverage_rasters }
    package func text_uploaded_pixel_count() int { return self.text_pixels_uploaded }
    package func glyph_mesh_count() int {
        var count = 0
        for slot in self.glyph_mesh_cache {
            if slot.drawing != null { count++ }
        }
        return count
    }

    private func cache_index_for_image(
        kind:int,
        index:int,
        generation:int
    ) int {
        let key = image_cache_key(kind, index, generation)
        if self.image_cache_indices.contains(key) {
            return self.image_cache_indices.get(key) + 0
        }
        var created = CachedImage(kind, index, generation)
        self.image_cache.append(created)
        let created_index = self.image_cache.count() - 1
        self.image_cache_indices.set(key, created_index)
        return created_index
    }

    private func refresh_image(
        device:@GPU.Device,
        cache:&CachedImage,
        revision:int,
        image:@Image,
        name:str
    ) {
        if cache.texture != null && cache.revision == revision { return }
        cache.texture = upload_texture(device, image, name)
        cache.revision = revision
    }

    private func refresh_text_image(
        device:@GPU.Device,
        cache:&CachedImage,
        cache_index:int,
        revision:int,
        image:@Image,
        name:str
    ) {
        if cache.texture != null && cache.revision == revision { return }
        if cache.texture == null || cache.texture_width < image.width() ||
            cache.texture_height < image.height()
        {
            var width = image.width()
            var height = image.height()
            if cache.texture_width > 0 {
                width = cache.texture_width * 2
                if width < image.width() { width = image.width() }
            }
            if cache.texture_height > 0 {
                height = cache.texture_height * 2
                if height < image.height() { height = image.height() }
            }
            cache.texture = device.texture(GPU.TextureSettings(
                format:GPU.TextureFormat.rgba8_unorm,
                width:width,
                height:height,
                usage:GPU.TextureUsage.for_sampling(),
                name:name
            ))
            cache.texture_width = width
            cache.texture_height = height
        }
        let pixel_count = image.byte_count()
        self.text_pixels_uploaded += image.width() * image.height()
        if cache.upload == null || cache.upload_capacity < pixel_count {
            cache.upload = device.upload_buffer(pixel_count, name + " upload")
            cache.upload_capacity = pixel_count
        }
        if let upload = cache.upload {
            upload.write_packed(image.packed_pixels(), pixel_count, cycle:true)
        }
        cache.upload_width = image.width()
        cache.upload_height = image.height()
        self.pending_image_uploads.append(cache_index)
        cache.revision = revision
    }

    private func submit_image_uploads(device:@GPU.Device) {
        if self.pending_image_uploads.is_empty() { return }
        var commands = device.commands()
        var transfer = commands.copy()
        for cache_index in self.pending_image_uploads {
            var cache = self.image_cache[cache_index]
            if let upload = cache.upload {
                if let texture = cache.texture {
                    transfer.upload(
                        upload,
                        GPU.TextureRegion(
                            texture:texture,
                            width:cache.upload_width,
                            height:cache.upload_height
                        ),
                        cache.upload_width,
                        cache.upload_height
                    )
                }
            }
        }
        transfer.finish()
        commands.submit()
        self.pending_image_uploads.clear()
    }

    private func ensure_scene_instance_storage(byte_count:int) {
        if self.drawing_instance_storage_capacity >= byte_count { return }
        var grown = Packing.storage(byte_count)
        let destination = C.address_bits(C.mutable_string_pointer(grown))
        if self.drawing_instance_write_address != 0 {
            Packing.copy_affine_instances(
                destination,
                self.drawing_instance_write_address,
                self.scene_draws.count()
            )
        }
        self.drawing_instance_packed = grown
        self.drawing_instance_storage_capacity = C.byte_count(grown) as int
        self.drawing_instance_write_address = destination
    }

    private func reorder_scene_instances(byte_count:int) {
        var reordered = self.drawing_instance_scratch
        if C.byte_count(reordered) < byte_count as uint {
            reordered = Packing.storage(byte_count)
        }
        let destination = C.address_bits(C.mutable_string_pointer(reordered))
        var index = 0
        while index < self.scene_draws.count() {
            Packing.copy_affine_instance(
                destination,
                index * 48,
                self.drawing_instance_write_address,
                self.scene_draws[index].instance * 48
            )
            index++
        }
        self.drawing_instance_scratch = self.drawing_instance_packed
        self.drawing_instance_packed = reordered
        self.drawing_instance_storage_capacity = C.byte_count(reordered) as int
        self.drawing_instance_write_address = destination
    }

    private func prepare_scene_instances(device:@GPU.Device, reordered:bool) {
        if self.scene_draws.count() == 0 { return }
        let byte_count = self.scene_draws.count() * 48
        if reordered { self.reorder_scene_instances(byte_count) }
        if self.drawing_instances == null || self.drawing_instance_capacity < byte_count {
            self.drawing_instance_upload = device.upload_buffer(
                byte_count,
                "GFX.Scene2D retained drawing instance upload"
            )
            self.drawing_instances = device.buffer(GPU.BufferSettings(
                size:byte_count,
                usage:GPU.BufferUsage.vertex(),
                name:"GFX.Scene2D retained drawing instances"
            ))
            self.drawing_instance_capacity = byte_count
        }
        var bytes = self.drawing_instance_packed
        self.drawing_instance_packed = bytes
        if let upload = self.drawing_instance_upload {
            if let destination = self.drawing_instances {
                upload.write_packed(bytes, byte_count, cycle:true)
                copy_buffer(device, upload, destination, byte_count)
            }
        }
    }

    private func rebuild_scene_entries() {
        self.scene_entries.clear()
        self.append_scene_entries(false)
        let viewport_start = self.scene_entries.count()
        self.append_scene_entries(true)
        sort_scene_entries(self.scene_entries, 0, viewport_start)
        sort_scene_entries(
            self.scene_entries,
            viewport_start,
            self.scene_entries.count()
        )
    }

    private func append_scene_entries(viewport:bool) {
        var index = 0
        while index < self.scene_draws.count() {
            if self.scene_draws[index].viewport == viewport {
                self.scene_entries.append(drawing_entry(
                    index,
                    self.scene_draws[index]
                ))
            }
            index++
        }
        index = 0
        while index < self.sprite_draws.count() {
            if self.sprite_draws[index].viewport == viewport {
                self.scene_entries.append(scene_entry(
                    1,
                    index,
                    self.sprite_draws[index]
                ))
            }
            index++
        }
    }

}

local func color_target(format:GPU.TextureFormat) GPU.ColorTargetFormat[] {
    var targets:GPU.ColorTargetFormat[] = []
    targets.append(GPU.ColorTargetFormat(
        format:format,
        blend:GPU.BlendState(
            source_color:GPU.BlendFactor.source_alpha,
            destination_color:GPU.BlendFactor.one_minus_source_alpha,
            source_alpha:GPU.BlendFactor.one,
            destination_alpha:GPU.BlendFactor.one_minus_source_alpha,
            enabled:true
        )
    ))
    return targets
}

local func upload_buffer(
    device:@GPU.Device,
    bytes:str,
    byte_count:int,
    usage:GPU.BufferUsage,
    name:str
) GPU.Buffer {
    var upload = device.upload_buffer(byte_count, name + " upload")
    upload.write_packed(bytes, byte_count)
    var destination = device.buffer(GPU.BufferSettings(
        size:byte_count,
        usage:usage,
        name:name
    ))
    copy_buffer(device, upload, destination, byte_count)
    return destination
}

local func copy_buffer(
    device:@GPU.Device,
    upload:@GPU.TransferBuffer,
    destination:@GPU.Buffer,
    count:int
) {
    var commands = device.commands()
    var transfer = commands.copy()
    transfer.upload(upload, destination, count)
    transfer.finish()
    commands.submit()
}

local func upload_texture(
    device:@GPU.Device,
    image:@Image,
    name:str = "GFX.Scene2D drawing text"
) GPU.Texture {
    var texture = device.texture(GPU.TextureSettings(
        format:GPU.TextureFormat.rgba8_unorm,
        width:image.width(),
        height:image.height(),
        usage:GPU.TextureUsage.for_sampling(),
        name:name
    ))
    let pixel_count = image.byte_count()
    var upload = device.upload_buffer(pixel_count, name + " upload")
    upload.write_packed(image.packed_pixels(), pixel_count)
    var commands = device.commands()
    var transfer = commands.copy()
    transfer.upload(
        upload,
        GPU.TextureRegion(texture:texture, width:image.width(), height:image.height()),
        image.width(),
        image.height()
    )
    transfer.finish()
    commands.submit()
    return texture
}

local func normalized_region(image:@Image, selected:Image.Region?) Math.Vec4 {
    if let region = selected {
        if region.x + region.width > image.width() ||
            region.y + region.height > image.height()
        {
            panic("GFX.Scene2D sprite region exceeds its image dimensions")
        }
        return Math.Vec4(
            region.x as float / image.width() as float,
            region.y as float / image.height() as float,
            region.width as float / image.width() as float,
            region.height as float / image.height() as float
        )
    }
    return Math.Vec4(0.0, 0.0, 1.0, 1.0)
}

local func scene_draw_before(left:@SceneDraw, right:@SceneDraw) bool {
    if left.viewport != right.viewport { return !left.viewport }
    if left.layer != right.layer { return left.layer < right.layer }
    if left.depth != right.depth { return left.depth < right.depth }
    if left.order != right.order { return left.order < right.order }
    if left.kind != right.kind { return left.kind < right.kind }
    return left.cache < right.cache
}

local func composed_affine(authored:AffineModel, glyph:@VectorGlyph) AffineModel {
    return AffineModel(
        x:Math.Vec2(
            authored.x.x * glyph.x.x + authored.y.x * glyph.x.y,
            authored.x.y * glyph.x.x + authored.y.y * glyph.x.y
        ),
        y:Math.Vec2(
            authored.x.x * glyph.y.x + authored.y.x * glyph.y.y,
            authored.x.y * glyph.y.x + authored.y.y * glyph.y.y
        ),
        translation:Math.Vec2(
            authored.translation.x + authored.x.x * glyph.translation.x +
                authored.y.x * glyph.translation.y,
            authored.translation.y + authored.x.y * glyph.translation.x +
                authored.y.y * glyph.translation.y
        )
    )
}

local func multiplied_color(first:Color, second:Color) Color {
    return Color(
        r:first.r * second.r,
        g:first.g * second.g,
        b:first.b * second.b,
        a:first.a * second.a
    )
}

local func world_image_model(transform:@Transform) Math.Mat4 {
    return Math.Mat4.transform(
        Math.Vec3(transform.position.x, transform.position.y, 0.0),
        Math.Quat.angle_axis(transform.rotation, Math.Vec3.back()).to_mat3(),
        Math.Vec3(transform.scale.x, -transform.scale.y, 1.0)
    )
}

local func sprite_draw_before(left:@SpriteDraw, right:@SpriteDraw) bool {
    if left.layer != right.layer { return left.layer < right.layer }
    if left.depth != right.depth { return left.depth < right.depth }
    return left.order < right.order
}

local func scene_draw_before_sprite(left:@SceneDraw, right:@SpriteDraw) bool {
    if left.layer != right.layer { return left.layer < right.layer }
    if left.depth != right.depth { return left.depth < right.depth }
    return left.order < right.order
}

local func scene_entry_before(left:@SceneEntry, right:@SceneEntry) bool {
    if left.layer != right.layer { return left.layer < right.layer }
    if left.depth != right.depth { return left.depth < right.depth }
    return left.order < right.order
}

local func sort_scene_entries(entries:&SceneEntry[], start:int, end:int) {
    var ordered = start + 1
    while ordered < end &&
        !scene_entry_before(entries[ordered], entries[ordered - 1])
    {
        ordered++
    }
    if ordered == end { return }
    var index = ordered
    while index < end {
        let selected = entries[index]
        var cursor = index
        while cursor > start &&
            scene_entry_before(selected, entries[cursor - 1])
        {
            entries[cursor] = entries[cursor - 1]
            cursor--
        }
        entries[cursor] = selected
        index++
    }
}

local func sort_scene_draws(
    draws:&SceneDraw[],
    scratch:&SceneDraw[],
    counts:&int[],
    positions:&int[]
) bool {
    if draws.count() < 2 { return false }
    var ordered = 1
    while ordered < draws.count() &&
        !scene_draw_before(draws[ordered], draws[ordered - 1])
    {
        ordered++
    }
    if ordered == draws.count() { return false }

    var minimum_layer = draws[0].layer
    var maximum_layer = draws[0].layer
    for draw in draws {
        if draw.layer < minimum_layer { minimum_layer = draw.layer }
        if draw.layer > maximum_layer { maximum_layer = draw.layer }
    }
    let maximum_linear_range = draws.count() * 4 + 256
    if maximum_layer - minimum_layer <= maximum_linear_range {
        let layer_range = maximum_layer - minimum_layer + 1
        let bucket_count = layer_range * 2
        scratch.clear()
        counts.clear()
        positions.clear()
        while counts.count() < bucket_count { counts.append(0) }
        for draw in draws {
            scratch.append(draw)
            var bucket = draw.layer - minimum_layer
            if draw.viewport { bucket += layer_range }
            counts[bucket]++
        }
        var running = 0
        var bucket = 0
        while bucket < bucket_count {
            positions.append(running)
            running += counts[bucket]
            bucket++
        }
        for draw in scratch {
            bucket = draw.layer - minimum_layer
            if draw.viewport { bucket += layer_range }
            let destination = positions[bucket]
            draws[destination] = draw
            positions[bucket]++
        }
        ordered = 1
        while ordered < draws.count() &&
            !scene_draw_before(draws[ordered], draws[ordered - 1])
        {
            ordered++
        }
        if ordered == draws.count() { return true }
    }
    quick_sort_scene_draws(draws, 0, draws.count() - 1)
    return true
}

local func quick_sort_scene_draws(
    draws:&SceneDraw[],
    first:int,
    last:int
) {
    var low = first
    var high = last
    while low < high {
        let pivot = draws[low + (high - low) / 2]
        var left = low
        var right = high
        while left <= right {
            while scene_draw_before(draws[left], pivot) { left++ }
            while scene_draw_before(pivot, draws[right]) { right-- }
            if left <= right {
                draws.swap(left, right)
                left++
                right--
            }
        }
        // Recurse into the smaller partition and continue with the larger
        // one so stack usage remains logarithmic even for ordered scenes.
        if right - low < high - left {
            if low < right { quick_sort_scene_draws(draws, low, right) }
            low = left
        } else {
            if left < high { quick_sort_scene_draws(draws, left, high) }
            high = right
        }
    }
}

local func sort_sprite_draws(draws:&SpriteDraw[]) {
    var ordered = 1
    while ordered < draws.count() &&
        !sprite_draw_before(draws[ordered], draws[ordered - 1])
    {
        ordered++
    }
    if ordered == draws.count() { return }
    var index = 1
    while index < draws.count() {
        var cursor = index
        while cursor > 0 && sprite_draw_before(draws[cursor], draws[cursor - 1]) {
            draws.swap(cursor, cursor - 1)
            cursor--
        }
        index++
    }
}

local func drawing_entry(index:int, draw:SceneDraw) SceneEntry {
    return SceneEntry(
        kind:0,
        index:index,
        layer:draw.layer,
        depth:draw.depth,
        order:draw.order
    )
}

local func scene_entry(kind:int, index:int, draw:SpriteDraw) SceneEntry {
    return SceneEntry(
        kind:kind,
        index:index,
        layer:draw.layer,
        depth:draw.depth,
        order:draw.order
    )
}
