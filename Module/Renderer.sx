class CoverageBlockCache {
    var identity:int
    var revision:int
    var density:float
    var color:Color
    var depth:float
    var instances:GPU.Buffer? = null
    var upload:GPU.TransferBuffer? = null
    var capacity:int
    var ranges:CoverageBlockRange[]

    init() {
        self.identity = 0
        self.revision = 0
        self.density = 0.0
        self.color = Color.transparent()
        self.depth = 0.0
        self.capacity = 0
        self.ranges = []
    }
}

class CoverageLayerCache {
    var identity:int
    var revision:int
    var density:float
    var color:Color
    var depth:float
    var instances:CoverageGlyphInstance[]
    var ranges:CoverageBlockRange[]

    init() {
        self.identity = 0
        self.revision = 0
        self.density = 0.0
        self.color = Color.transparent()
        self.depth = 0.0
        self.instances = []
        self.ranges = []
    }
}

func image_cache_key(kind:int, index:int, generation:int) int {
    if kind < 0 || index < 0 || generation < 0 {
        panic("GFX.Scene2D image cache keys must not be negative")
    }
    let sum = index + generation
    return (sum * (sum + 1) / 2 + generation) * 2 + kind
}

func coverage_block_identity_hash(value:@int) uint {
    let key = value as uint
    return key ^ (key >> 7) ^ (key >> 17)
}

