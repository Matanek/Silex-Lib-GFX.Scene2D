    func start(
        device:@GPU.Device,
        surface:@GPU.Surface,
        samples:GPU.Samples
    ) {
        self.start_offscreen(device, surface.format(), samples)
    }

    package func start_offscreen(
        device:@GPU.Device,
        format:GPU.TextureFormat,
        samples:GPU.Samples = GPU.Samples.one
    ) {
        let target = color_target(format)

        var drawing_buffers:GPU.VertexBufferLayout[] = []
        drawing_buffers.append(GPU.VertexBufferLayout(slot:0, pitch:36))
        drawing_buffers.append(GPU.VertexBufferLayout(
            slot:1,
            pitch:80,
            rate:GPU.VertexRate.instance
        ))
        var drawing_attributes:GPU.VertexAttribute[] = []
        drawing_attributes.append(GPU.VertexAttribute(location:0, buffer_slot:0, format:GPU.VertexFormat.float_32x3, offset:0))
        drawing_attributes.append(GPU.VertexAttribute(location:1, buffer_slot:0, format:GPU.VertexFormat.float_32x3, offset:12))
        drawing_attributes.append(GPU.VertexAttribute(location:2, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:24))
        drawing_attributes.append(GPU.VertexAttribute(location:3, buffer_slot:0, format:GPU.VertexFormat.unsigned_8x4_normalized, offset:32))
        drawing_attributes.append(GPU.VertexAttribute(location:4, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:0))
        drawing_attributes.append(GPU.VertexAttribute(location:5, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:8))
        drawing_attributes.append(GPU.VertexAttribute(location:6, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:16))
        drawing_attributes.append(GPU.VertexAttribute(location:7, buffer_slot:1, format:GPU.VertexFormat.float_32, offset:24))
        drawing_attributes.append(GPU.VertexAttribute(location:8, buffer_slot:1, format:GPU.VertexFormat.float_32x4, offset:32))
        self.drawing_pipeline = device.graphics_pipeline(
            GPU.ShaderProgram.hlsl(file:"../Shaders/Drawing.hlsl"),
            GPU.GraphicsPipelineSettings(
                vertex_buffers:drawing_buffers,
                attributes:drawing_attributes,
                rasterizer:GPU.RasterizerState(cull:GPU.Cull.none),
                multisample:GPU.MultisampleState(samples:samples),
                color_targets:target,
                name:"GFX.Scene2D vector drawing"
            )
        )
        self.image_drawing_pipeline = device.graphics_pipeline(
            GPU.ShaderProgram.hlsl(file:"../Shaders/ImageDrawing.hlsl"),
            GPU.GraphicsPipelineSettings(
                vertex_buffers:drawing_buffers,
                attributes:drawing_attributes,
                rasterizer:GPU.RasterizerState(cull:GPU.Cull.none),
                multisample:GPU.MultisampleState(samples:samples),
                color_targets:target,
                name:"GFX.Scene2D Canvas image drawing"
            )
        )

        var shadow_buffers:GPU.VertexBufferLayout[] = []
        shadow_buffers.append(GPU.VertexBufferLayout(slot:0, pitch:60))
        shadow_buffers.append(GPU.VertexBufferLayout(
            slot:1,
            pitch:80,
            rate:GPU.VertexRate.instance
        ))
        var shadow_attributes:GPU.VertexAttribute[] = []
        shadow_attributes.append(GPU.VertexAttribute(location:0, buffer_slot:0, format:GPU.VertexFormat.float_32x3, offset:0))
        shadow_attributes.append(GPU.VertexAttribute(location:1, buffer_slot:0, format:GPU.VertexFormat.float_32x3, offset:12))
        shadow_attributes.append(GPU.VertexAttribute(location:2, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:24))
        shadow_attributes.append(GPU.VertexAttribute(location:3, buffer_slot:0, format:GPU.VertexFormat.unsigned_8x4_normalized, offset:32))
        shadow_attributes.append(GPU.VertexAttribute(location:4, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:0))
        shadow_attributes.append(GPU.VertexAttribute(location:5, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:8))
        shadow_attributes.append(GPU.VertexAttribute(location:6, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:16))
        shadow_attributes.append(GPU.VertexAttribute(location:7, buffer_slot:1, format:GPU.VertexFormat.float_32, offset:24))
        shadow_attributes.append(GPU.VertexAttribute(location:8, buffer_slot:1, format:GPU.VertexFormat.float_32x4, offset:32))
        shadow_attributes.append(GPU.VertexAttribute(location:9, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:36))
        shadow_attributes.append(GPU.VertexAttribute(location:10, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:44))
        shadow_attributes.append(GPU.VertexAttribute(location:11, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:52))
        shadow_attributes.append(GPU.VertexAttribute(location:12, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:48))
        shadow_attributes.append(GPU.VertexAttribute(location:13, buffer_slot:1, format:GPU.VertexFormat.float_32, offset:56))
        shadow_attributes.append(GPU.VertexAttribute(location:14, buffer_slot:1, format:GPU.VertexFormat.float_32x4, offset:64))
        self.shadow_pipeline = device.graphics_pipeline(
            GPU.ShaderProgram.hlsl(file:"../Shaders/AnalyticShadow.hlsl"),
            GPU.GraphicsPipelineSettings(
                vertex_buffers:shadow_buffers,
                attributes:shadow_attributes,
                rasterizer:GPU.RasterizerState(cull:GPU.Cull.none),
                multisample:GPU.MultisampleState(samples:samples),
                color_targets:target,
                name:"GFX.Scene2D analytic Canvas shadow"
            )
        )

        var sprite_buffers:GPU.VertexBufferLayout[] = []
        sprite_buffers.append(GPU.VertexBufferLayout(slot:0, pitch:16))
        sprite_buffers.append(GPU.VertexBufferLayout(
            slot:1,
            pitch:80,
            rate:GPU.VertexRate.instance
        ))
        var sprite_attributes:GPU.VertexAttribute[] = []
        sprite_attributes.append(GPU.VertexAttribute(location:0, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:0))
        sprite_attributes.append(GPU.VertexAttribute(location:1, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:8))
        sprite_attributes.append(GPU.VertexAttribute(location:2, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:0))
        sprite_attributes.append(GPU.VertexAttribute(location:3, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:8))
        sprite_attributes.append(GPU.VertexAttribute(location:4, buffer_slot:1, format:GPU.VertexFormat.float_32x4, offset:16))
        sprite_attributes.append(GPU.VertexAttribute(location:5, buffer_slot:1, format:GPU.VertexFormat.float_32x4, offset:32))
        sprite_attributes.append(GPU.VertexAttribute(location:6, buffer_slot:1, format:GPU.VertexFormat.float_32x4, offset:48))
        sprite_attributes.append(GPU.VertexAttribute(location:7, buffer_slot:1, format:GPU.VertexFormat.float_32x4, offset:64))
        self.sprite_pipeline = device.graphics_pipeline(
            GPU.ShaderProgram.hlsl(file:"../Shaders/SpriteBatch.hlsl"),
            GPU.GraphicsPipelineSettings(
                vertex_buffers:sprite_buffers,
                attributes:sprite_attributes,
                rasterizer:GPU.RasterizerState(cull:GPU.Cull.none),
                multisample:GPU.MultisampleState(samples:samples),
                color_targets:target,
                name:"GFX.Scene2D sprite batch"
            )
        )
        var tile_buffers:GPU.VertexBufferLayout[] = []
        tile_buffers.append(GPU.VertexBufferLayout(slot:0, pitch:16))
        tile_buffers.append(GPU.VertexBufferLayout(
            slot:1,
            pitch:24,
            rate:GPU.VertexRate.instance
        ))
        var tile_attributes:GPU.VertexAttribute[] = []
        tile_attributes.append(GPU.VertexAttribute(location:0, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:0))
        tile_attributes.append(GPU.VertexAttribute(location:1, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:8))
        tile_attributes.append(GPU.VertexAttribute(location:2, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:0))
        tile_attributes.append(GPU.VertexAttribute(location:3, buffer_slot:1, format:GPU.VertexFormat.float_32x4, offset:8))
        self.tile_map_pipeline = device.graphics_pipeline(
            GPU.ShaderProgram.hlsl(file:"../Shaders/TileMap.hlsl"),
            GPU.GraphicsPipelineSettings(
                vertex_buffers:tile_buffers,
                attributes:tile_attributes,
                rasterizer:GPU.RasterizerState(cull:GPU.Cull.none),
                multisample:GPU.MultisampleState(samples:samples),
                color_targets:target,
                name:"GFX.Scene2D retained tile map"
            )
        )
        var surface_buffers:GPU.VertexBufferLayout[] = []
        surface_buffers.append(GPU.VertexBufferLayout(slot:0, pitch:16))
        var surface_attributes:GPU.VertexAttribute[] = []
        surface_attributes.append(GPU.VertexAttribute(location:0, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:0))
        surface_attributes.append(GPU.VertexAttribute(location:1, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:8))
        self.surface_pipeline = device.graphics_pipeline(
            GPU.ShaderProgram.hlsl(file:"../Shaders/Sprite.hlsl"),
            GPU.GraphicsPipelineSettings(
                vertex_buffers:surface_buffers,
                attributes:surface_attributes,
                rasterizer:GPU.RasterizerState(cull:GPU.Cull.none),
                multisample:GPU.MultisampleState(samples:samples),
                color_targets:premultiplied_color_target(format),
                name:"GFX.Scene2D premultiplied Canvas surface"
            )
        )
        var coverage_buffers:GPU.VertexBufferLayout[] = []
        coverage_buffers.append(GPU.VertexBufferLayout(slot:0, pitch:16))
        coverage_buffers.append(GPU.VertexBufferLayout(
            slot:1,
            pitch:64,
            rate:GPU.VertexRate.instance
        ))
        var coverage_attributes:GPU.VertexAttribute[] = []
        coverage_attributes.append(GPU.VertexAttribute(location:0, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:0))
        coverage_attributes.append(GPU.VertexAttribute(location:1, buffer_slot:0, format:GPU.VertexFormat.float_32x2, offset:8))
        coverage_attributes.append(GPU.VertexAttribute(location:2, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:0))
        coverage_attributes.append(GPU.VertexAttribute(location:3, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:8))
        coverage_attributes.append(GPU.VertexAttribute(location:4, buffer_slot:1, format:GPU.VertexFormat.float_32x2, offset:16))
        coverage_attributes.append(GPU.VertexAttribute(location:5, buffer_slot:1, format:GPU.VertexFormat.float_32, offset:24))
        coverage_attributes.append(GPU.VertexAttribute(location:6, buffer_slot:1, format:GPU.VertexFormat.float_32x4, offset:32))
        coverage_attributes.append(GPU.VertexAttribute(location:7, buffer_slot:1, format:GPU.VertexFormat.float_32x4, offset:48))
        self.coverage_glyph_pipeline = device.graphics_pipeline(
            GPU.ShaderProgram.hlsl(file:"../Shaders/CoverageGlyph.hlsl"),
            GPU.GraphicsPipelineSettings(
                vertex_buffers:coverage_buffers,
                attributes:coverage_attributes,
                rasterizer:GPU.RasterizerState(cull:GPU.Cull.none),
                multisample:GPU.MultisampleState(samples:samples),
                color_targets:target,
                name:"GFX.Scene2D coverage glyph atlas"
            )
        )
        self.coverage_upload = device.upload_buffer(
            16_777_216,
            "GFX.Scene2D coverage glyph atlas upload"
        )
        if self.grid != null {
            self.grid_pipeline = device.graphics_pipeline(
                GPU.ShaderProgram.hlsl(file:"../Shaders/Grid.hlsl"),
                GPU.GraphicsPipelineSettings(
                    rasterizer:GPU.RasterizerState(cull:GPU.Cull.none),
                    multisample:GPU.MultisampleState(samples:samples),
                    color_targets:target,
                    name:"GFX.Scene2D viewport grid"
                )
            )
        }
        self.sampler = device.sampler(GPU.SamplerSettings(
            min_filter:GPU.Filter.linear,
            mag_filter:GPU.Filter.linear,
            address_u:GPU.AddressMode.clamp_to_edge,
            address_v:GPU.AddressMode.clamp_to_edge,
            name:"GFX.Scene2D text sampler"
        ))
        self.pixelated_sampler = device.sampler(GPU.SamplerSettings(
            min_filter:GPU.Filter.nearest,
            mag_filter:GPU.Filter.nearest,
            address_u:GPU.AddressMode.clamp_to_edge,
            address_v:GPU.AddressMode.clamp_to_edge,
            name:"GFX.Scene2D pixelated sprite sampler"
        ))
        self.quad_vertices = upload_buffer(
            device,
            Packing.quad_vertices(),
            64,
            GPU.BufferUsage.vertex(),
            "GFX.Scene2D text quad vertices"
        )
        self.quad_indices = upload_buffer(
            device,
            Packing.quad_indices(),
            24,
            GPU.BufferUsage.index(),
            "GFX.Scene2D text quad indices"
        )
    }

    func begin_prepare(window:@Window) {
        let pixels = window.pixel_size()
        var display_scale = window.display_scale()
        if display_scale <= 0.0 { display_scale = 1.0 }
        self.begin_prepare(Math.Vec2(
            pixels.x / display_scale,
            pixels.y / display_scale
        ), display_scale)
    }

    package func begin_prepare(
        viewport:Math.Vec2,
        display_scale:float,
        upload_commands:GPU.CommandBuffer? = null
    ) {
        if viewport.x <= 0.0 || viewport.y <= 0.0 {
            panic("GFX.Scene2D render viewport must be positive")
        }
        if display_scale <= 0.0 {
            panic("GFX.Scene2D render density must be positive")
        }
        self.prepare_generation++
        self.upload_commands = upload_commands
        self.canvas_synchronizations = 0
        self.synchronized_authored_canvases.clear()
        self.last_synchronized_authored_id = -1
        self.display_scale = display_scale
        self.viewport = viewport
        self.projection = Math.Mat4.orthographic(
            0.0, self.viewport.x, self.viewport.y, 0.0, -1.0, 1.0
        )
        var default_camera = Camera()
        self.scene_view_projection = default_camera.projection(self.viewport)
        self.camera_ready = true
        self.selected_camera = false
        self.selected_camera_order = 0
        self.scene_draws.clear()
        self.image_mask_draws.clear()
        self.sprite_draws.clear()
        self.sprite_instance_indices.clear()
        self.tile_map_draws.clear()
        self.tile_instances.clear()
        self.surface_draws.clear()
        self.coverage_glyph_draws.clear()
        self.coverage_glyph_instances.clear()
        self.scene_entries.clear()
        self.pending_image_uploads.clear()
        self.pending_coverage_uploads.clear()
        self.coverage_upload_offset = 0
        self.vector_instances = 0
        self.drawing_instance_write_address = 0
        if self.drawing_instance_storage_capacity >= 80 {
            var bytes = self.drawing_instance_packed
            let address = C.address_bits(C.mutable_string_pointer(bytes))
            self.drawing_instance_packed = bytes
            self.drawing_instance_write_address = address
        }
    }

    func consider_camera(transform:@Transform, camera:@Camera) {
        if camera.is_active() &&
            (!self.selected_camera || camera.render_order() < self.selected_camera_order)
        {
            self.scene_view_projection = camera.projection(self.viewport)
                .multiply(camera.view(transform))
            self.camera_ready = true
            self.selected_camera = true
            self.selected_camera_order = camera.render_order()
        }
    }

    func collect_canvas(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas,
        surfaces:&CanvasSurfaceRenderer
    ) {
        if !canvas.visible { return }
        let previous_snapshot_id = canvas.prepared_revision()
        self.synchronize_scene_canvas(canvas)
        if let filter = canvas.filter {
            if let frame = canvas.filter_frame() {
                let model = canvas.affine_model(transform, self.viewport)
                let density = effect_density(model, self.display_scale)
                var content = canvas.content()
                var surface = surfaces.render_retained_on(
                    device,
                    canvas.authored_id(),
                    -canvas.prepared_revision(),
                    @content[0:content.count()],
                    frame,
                    density,
                    canvas.text_mode,
                    filter
                )
                self.append_canvas_surface(
                    canvas,
                    model,
                    surface,
                    entity.index * 2048
                )
            }
            return
        }
        if !canvas.vector_geometry_compatible() || canvas.has_text() {
            let model = canvas.affine_model(transform, self.viewport)
            var content = canvas.content()
            var order = 0
            self.collect_canvas_content(
                device,
                entity,
                transform,
                canvas,
                model,
                @content[0:content.count()],
                order,
                surfaces
            )
            return
        }
        let cache_index = self.prepared_scene_drawing_cache(
            device,
            entity.index,
            previous_snapshot_id,
            canvas
        )
        var cache = self.scene_drawing_cache[cache_index]
        let model = canvas.affine_model(transform, self.viewport)
        let draw_index = self.scene_draws.count()
        self.ensure_scene_instance_storage((draw_index + 1) * 80)
        self.scene_draws.append(SceneDraw(
            kind:0,
            cache:cache_index,
            instance:draw_index,
            layer:canvas.layer,
            depth:canvas.depth,
            order:entity.index * 2,
            viewport:canvas.uses_viewport()
        ))
        Packing.write_affine_instance(
            self.drawing_instance_write_address,
            draw_index * 80,
            model.x,
            model.y,
            model.translation,
            canvas.depth,
            canvas.color
        )
        if canvas.has_text() {
            self.collect_canvas_text(device, entity, transform, canvas)
        }
    }

    private func collect_canvas_content(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas,
        model:AffineModel,
        content:@Content[..],
        order:&int,
        surfaces:&CanvasSurfaceRenderer
    ) {
        for item in content {
            match item {
                geometry(mesh) => {
                    let cache_index = self.content_drawing_cache(
                        device,
                        entity.index,
                        order,
                        canvas,
                        mesh
                    )
                    self.append_canvas_scene_draw(
                        canvas,
                        model,
                        0,
                        cache_index,
                        entity.index * 2048 + order
                    )
                    order++
                }
                image(value) => {
                    self.collect_canvas_image(
                        device,
                        entity,
                        canvas,
                        model,
                        value,
                        order
                    )
                    order++
                }
                layer(value) => {
                    if value.effects().is_empty() {
                        let nested = value.content_view()
                        self.collect_canvas_content(
                            device,
                            entity,
                            transform,
                            canvas,
                            model,
                            nested,
                            order,
                            surfaces
                        )
                    } elif let shadow = analytic_shadow_layer(value) {
                        self.append_analytic_shadow(
                            device,
                            entity,
                            canvas,
                            model,
                            shadow,
                            order
                        )
                        order++
                    } else {
                        let density = effect_density(model, self.display_scale)
                        var surface = surfaces.render_layer(
                            device,
                            value,
                            density,
                            canvas.text_mode
                        )
                        self.append_canvas_surface(
                            canvas,
                            model,
                            surface,
                            entity.index * 2048 + order
                        )
                        order++
                    }
                }
                text(value) => {
                    self.collect_canvas_text_layer(
                        device,
                        entity,
                        transform,
                        canvas,
                        value,
                        entity.index * 2048 + order
                    )
                    order++
                }
            }
        }
    }

    private func append_canvas_surface(
        canvas:@SceneCanvas,
        model:AffineModel,
        surface:CanvasSurface,
        order:int
    ) {
        let bounds = surface.bounds()
        self.surface_draws.append(SurfaceDraw(
            surface:surface,
            model:affine_matrix(model, canvas.depth, bounds.position),
            size:bounds.size,
            color:canvas.color,
            layer:canvas.layer,
            depth:canvas.depth,
            order:order,
            viewport:canvas.uses_viewport()
        ))
    }

    package func collect_surface_content(
        device:@GPU.Device,
        content:@Content[..],
        frame:Rect,
        text_mode:TextMode,
        surfaces:&CanvasSurfaceRenderer,
        identity:int,
        revision:int
    ) {
        self.surface_content_identity = identity
        self.surface_content_revision = revision
        var canvas = self.surface_content_canvas
        canvas.text_mode = text_mode
        var transform = Transform(position:frame.position.multiply(-1.0))
        let model = canvas.affine_model(transform, self.viewport)
        var order = 0
        var entity = ECS.Entity()
        self.collect_canvas_content(
            device,
            entity,
            transform,
            canvas,
            model,
            content,
            order,
            surfaces
        )
        self.surface_content_identity = 0
        self.surface_content_revision = 0
    }

    private func append_analytic_shadow(
        device:@GPU.Device,
        entity:ECS.Entity,
        canvas:@SceneCanvas,
        model:AffineModel,
        shadow:AnalyticShadowIntent,
        order:int
    ) {
        let cache_index = self.shadow_drawing_cache(
            device,
            entity.index,
            order,
            canvas,
            shadow.geometry
        )
        let draw_index = self.scene_draws.count()
        self.ensure_scene_instance_storage((draw_index + 1) * 80)
        self.scene_draws.append(SceneDraw(
            kind:3,
            cache:cache_index,
            instance:draw_index,
            layer:canvas.layer,
            depth:canvas.depth,
            order:entity.index * 2048 + order,
            viewport:canvas.uses_viewport()
        ))
        Packing.write_shadow_instance(
            self.drawing_instance_write_address,
            draw_index * 80,
            model.x,
            model.y,
            model.translation,
            canvas.depth,
            canvas.color,
            shadow.effect.offset,
            shadow.effect.radius,
            shadow.effect.color
        )
    }

    private func collect_canvas_image(
        device:@GPU.Device,
        entity:ECS.Entity,
        canvas:@SceneCanvas,
        model:AffineModel,
        content:ImageContent,
        order:int
    ) {
        var paint = content.paint()
        let image = paint.image()
        let image_cache_index = self.cache_index_for_image(2, paint.id(), 0)
        var image_cache = self.image_cache[image_cache_index]
        self.refresh_image(
            device,
            image_cache,
            paint.revision(),
            image,
            "GFX.Scene2D Canvas ImagePaint"
        )
        let geometry = content.geometry()
        let geometry_cache = self.content_drawing_cache(
            device,
            entity.index,
            order,
            canvas,
            geometry
        )
        self.image_mask_draws.append(ImageMaskDraw(
            geometry_cache:geometry_cache,
            image_cache:image_cache_index,
            uniform:Packing.image_drawing_uniform(content)
        ))
        self.append_canvas_scene_draw(
            canvas,
            model,
            2,
            self.image_mask_draws.count() - 1,
            entity.index * 2048 + order
        )
    }

    private func append_canvas_scene_draw(
        canvas:@SceneCanvas,
        model:AffineModel,
        kind:int,
        cache:int,
        order:int
    ) {
        let draw_index = self.scene_draws.count()
        self.ensure_scene_instance_storage((draw_index + 1) * 80)
        self.scene_draws.append(SceneDraw(
            kind:kind,
            cache:cache,
            instance:draw_index,
            layer:canvas.layer,
            depth:canvas.depth,
            order:order,
            viewport:canvas.uses_viewport()
        ))
        Packing.write_affine_instance(
            self.drawing_instance_write_address,
            draw_index * 80,
            model.x,
            model.y,
            model.translation,
            canvas.depth,
            canvas.color
        )
    }

    private func collect_canvas_text(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas
    ) {
        for layer in canvas.text_layers() {
            self.collect_canvas_text_layer(
                device,
                entity,
                transform,
                canvas,
                layer,
                entity.index * 2 + 1
            )
        }
    }

    private func collect_canvas_text_layer(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas,
        layer:TextLayer,
        order:int
    ) {
            // Rectangular text clipping is resolved while preparing coverage
            // quads. This keeps the shared glyph atlas intact and avoids one
            // offscreen texture per scrolling line.
            if canvas.text_mode == TextMode.coverage || layer.clip() != null {
                self.collect_coverage_text(device, entity, transform, canvas, layer, order)
                return
            }
            if self.collect_vector_text(device, entity, transform, canvas, layer, order) {
                return
            }
            if canvas.text_mode == TextMode.vector {
                panic("GFX.Scene2D vector text requires an outline for every non-empty glyph")
            }
            self.collect_coverage_text(device, entity, transform, canvas, layer, order)
    }

    private func collect_coverage_text(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas,
        layer:TextLayer,
        order:int
    ) {
        if canvas.coverage_density <= 0.0 {
            panic("GFX.Scene2D Canvas coverage_density must be positive")
        }
        let density = self.display_scale * canvas.coverage_density
        if self.collect_atlas_coverage_text(
            device,
            entity,
            transform,
            canvas,
            layer,
            density,
            order
        ) {
            return
        }
        let scale_key = Math.round(density * 1000.0) as int
        let image_index = self.cache_index_for_image(1, layer.id(), scale_key)
        var image_cache = self.image_cache[image_index]
        if image_cache.texture == null || image_cache.revision != layer.revision() {
            let text = layer.text_layer(density)
            self.refresh_text_image(
                device,
                image_cache,
                image_index,
                layer.revision(),
                text.image,
                "GFX.Scene2D canvas text"
            )
            image_cache.text_origin = text.origin
            image_cache.text_size = text.size
            self.coverage_rasters++
        }
        self.sprite_draws.append(SpriteDraw(
            cache:image_index,
            model:canvas.text_model(transform, self.viewport),
            size:canvas.text_size(image_cache.text_size),
            pivot:canvas.text_pivot(image_cache.text_origin, image_cache.text_size),
            color:canvas.color,
            region:image_cache.region(image_cache.upload_width, image_cache.upload_height),
            sampling:0,
            layer:canvas.layer,
            depth:canvas.depth,
            order:order,
            viewport:canvas.uses_viewport()
        ))
    }

    private func collect_atlas_coverage_text(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas,
        layer:TextLayer,
        density:float,
        order:int
    ) bool {
        if layer.block_identity() > 0 {
            return self.collect_retained_coverage_block(
                device,
                entity,
                transform,
                canvas,
                layer,
                density,
                order
            )
        }
        let color = multiplied_color(layer.color(), canvas.color)
        let layer_identity = layer.id()
        var cache_index = self.coverage_layer_cache_index(layer_identity)
        if cache_index >= 0 {
            var cache = self.coverage_layer_cache[cache_index]
            if cache.identity == layer_identity && cache.revision == layer.revision() &&
                cache.density == density && cache.depth == canvas.depth &&
                same_color(cache.color, color)
            {
                self.coverage_layer_cache_hits++
                self.append_cached_coverage_layer(
                    transform,
                    canvas,
                    layer,
                    cache.instances,
                    cache.ranges,
                    order
                )
                return true
            }
        }
        self.coverage_layer_cache_misses++
        var runs = layer.coverage_runs(density)
        if runs.is_empty() { return true }
        var layer_instances:CoverageGlyphInstance[] = []
        var layer_pages:int[] = []
        for coverage_run in runs {
            var run = coverage_run.glyph_run
            var instance = run.instance()
            let identity = instance.identity()
            let instance_key = Hashing.hash(identity)
            for glyph in run.glyphs() {
                let slot = self.coverage_slot(
                    device,
                    instance,
                    identity,
                    instance_key,
                    glyph.id,
                    density
                )
                if slot < 0 {
                    return false
                }
                let retained_slot = self.coverage_glyph_slots[slot]
                if retained_slot.page < 0 { continue }
                let position = Math.Vec2(
                    coverage_run.origin.x +
                        Math.round(glyph.origin_x * density as float64) as int as float / density,
                    coverage_run.origin.y -
                        Math.round(glyph.origin_y * density as float64) as int as float / density
                ).add(retained_slot.offset)
                self.append_coverage_instance(
                    layer_instances,
                    retained_slot,
                    position,
                    color,
                    canvas.depth
                )
                layer_pages.append(retained_slot.page)
                if instance.synthesis().embolden {
                    self.append_coverage_instance(
                        layer_instances,
                        retained_slot,
                        Math.Vec2(
                            position.x + Math.max(1.0, Math.round(density)) / density,
                            position.y
                        ),
                        color,
                        canvas.depth
                    )
                    layer_pages.append(retained_slot.page)
                }
            }
        }
        let grouped = grouped_coverage_instances(
            layer_instances,
            layer_pages,
            self.coverage_atlas_pages.count()
        )
        // Panels commonly keep a line stable for hundreds of frames. Retain
        // its prepared glyph instances, but cap both entry count and payload:
        // 256 layers of at most 128 instances stay below roughly 2 MiB.
        if grouped.instances.count() <= 128 {
            if cache_index < 0 {
                cache_index = self.reusable_coverage_layer_cache()
                let previous_identity = self.coverage_layer_cache[cache_index].identity
                if previous_identity > 0 {
                    self.coverage_layer_cache_indices.remove(previous_identity)
                }
                self.coverage_layer_cache_indices.set(layer_identity, cache_index)
            }
            var cache = self.coverage_layer_cache[cache_index]
            cache.identity = layer_identity
            cache.revision = layer.revision()
            cache.density = density
            cache.color = color
            cache.depth = canvas.depth
            cache.instances = grouped.instances
            cache.ranges = grouped.ranges
            self.coverage_layer_builds++
            self.append_cached_coverage_layer(
                transform,
                canvas,
                layer,
                cache.instances,
                cache.ranges,
                order
            )
            return true
        }
        self.append_cached_coverage_layer(
            transform,
            canvas,
            layer,
            grouped.instances,
            grouped.ranges,
            order
        )
        return true
    }

    private func append_cached_coverage_layer(
        transform:@Transform,
        canvas:@SceneCanvas,
        layer:@TextLayer,
        instances:@CoverageGlyphInstance[],
        ranges:@CoverageBlockRange[],
        order:int
    ) {
        let model = canvas.affine_model(transform, self.viewport)
        let clip = coverage_clip(canvas, layer, Math.Vec2())
        let instance_base = self.coverage_glyph_instances.count()
        for prepared in instances {
            self.coverage_glyph_instances.append(prepared)
        }
        for prepared in ranges {
            self.coverage_glyph_draws.append(CoverageGlyphDraw(
                page:prepared.page,
                first_instance:instance_base + prepared.first_instance,
                instance_count:prepared.instance_count,
                layer:canvas.layer,
                depth:canvas.depth,
                order:order,
                viewport:canvas.uses_viewport(),
                model:model,
                clip:clip,
                block_cache:-1
            ))
        }
    }

    private func coverage_layer_cache_index(identity:int) int {
        if self.coverage_layer_cache_indices.contains(identity) {
            return self.coverage_layer_cache_indices.get(identity) + 0
        }
        return -1
    }

    private func reusable_coverage_layer_cache() int {
        if self.coverage_layer_cache.count() < 256 {
            self.coverage_layer_cache.append(CoverageLayerCache())
            return self.coverage_layer_cache.count() - 1
        }
        let selected = self.coverage_layer_cache_cursor
        self.coverage_layer_cache_cursor =
            (self.coverage_layer_cache_cursor + 1) % 256
        return selected
    }

    private func collect_retained_coverage_block(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas,
        layer:TextLayer,
        density:float,
        order:int
    ) bool {
        let identity = layer.block_identity()
        let revision = layer.block_revision()
        let color = multiplied_color(layer.color(), canvas.color)
        var cache_index = self.coverage_block_cache_index(identity)
        if cache_index < 0 {
            self.coverage_block_cache_misses++
            cache_index = self.reusable_coverage_block_cache()
            let previous_identity = self.coverage_block_cache[cache_index].identity
            if previous_identity > 0 {
                self.coverage_block_cache_evictions++
                self.coverage_block_cache_indices.remove(previous_identity)
            }
            self.coverage_block_cache_indices.set(identity, cache_index)
        } else {
            self.coverage_block_cache_hits++
        }
        var cache = self.coverage_block_cache[cache_index]
        let valid = cache.identity == identity && cache.revision == revision &&
            cache.density == density && cache.depth == canvas.depth &&
            same_color(cache.color, color) && cache.instances != null
        if !valid {
            var runs = layer.coverage_runs(density)
            var prepared:CoverageGlyphInstance[] = []
            var prepared_pages:int[] = []
            let layer_position = layer.position()
            for coverage_run in runs {
                var run = coverage_run.glyph_run
                var instance = run.instance()
                let instance_identity = instance.identity()
                let instance_key = Hashing.hash(instance_identity)
                for glyph in run.glyphs() {
                    let slot_index = self.coverage_slot(
                        device,
                        instance,
                        instance_identity,
                        instance_key,
                        glyph.id,
                        density
                    )
                    if slot_index < 0 { return false }
                    let slot = self.coverage_glyph_slots[slot_index]
                    if slot.page < 0 { continue }
                    let position = Math.Vec2(
                        coverage_run.origin.x - layer_position.x +
                            Math.round(glyph.origin_x * density as float64) as int as float / density,
                        coverage_run.origin.y - layer_position.y -
                            Math.round(glyph.origin_y * density as float64) as int as float / density
                    ).add(slot.offset)
                    self.append_coverage_instance(
                        prepared,
                        slot,
                        position,
                        color,
                        canvas.depth
                    )
                    prepared_pages.append(slot.page)
                    if instance.synthesis().embolden {
                        self.append_coverage_instance(
                            prepared,
                            slot,
                            Math.Vec2(
                                position.x + Math.max(1.0, Math.round(density)) / density,
                                position.y
                            ),
                            color,
                            canvas.depth
                        )
                        prepared_pages.append(slot.page)
                    }
                }
            }
            let grouped = grouped_coverage_instances(
                prepared,
                prepared_pages,
                self.coverage_atlas_pages.count()
            )
            let byte_count = grouped.instances.count() * 64
            if byte_count > 0 {
                if cache.instances == null || cache.capacity < byte_count {
                    self.coverage_block_allocations++
                    var capacity = 4096
                    while capacity < byte_count { capacity *= 2 }
                    cache.upload = device.upload_buffer(
                        capacity,
                        "GFX.Scene2D retained text block upload"
                    )
                    cache.instances = device.buffer(GPU.BufferSettings(
                        size:capacity,
                        usage:GPU.BufferUsage.vertex(),
                        name:"GFX.Scene2D retained text block"
                    ))
                    cache.capacity = capacity
                }
                var packed = pack_coverage_instances(grouped.instances)
                if let upload = cache.upload {
                    if let destination = cache.instances {
                        upload.write_packed(packed, byte_count)
                        copy_buffer(device, upload, destination, byte_count, cycle:false)
                    }
                }
            }
            cache.identity = identity
            cache.revision = revision
            cache.density = density
            cache.color = color
            cache.depth = canvas.depth
            cache.ranges = grouped.ranges
            self.coverage_block_builds++
        }
        let authored = canvas.affine_model(transform, self.viewport)
        let layer_position = layer.position()
        let model = translated_affine(authored, layer_position)
        let clip = coverage_clip(canvas, layer, layer_position)
        for draw_range in cache.ranges {
            self.coverage_glyph_draws.append(CoverageGlyphDraw(
                page:draw_range.page,
                first_instance:draw_range.first_instance,
                instance_count:draw_range.instance_count,
                layer:canvas.layer,
                depth:canvas.depth,
                order:order,
                viewport:canvas.uses_viewport(),
                model:model,
                clip:clip,
                block_cache:cache_index
            ))
        }
        return true
    }

    private func coverage_block_cache_index(identity:int) int {
        if self.coverage_block_cache_indices.contains(identity) {
            return self.coverage_block_cache_indices.get(identity) + 0
        }
        return -1
    }

    private func reusable_coverage_block_cache() int {
        if self.coverage_block_cache.count() < 128 {
            self.coverage_block_cache.append(CoverageBlockCache())
            return self.coverage_block_cache.count() - 1
        }
        // GPU text residency is a bounded ring: eviction cost must remain
        // constant after a long scroll through distinct retained blocks.
        let selected = self.coverage_block_cache_cursor
        self.coverage_block_cache_cursor =
            (self.coverage_block_cache_cursor + 1) % 128
        return selected
    }

    private func coverage_slot(
        device:@GPU.Device,
        instance:VectorFont.Instance,
        identity:@str,
        instance_key:uint,
        glyph_id:uint32,
        density:float
    ) int {
        let density_key = Math.round(density * 1000.0) as uint
        let key = (instance_key % 32_768 as uint +
            glyph_id as uint * 40_503 as uint + density_key * 97 as uint) %
            32_768 as uint
        var table_index = key as int
        var insertion = table_index
        var probe = 0
        while probe < 8 {
            let known = self.coverage_glyph_table[table_index]
            if known < 0 {
                insertion = table_index
                break
            }
            let slot = self.coverage_glyph_slots[known]
            if slot.key == key && slot.instance_identity == identity &&
                slot.glyph_id == glyph_id && slot.density == density
            {
                return known
            }
            table_index = (table_index + 1) % self.coverage_glyph_table.count()
            probe++
        }
        var raster_width = 0
        var raster_height = 0
        var raster_left = 0
        var raster_top = 0
        var raster_alpha = ""
        var retained_instance = instance
        match retained_instance.rasterize_glyph(
            glyph_id,
            VectorFont.GlyphRasterOptions(
                density:density as float64,
                hinting:VectorFont.Hinting.normal(),
                antialiasing:VectorFont.Antialiasing.grayscale()
            )
        ) {
            failure(error) => { return -1 }
            success(coverage) => {
                if let value = coverage {
                    raster_width = value.width
                    raster_height = value.height
                    raster_left = value.left
                    raster_top = value.top
                    raster_alpha = value.packed_alpha()
                } else {
                    self.coverage_glyph_slots.append(CoverageGlyphSlot(
                        key:key,
                        instance_identity:identity + "",
                        glyph_id:glyph_id,
                        density:density,
                        page:-1,
                        x:0,
                        y:0,
                        width:0,
                        height:0,
                        offset:Math.Vec2(),
                        size:Math.Vec2()
                    ))
                    let empty = self.coverage_glyph_slots.count() - 1
                    self.coverage_glyph_table[insertion] = empty
                    return empty
                }
            }
        }
        let padded_width = raster_width + 2
        let padded_height = raster_height + 2
        let byte_count = padded_width * padded_height
        if padded_width > 2048 || padded_height > 2048 ||
            self.coverage_upload_offset + byte_count > 16_777_216
        {
            return -1
        }
        var selected_page = -1
        var page_index = 0
        while page_index < self.coverage_atlas_pages.count() {
            var page = self.coverage_atlas_pages[page_index]
            if page.cursor_x + padded_width > 2047 {
                page.cursor_x = 1
                page.cursor_y += page.row_height
                page.row_height = 0
            }
            if page.cursor_y + padded_height <= 2047 {
                selected_page = page_index
                break
            }
            page_index++
        }
        if selected_page < 0 {
            if self.coverage_atlas_pages.count() >= 4 { return -1 }
            var created = CoverageAtlasPage()
            created.texture = device.texture(GPU.TextureSettings(
                format:GPU.TextureFormat.r8_unorm,
                width:2048,
                height:2048,
                usage:GPU.TextureUsage.for_sampling(),
                name:"GFX.Scene2D coverage glyph atlas"
            ))
            self.coverage_atlas_pages.append(created)
            selected_page = self.coverage_atlas_pages.count() - 1
        }
        var page = self.coverage_atlas_pages[selected_page]
        if page.cursor_x + padded_width > 2047 {
            page.cursor_x = 1
            page.cursor_y += page.row_height
            page.row_height = 0
        }
        let upload_bytes = Packing.bordered_coverage(
            raster_alpha,
            raster_width,
            raster_height
        )
        if let upload = self.coverage_upload {
            upload.write_packed(
                upload_bytes,
                byte_count,
                self.coverage_upload_offset,
                self.coverage_upload_offset == 0
            )
        } else {
            return -1
        }
        let slot = CoverageGlyphSlot(
            key:key,
            instance_identity:identity + "",
            glyph_id:glyph_id,
            density:density,
            page:selected_page,
            x:page.cursor_x + 1,
            y:page.cursor_y + 1,
            width:raster_width,
            height:raster_height,
            offset:Math.Vec2(
                raster_left as float / density,
                -raster_top as float / density
            ),
            size:Math.Vec2(
                raster_width as float / density,
                raster_height as float / density
            )
        )
        self.pending_coverage_uploads.append(PendingCoverageUpload(
            page:selected_page,
            x:page.cursor_x,
            y:page.cursor_y,
            width:padded_width,
            height:padded_height,
            offset:self.coverage_upload_offset
        ))
        self.coverage_upload_offset += byte_count
        page.cursor_x += padded_width
        page.row_height = Math.max(page.row_height as float, padded_height as float) as int
        self.coverage_glyph_slots.append(slot)
        let result = self.coverage_glyph_slots.count() - 1
        self.coverage_glyph_table[insertion] = result
        self.coverage_rasters++
        self.text_pixels_uploaded += raster_width * raster_height
        return result
    }

    private func append_coverage_instance(
        instances:&CoverageGlyphInstance[],
        slot:CoverageGlyphSlot,
        position:Math.Vec2,
        color:Color,
        depth:float
    ) {
        let size = slot.size
        let region = Math.Vec4(
            slot.x as float / 2048.0,
            slot.y as float / 2048.0,
            slot.width as float / 2048.0,
            slot.height as float / 2048.0
        )
        instances.append(CoverageGlyphInstance(
            x:Math.Vec2(size.x, 0.0),
            y:Math.Vec2(0.0, size.y),
            translation:position,
            depth:depth,
            region:region,
            color:color
        ))
    }

    private func collect_vector_text(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        canvas:@SceneCanvas,
        layer:TextLayer,
        order:int,
        retried:bool = false
    ) bool {
        let authored = canvas.affine_model(transform, self.viewport)
        let detail = self.vector_detail(layer, authored)
        var cached = self.cached_vector_layer(device, layer, detail)
        if cached == null { return false }
        if let vector_layer = cached {
            let color = multiplied_color(layer.color(), canvas.color)
            for glyph in vector_layer.glyphs {
                if !self.glyph_cache_matches(glyph.cache, glyph.key) {
                    if retried { return false }
                    var refreshed = self.prepare_vector_layer(device, layer, detail)
                    if refreshed == null { return false }
                    return self.collect_vector_text(
                        device,
                        entity,
                        transform,
                        canvas,
                        layer,
                        order,
                        true
                    )
                }
                let model = composed_affine(authored, glyph)
                let draw_index = self.scene_draws.count()
                self.ensure_scene_instance_storage((draw_index + 1) * 80)
                self.scene_draws.append(SceneDraw(
                    kind:1,
                    cache:glyph.cache,
                    instance:draw_index,
                    layer:canvas.layer,
                    depth:canvas.depth,
                    order:order,
                    viewport:canvas.uses_viewport()
                ))
                Packing.write_affine_instance(
                    self.drawing_instance_write_address,
                    draw_index * 80,
                    model.x,
                    model.y,
                    model.translation,
                    canvas.depth,
                    color
                )
                self.vector_instances++
            }
        }
        return true
    }

    private func vector_detail(layer:TextLayer, authored:AffineModel) int {
        var size = 1.0
        var runs = layer.glyph_runs()
        if !runs.is_empty() { size = runs[0].instance().size() as float }
        let x_scale = Math.sqrt(authored.x.length_squared())
        let y_scale = Math.sqrt(authored.y.length_squared())
        let physical = Math.max(x_scale, y_scale) * size * self.display_scale
        if physical <= 32.0 { return 0 }
        if physical <= 96.0 { return 1 }
        return 2
    }

    private func cached_vector_layer(
        device:@GPU.Device,
        layer:TextLayer,
        detail:int
    ) CachedVectorLayer? {
        let key = layer.id() * 3 + detail
        for slot in self.vector_layer_cache {
            if slot.key == key {
                if let cached = slot.layer {
                    if cached.identity == layer.id() &&
                        cached.shaping_revision == layer.shaping_revision() &&
                        cached.detail == detail
                    {
                        self.outline_cache_hits++
                        return cached
                    }
                }
            }
        }
        return self.prepare_vector_layer(device, layer, detail)
    }

    private func prepare_vector_layer(
        device:@GPU.Device,
        layer:TextLayer,
        detail:int
    ) CachedVectorLayer? {
        var runs = layer.glyph_runs()
        var instance_identity = "empty"
        var embolden = false
        if !runs.is_empty() {
            var instance = runs[0].instance()
            var face = instance.face()
            instance_identity = face.identity()
            for variation in instance.variations() {
                instance_identity = instance_identity +
                    "|$(variation.tag)=$(variation.value)"
            }
            embolden = instance.synthesis().embolden
        }
        var glyphs:VectorGlyph[] = []
        match layer.vector_outlines() {
            failure(error) => { return null }
            success(placements) => {
                for placement in placements {
                    if let outline = placement.glyph.outline {
                        if outline.is_empty() { continue }
                        let key = instance_identity + "|glyph=$(placement.glyph.glyph_id)|detail=$(detail)"
                        let cache = self.glyph_mesh(device, key, outline, detail)
                        let transform = placement.glyph.transform
                        let placed = VectorGlyph(
                            key:key,
                            cache:cache,
                            x:Math.Vec2(
                                VectorText.coordinate(transform.xx),
                                -VectorText.coordinate(transform.yx)
                            ),
                            y:Math.Vec2(
                                VectorText.coordinate(transform.xy),
                                -VectorText.coordinate(transform.yy)
                            ),
                            translation:Math.Vec2(
                                placement.baseline.x + VectorText.coordinate(transform.dx),
                                placement.baseline.y - VectorText.coordinate(transform.dy)
                            )
                        )
                        glyphs.append(placed)
                        if embolden {
                            glyphs.append(VectorGlyph(
                                key:placed.key,
                                cache:placed.cache,
                                x:placed.x,
                                y:placed.y,
                                translation:placed.translation.add(Math.Vec2(1.0, 0.0))
                            ))
                        }
                    }
                }
            }
        }
        var created = CachedVectorLayer(
            layer.id(),
            layer.shaping_revision(),
            detail,
            glyphs
        )
        let key = layer.id() * 3 + detail
        var slot_index = -1
        var existing = 0
        while existing < self.vector_layer_cache.count() {
            if self.vector_layer_cache[existing].key == key {
                slot_index = existing
                break
            }
            existing++
        }
        if slot_index < 0 { slot_index = self.vector_layer_cache.count() }
        if slot_index >= 256 { slot_index = key % 256 }
        if slot_index == self.vector_layer_cache.count() {
            self.vector_layer_cache.append(VectorLayerSlot())
        }
        var slot = self.vector_layer_cache[slot_index]
        slot.key = key
        slot.layer = created
        return created
    }

    private func glyph_mesh(
        device:@GPU.Device,
        key:str,
        outline:GFX.Font.GlyphOutline,
        detail:int
    ) int {
        if self.glyph_mesh_cache_indices.contains(key) {
            let index = self.glyph_mesh_cache_indices.get(key) + 0
            var candidate = self.glyph_mesh_cache[index]
            if candidate.drawing != null {
                self.outline_cache_hits++
                return index
            }
        }
        var index = 0
        if self.glyph_mesh_cache.count() < 2048 {
            self.glyph_mesh_cache.append(GlyphMeshSlot())
            index = self.glyph_mesh_cache.count() - 1
        } else {
            index = (Hashing.hash(key) % 2048 as uint) as int
            let previous_key = self.glyph_mesh_cache[index].key
            if previous_key != "" { self.glyph_mesh_cache_indices.remove(previous_key) }
        }
        var slot = self.glyph_mesh_cache[index]
        let mesh = VectorText.tessellate(outline, VectorText.tolerance_for_class(detail))
        let packed = Packing.drawing_vertices(mesh)
        var drawing = CachedSceneDrawing(
            -1,
            1,
            Hashing.hash(packed),
            packed,
            mesh.vertex_count()
        )
        self.refresh_scene_geometry(device, drawing)
        slot.key = key
        slot.drawing = drawing
        self.glyph_mesh_cache_indices.set(key, index)
        self.glyph_tessellations++
        return index
    }

    private func glyph_cache_matches(index:int, key:str) bool {
        if index < 0 || index >= self.glyph_mesh_cache.count() { return false }
        var slot = self.glyph_mesh_cache[index]
        return slot.key == key && slot.drawing != null
    }

    func collect_sprite(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        sprite:@Sprite,
        images:@Image.Store
    ) {
        let handle = sprite.asset()
        if !sprite.is_visible() || !images.contains(handle) { return }
        let image = images.get(handle)
        let cache_index = self.cache_index_for_image(
            0,
            handle.index(),
            handle.generation()
        )
        var cache = self.image_cache[cache_index]
        self.refresh_image(
            device,
            cache,
            images.revision(handle),
            image,
            "GFX.Scene2D sprite"
        )
        self.sprite_draws.append(SpriteDraw(
            cache:cache_index,
            model:world_image_model(transform),
            size:sprite.sprite_size(),
            pivot:sprite.sprite_pivot(),
            color:sprite.tint(),
            region:normalized_region(image, sprite.image_region()),
            sampling:sprite.sampling_mode(),
            layer:sprite.render_layer(),
            depth:sprite.render_depth(),
            order:entity.index * 2,
            viewport:false
        ))
    }

    func collect_tile_map(
        device:@GPU.Device,
        entity:ECS.Entity,
        transform:@Transform,
        tile_map:@TileMap,
        images:@Image.Store
    ) {
        if !tile_map.visible { return }
        let atlas = tile_map.atlas()
        let handle = atlas.image()
        if !images.contains(handle) { return }
        let image = images.get(handle)
        if image.width() % atlas.tile_width() != 0 ||
            image.height() % atlas.tile_height() != 0
        {
            panic("GFX.Scene2D.TileAtlas image dimensions must be exact multiples of its tile dimensions")
        }
        let atlas_columns = image.width() / atlas.tile_width()
        let atlas_rows = image.height() / atlas.tile_height()
        let cache_index = self.cache_index_for_image(
            0,
            handle.index(),
            handle.generation()
        )
        var cache = self.image_cache[cache_index]
        self.refresh_image(
            device,
            cache,
            images.revision(handle),
            image,
            "GFX.Scene2D tile atlas"
        )

        let bounds = viewport_bounds_in_local_space(
            self.scene_view_projection,
            transform
        )
        let visible = tile_map.visible_range(bounds.minimum, bounds.maximum)
        let first_instance = self.tile_instances.count()
        var row = visible.first_row
        while row < visible.last_row {
            var column = visible.first_column
            while column < visible.last_column {
                if let tile = tile_map.tile(column, row) {
                    if tile >= atlas_columns * atlas_rows {
                        panic("GFX.Scene2D.TileMap tile index exceeds its atlas")
                    }
                    self.tile_instances.append(TileInstance(
                        translation:Math.Vec2(
                            (column as float + 0.5) * atlas.tile_width() as float,
                            (row as float + 0.5) * atlas.tile_height() as float
                        ),
                        region:Math.Vec4(
                            (tile % atlas_columns) as float / atlas_columns as float,
                            (tile / atlas_columns) as float / atlas_rows as float,
                            1.0 / atlas_columns as float,
                            1.0 / atlas_rows as float
                        )
                    ))
                }
                column++
            }
            row++
        }
        let instance_count = self.tile_instances.count() - first_instance
        if instance_count == 0 { return }
        self.tile_map_draws.append(TileMapDraw(
            cache:cache_index,
            model:transform.matrix(),
            size:atlas.tile_size(),
            color:tile_map.color,
            sampling:tile_map.sampling_mode(),
            first_instance:first_instance,
            instance_count:instance_count,
            layer:tile_map.layer,
            depth:tile_map.depth,
            order:entity.index * 2
        ))
    }

    func finish_prepare(device:@GPU.Device) {
        self.submit_image_uploads(device)
        self.submit_coverage_uploads(device)
        self.prepare_coverage_instances(device)
        self.prepare_tile_instances(device)
        let reordered = sort_scene_draws(
            self.scene_draws,
            self.scene_draw_scratch,
            self.scene_layer_counts,
            self.scene_layer_positions
        )
        if self.sprite_draws.is_empty() && self.tile_map_draws.is_empty() &&
            self.surface_draws.is_empty() &&
            self.coverage_glyph_draws.is_empty()
        {
            self.scene_entries.clear()
        } else {
            self.rebuild_scene_entries()
        }
        self.prepare_sprite_instances(device)
        self.prepare_scene_instances(device, reordered)
        self.prune_scene_drawing_snapshots()
        self.upload_commands = null
    }

    func draw(pass:@GPU.RenderPass) {
        self.draw_grid(pass)
        self.draw_scene(pass)
    }

    func set_grid(value:Grid) { self.grid = value }

    private func draw_grid(pass:@GPU.RenderPass) {
        if !self.camera_ready { return }
        if let configured = self.grid {
            if let pipeline = self.grid_pipeline {
                pass.bind(pipeline)
                var uniform = Packing.grid(
                    self.scene_view_projection.inverted(),
                    configured
                )
                pass.vertex_uniform(0, uniform, 144)
                pass.draw(3)
            }
        }
    }

    private func draw_scene(pass:@GPU.RenderPass) {
        if !self.camera_ready { return }
        if self.sprite_draws.is_empty() && self.tile_map_draws.is_empty() &&
            self.surface_draws.is_empty() &&
            self.coverage_glyph_draws.is_empty()
        {
            self.draw_scene_drawings(pass)
            return
        }
        var cursor = 0
        while cursor < self.scene_entries.count() {
            let entry = self.scene_entries[cursor]
            if entry.kind == 0 {
                let draw = self.scene_draws[entry.index]
                if draw.kind == 2 {
                    self.draw_scene_image(pass, draw)
                    cursor++
                    continue
                }
                var cache = self.drawing_for(draw)
                var end = cursor + 1
                while end < self.scene_entries.count() {
                    let next = self.scene_entries[end]
                    if next.kind != 0 || next.index != entry.index + end - cursor ||
                        self.scene_draws[next.index].kind != draw.kind ||
                        self.scene_draws[next.index].cache != draw.cache ||
                        self.scene_draws[next.index].viewport != draw.viewport
                    {
                        break
                    }
                    end++
                }
                if cache.vertex_count > 0 {
                    var selected_pipeline = self.drawing_pipeline
                    if draw.kind == 3 { selected_pipeline = self.shadow_pipeline }
                    if let pipeline = selected_pipeline {
                        if let vertices = cache.vertices {
                            if let instances = self.drawing_instances {
                                var selected_projection = self.scene_view_projection
                                if draw.viewport { selected_projection = self.projection }
                                var projection = Packing.view_projection(selected_projection)
                                pass.bind(pipeline)
                                pass.vertex_uniform(0, projection, 64)
                                pass.vertex_buffer(0, vertices)
                                pass.vertex_buffer(1, instances)
                                pass.draw(
                                    cache.vertex_count,
                                    end - cursor,
                                    0,
                                    entry.index
                                )
                            }
                        }
                    }
                }
                cursor = end
            } elif entry.kind == 1 {
                let draw = self.sprite_draws[entry.index]
                var end = cursor + 1
                while end < self.scene_entries.count() {
                    let next_entry = self.scene_entries[end]
                    if next_entry.kind != 1 { break }
                    let next = self.sprite_draws[next_entry.index]
                    if !sprite_draws_are_compatible(draw, next) { break }
                    end++
                }
                self.draw_scene_sprites(
                    pass,
                    draw,
                    end - cursor,
                    self.sprite_instance_indices[entry.index]
                )
                cursor = end
            } elif entry.kind == 2 {
                let draw = self.coverage_glyph_draws[entry.index]
                var instance_count = draw.instance_count
                var end = cursor + 1
                var previous = draw
                while end < self.scene_entries.count() {
                    let next_entry = self.scene_entries[end]
                    if next_entry.kind != 2 { break }
                    let next = self.coverage_glyph_draws[next_entry.index]
                    if !coverage_draws_are_contiguous(previous, next) { break }
                    instance_count += next.instance_count
                    previous = next
                    end++
                }
                self.draw_coverage_glyphs(pass, draw, instance_count)
                cursor = end
            } elif entry.kind == 3 {
                self.draw_tile_map(pass, self.tile_map_draws[entry.index])
                cursor++
            } else {
                self.draw_canvas_surface(pass, self.surface_draws[entry.index])
                cursor++
            }
        }
    }

    private func draw_scene_drawings(pass:@GPU.RenderPass) {
        var cursor = 0
        while cursor < self.scene_draws.count() {
            let draw = self.scene_draws[cursor]
            if draw.kind == 2 {
                self.draw_scene_image(pass, draw)
                cursor++
                continue
            }
            var cache = self.drawing_for(draw)
            var end = cursor + 1
            while end < self.scene_draws.count() &&
                self.scene_draws[end].kind == draw.kind &&
                self.scene_draws[end].cache == draw.cache &&
                self.scene_draws[end].viewport == draw.viewport
            {
                end++
            }
            if cache.vertex_count > 0 {
                var selected_pipeline = self.drawing_pipeline
                if draw.kind == 3 { selected_pipeline = self.shadow_pipeline }
                if let pipeline = selected_pipeline {
                    if let vertices = cache.vertices {
                        if let instances = self.drawing_instances {
                            var selected_projection = self.scene_view_projection
                            if draw.viewport { selected_projection = self.projection }
                            var projection = Packing.view_projection(selected_projection)
                            pass.bind(pipeline)
                            pass.vertex_uniform(0, projection, 64)
                            pass.vertex_buffer(0, vertices)
                            pass.vertex_buffer(1, instances)
                            pass.draw(cache.vertex_count, end - cursor, 0, cursor)
                        }
                    }
                }
            }
            cursor = end
        }
    }

    private func drawing_for(draw:@SceneDraw) CachedSceneDrawing {
        if draw.kind == 0 || draw.kind == 3 {
            return self.scene_drawing_cache[draw.cache]
        }
        if draw.kind == 2 {
            return self.scene_drawing_cache[self.image_mask_draws[draw.cache].geometry_cache]
        }
        var slot = self.glyph_mesh_cache[draw.cache]
        if let drawing = slot.drawing { return drawing }
        panic("GFX.Scene2D vector glyph cache entry was evicted during a frame")
    }

    private func draw_scene_image(pass:@GPU.RenderPass, draw:@SceneDraw) {
        let image_draw = self.image_mask_draws[draw.cache]
        var geometry = self.scene_drawing_cache[image_draw.geometry_cache]
        var image = self.image_cache[image_draw.image_cache]
        if geometry.vertex_count == 0 { return }
        if let pipeline = self.image_drawing_pipeline {
            if let vertices = geometry.vertices {
                if let instances = self.drawing_instances {
                    if let texture = image.texture {
                        if let sampler = self.sampler {
                            var selected_projection = self.scene_view_projection
                            if draw.viewport { selected_projection = self.projection }
                            var projection = Packing.view_projection(selected_projection)
                            pass.bind(pipeline)
                            pass.vertex_uniform(0, projection, 64)
                            pass.fragment_uniform(0, image_draw.uniform, 80)
                            pass.fragment_sampler(0, texture, sampler)
                            pass.vertex_buffer(0, vertices)
                            pass.vertex_buffer(1, instances)
                            pass.draw(geometry.vertex_count, 1, 0, draw.instance)
                        }
                    }
                }
            }
        }
    }

    private func draw_scene_sprites(
        pass:@GPU.RenderPass,
        draw:SpriteDraw,
        instance_count:int,
        first_instance:int
    ) {
        var cache = self.image_cache[draw.cache]
        if let texture = cache.texture {
            if let pipeline = self.sprite_pipeline {
                var selected_sampler = self.sampler
                if draw.sampling == 1 { selected_sampler = self.pixelated_sampler }
                if let sampler = selected_sampler {
                    if let vertices = self.quad_vertices {
                        if let instances = self.sprite_instance_buffer {
                            if let indices = self.quad_indices {
                                var selected_projection = self.scene_view_projection
                                if draw.viewport { selected_projection = self.projection }
                                var uniform = Packing.view_projection(selected_projection)
                                pass.bind(pipeline)
                                pass.vertex_uniform(0, uniform, 64)
                                pass.fragment_sampler(0, texture, sampler)
                                pass.vertex_buffer(0, vertices)
                                pass.vertex_buffer(1, instances)
                                pass.index_buffer(indices)
                                pass.draw_indexed(
                                    6,
                                    instance_count,
                                    0,
                                    0,
                                    first_instance
                                )
                            }
                        }
                    }
                }
            }
        }
    }

    private func draw_tile_map(pass:@GPU.RenderPass, draw:TileMapDraw) {
        var cache = self.image_cache[draw.cache]
        if let texture = cache.texture {
            if let pipeline = self.tile_map_pipeline {
                var selected_sampler = self.sampler
                if draw.sampling == 1 { selected_sampler = self.pixelated_sampler }
                if let sampler = selected_sampler {
                    if let vertices = self.quad_vertices {
                        if let instances = self.tile_instance_buffer {
                            if let indices = self.quad_indices {
                                var uniform = Packing.tile_map_uniform(
                                    draw.model,
                                    self.scene_view_projection,
                                    draw.size,
                                    draw.color,
                                    draw.depth
                                )
                                pass.bind(pipeline)
                                pass.vertex_uniform(0, uniform, 160)
                                pass.fragment_sampler(0, texture, sampler)
                                pass.vertex_buffer(0, vertices)
                                pass.vertex_buffer(1, instances)
                                pass.index_buffer(indices)
                                pass.draw_indexed(
                                    6,
                                    draw.instance_count,
                                    0,
                                    0,
                                    draw.first_instance
                                )
                            }
                        }
                    }
                }
            }
        }
    }

    private func draw_canvas_surface(pass:@GPU.RenderPass, draw:SurfaceDraw) {
        if !draw.surface.is_valid() { return }
        if let pipeline = self.surface_pipeline {
            if let sampler = self.sampler {
                if let vertices = self.quad_vertices {
                    if let indices = self.quad_indices {
                        var selected_projection = self.scene_view_projection
                        if draw.viewport { selected_projection = self.projection }
                        var uniform = Packing.scene_sprite_uniform(
                            draw.model,
                            selected_projection,
                            draw.size,
                            Math.Vec2(),
                            draw.color,
                            draw.depth,
                            Math.Vec4(0.0, 0.0, 1.0, 1.0)
                        )
                        var texture = draw.surface.texture()
                        pass.bind(pipeline)
                        pass.vertex_uniform(0, uniform, 256)
                        pass.fragment_sampler(0, texture, sampler)
                        pass.vertex_buffer(0, vertices)
                        pass.index_buffer(indices)
                        pass.draw_indexed(6)
                    }
                }
            }
        }
    }

    private func draw_coverage_glyphs(
        pass:@GPU.RenderPass,
        draw:CoverageGlyphDraw,
        instance_count:int
    ) {
        if draw.block_cache >= 0 && draw.block_cache < self.coverage_block_cache.count() {
            var block = self.coverage_block_cache[draw.block_cache]
            if let instances = block.instances {
                self.draw_coverage_buffer(pass, draw, instances, instance_count)
            }
            return
        }
        if self.coverage_instance_active_slot < 0 ||
            self.coverage_instance_active_slot >= self.coverage_instance_ring.count()
        { return }
        var active = self.coverage_instance_ring[self.coverage_instance_active_slot]
        if let instances = active.instances {
            self.draw_coverage_buffer(pass, draw, instances, instance_count)
        }
    }

    private func draw_coverage_buffer(
        pass:@GPU.RenderPass,
        draw:@CoverageGlyphDraw,
        instances:@GPU.Buffer,
        instance_count:int
    ) {
        if draw.page < 0 || draw.page >= self.coverage_atlas_pages.count() { return }
        var page = self.coverage_atlas_pages[draw.page]
        if let texture = page.texture {
            if let pipeline = self.coverage_glyph_pipeline {
                if let sampler = self.sampler {
                    if let vertices = self.quad_vertices {
                        if let indices = self.quad_indices {
                            var selected_projection = self.scene_view_projection
                            if draw.viewport { selected_projection = self.projection }
                            var uniform = Packing.coverage_draw_uniform(
                                selected_projection,
                                draw.model.x,
                                draw.model.y,
                                draw.model.translation,
                                draw.clip
                            )
                            pass.bind(pipeline)
                            pass.vertex_uniform(0, uniform, 112)
                            pass.fragment_uniform(0, uniform, 112)
                            pass.fragment_sampler(0, texture, sampler)
                            pass.vertex_buffer(0, vertices)
                            pass.vertex_buffer(1, instances)
                            pass.index_buffer(indices)
                            pass.draw_indexed(
                                6,
                                instance_count,
                                0,
                                0,
                                draw.first_instance
                            )
                        }
                    }
                }
            }
        }
    }

    private func known_scene_drawing_cache(snapshot_id:int) int {
        if snapshot_id == self.last_scene_snapshot_id {
            return self.last_scene_cache_index
        }
        if self.scene_drawing_snapshots.contains(snapshot_id) {
            let cache_index:int =
                self.scene_drawing_snapshots.get(snapshot_id) + 0
            self.last_scene_snapshot_id = snapshot_id
            self.last_scene_cache_index = cache_index
            return cache_index
        }
        return -1
    }

    private func prepared_scene_drawing_cache(
        device:@GPU.Device,
        entity_index:int,
        previous_snapshot_id:int,
        canvas:@SceneCanvas
    ) int {
        let snapshot_id = canvas.prepared_revision()
        let synchronized_cache_index =
            self.recently_synchronized_scene_drawing_cache(
                snapshot_id
            )
        if synchronized_cache_index >= 0 { return synchronized_cache_index }
        let previous_cache_index = self.known_scene_drawing_cache(
            previous_snapshot_id
        )
        var cache_index = self.known_scene_drawing_cache(snapshot_id)
        if cache_index >= 0 {
            self.retain_scene_drawing_snapshot(snapshot_id, cache_index)
            self.remember_synchronized_scene_drawing(
                snapshot_id,
                cache_index
            )
            return cache_index
        }
        cache_index = self.resolve_scene_drawing_cache(
            device,
            entity_index,
            previous_cache_index,
            canvas
        )
        self.retain_scene_drawing_snapshot(snapshot_id, cache_index)
        self.remember_synchronized_scene_drawing(snapshot_id, cache_index)
        return cache_index
    }

    private func synchronize_scene_canvas(canvas:@SceneCanvas) {
        let authored_id = canvas.authored_id()
        if authored_id == self.last_synchronized_authored_id { return }
        self.last_synchronized_authored_id = authored_id
        if self.synchronized_authored_canvases.contains(authored_id) { return }
        canvas.synchronize_retained()
        self.synchronized_authored_canvases.set(authored_id, 1)
        self.canvas_synchronizations++
    }

    private func recently_synchronized_scene_drawing_cache(
        snapshot_id:int
    ) int {
        if self.last_synchronized_scene_generation == self.prepare_generation &&
            self.last_synchronized_scene_snapshot_id == snapshot_id
        {
            return self.last_synchronized_scene_cache_index
        }
        if self.previous_synchronized_scene_generation == self.prepare_generation &&
            self.previous_synchronized_scene_snapshot_id == snapshot_id
        {
            return self.previous_synchronized_scene_cache_index
        }
        return -1
    }

    private func remember_synchronized_scene_drawing(
        snapshot_id:int,
        cache_index:int
    ) {
        if snapshot_id == self.last_synchronized_scene_snapshot_id {
            self.last_synchronized_scene_cache_index = cache_index
            self.last_synchronized_scene_generation = self.prepare_generation
            return
        }
        self.previous_synchronized_scene_snapshot_id =
            self.last_synchronized_scene_snapshot_id
        self.previous_synchronized_scene_cache_index =
            self.last_synchronized_scene_cache_index
        self.previous_synchronized_scene_generation =
            self.last_synchronized_scene_generation
        self.last_synchronized_scene_snapshot_id = snapshot_id
        self.last_synchronized_scene_cache_index = cache_index
        self.last_synchronized_scene_generation = self.prepare_generation
    }

    private func resolve_scene_drawing_cache(
        device:@GPU.Device,
        entity_index:int,
        previous_cache_index:int,
        canvas:@SceneCanvas
    ) int {
        var cache_index = -1
        if canvas.is_detached() {
            cache_index = self.mutable_scene_drawing(entity_index, canvas)
        } elif previous_cache_index >= 0 &&
            self.scene_drawing_cache[previous_cache_index].mutable
        {
            cache_index = previous_cache_index
            self.refresh_mutable_scene_drawing(cache_index, canvas)
        } elif canvas.revision() > 1 {
            cache_index = self.create_mutable_scene_drawing(canvas)
        } else {
            cache_index = self.register_scene_drawing(canvas)
        }
        var cache = self.scene_drawing_cache[cache_index]
        self.refresh_scene_geometry(device, cache)
        return cache_index
    }

    private func register_scene_drawing(canvas:@SceneCanvas) int {
        let snapshot_id = canvas.prepared_revision()
        let geometry = canvas.geometry()
        let packed = Packing.drawing_vertices(geometry)
        let geometry_hash = Hashing.hash(packed)
        var index = 0
        while index < self.scene_drawing_cache.count() {
            var cache = self.scene_drawing_cache[index]
            if !cache.mutable && cache.geometry_hash == geometry_hash &&
                cache.packed_vertices == packed
            {
                return index
            }
            index++
        }
        var created = CachedSceneDrawing(
            snapshot_id,
            canvas.geometry_revision(),
            geometry_hash,
            packed,
            geometry.vertex_count()
        )
        self.scene_drawing_cache.append(created)
        return self.scene_drawing_cache.count() - 1
    }

    private func register_content_drawing(
        device:@GPU.Device,
        geometry:@Mesh
    ) int {
        let packed = Packing.drawing_vertices(geometry)
        return self.register_packed_drawing(
            device,
            packed,
            geometry.vertex_count(),
            36
        )
    }

    private func content_drawing_cache(
        device:@GPU.Device,
        entity_index:int,
        order:int,
        canvas:@SceneCanvas,
        geometry:@Mesh
    ) int {
        if self.surface_content_identity > 0 {
            return self.surface_content_drawing(
                device,
                order,
                0,
                geometry,
                36
            )
        }
        if !canvas.is_detached() && canvas.revision() <= 1 {
            let key = self.mutable_content_key(entity_index, order, 0, canvas)
            if self.mutable_content_drawings.contains(key) {
                return self.mutable_content_drawings.get(key) + 0
            }
            let cache_index = self.register_content_drawing(device, geometry)
            self.mutable_content_drawings.set(key, cache_index)
            return cache_index
        }
        let packed = Packing.drawing_vertices(geometry)
        return self.mutable_content_drawing(
            device,
            self.mutable_content_key(entity_index, order, 0, canvas),
            canvas.prepared_revision(),
            canvas.geometry_revision(),
            packed,
            geometry.vertex_count(),
            36
        )
    }

    private func register_shadow_drawing(
        device:@GPU.Device,
        geometry:@Mesh
    ) int {
        let packed = Packing.shadow_vertices(geometry)
        return self.register_packed_drawing(
            device,
            packed,
            geometry.vertex_count(),
            60
        )
    }

    private func shadow_drawing_cache(
        device:@GPU.Device,
        entity_index:int,
        order:int,
        canvas:@SceneCanvas,
        geometry:@Mesh
    ) int {
        if self.surface_content_identity > 0 {
            return self.surface_content_drawing(
                device,
                order,
                1,
                geometry,
                60
            )
        }
        if !canvas.is_detached() && canvas.revision() <= 1 {
            let key = self.mutable_content_key(entity_index, order, 1, canvas)
            if self.mutable_content_drawings.contains(key) {
                return self.mutable_content_drawings.get(key) + 0
            }
            let cache_index = self.register_shadow_drawing(device, geometry)
            self.mutable_content_drawings.set(key, cache_index)
            return cache_index
        }
        let packed = Packing.shadow_vertices(geometry)
        return self.mutable_content_drawing(
            device,
            self.mutable_content_key(entity_index, order, 1, canvas),
            canvas.prepared_revision(),
            canvas.geometry_revision(),
            packed,
            geometry.vertex_count(),
            60
        )
    }

    private func mutable_content_key(
        entity_index:int,
        order:int,
        format:int,
        canvas:@SceneCanvas
    ) int {
        if canvas.is_detached() {
            return entity_index * 8_192 + order * 2 + format
        }
        return -(canvas.authored_id() * 8_192 + order * 2 + format) - 1
    }

    private func surface_content_drawing(
        device:@GPU.Device,
        order:int,
        format:int,
        geometry:@Mesh,
        vertex_stride:int
    ) int {
        let key = self.surface_content_identity * 8_192 + order * 2 + format
        var packed = Packing.drawing_vertices(geometry)
        if format == 1 { packed = Packing.shadow_vertices(geometry) }
        let geometry_hash = Hashing.hash(packed)
        if self.surface_content_drawings.contains(key) {
            let cache_index:int = self.surface_content_drawings.get(key) + 0
            var cache = self.scene_drawing_cache[cache_index]
            if cache.snapshot_id != self.surface_content_revision {
                if cache.geometry_hash == geometry_hash &&
                    cache.packed_vertices == packed
                {
                    cache.retain_snapshot(self.surface_content_revision)
                } else {
                    cache.geometry_hash = geometry_hash
                    cache.replace(
                        self.surface_content_revision,
                        self.surface_content_revision,
                        packed + "",
                        geometry.vertex_count()
                    )
                }
            }
            self.refresh_scene_geometry(device, cache)
            return cache_index
        }
        var created = CachedSceneDrawing(
            self.surface_content_revision,
            self.surface_content_revision,
            geometry_hash,
            packed,
            geometry.vertex_count(),
            mutable:true,
            vertex_stride:vertex_stride
        )
        self.scene_drawing_cache.append(created)
        let cache_index = self.scene_drawing_cache.count() - 1
        self.surface_content_drawings.set(key, cache_index)
        var retained = self.scene_drawing_cache[cache_index]
        self.refresh_scene_geometry(device, retained)
        return cache_index
    }

    private func mutable_content_drawing(
        device:@GPU.Device,
        key:int,
        snapshot_id:int,
        geometry_revision:int,
        packed:str,
        vertex_count:int,
        vertex_stride:int
    ) int {
        if self.mutable_content_drawings.contains(key) {
            let cache_index:int = self.mutable_content_drawings.get(key) + 0
            var cache = self.scene_drawing_cache[cache_index]
            if cache.snapshot_id != snapshot_id {
                let geometry_hash = Hashing.hash(packed)
                if cache.geometry_hash == geometry_hash &&
                    cache.packed_vertices == packed
                {
                    cache.retain_snapshot(snapshot_id)
                } elif !cache.mutable {
                    var created = CachedSceneDrawing(
                        snapshot_id,
                        geometry_revision,
                        geometry_hash,
                        packed,
                        vertex_count,
                        mutable:true,
                        vertex_stride:vertex_stride
                    )
                    self.scene_drawing_cache.append(created)
                    let mutable_index = self.scene_drawing_cache.count() - 1
                    self.mutable_content_drawings.set(key, mutable_index)
                    var retained = self.scene_drawing_cache[mutable_index]
                    self.refresh_scene_geometry(device, retained)
                    return mutable_index
                } else {
                    cache.geometry_hash = geometry_hash
                    cache.replace(
                        snapshot_id,
                        geometry_revision,
                        packed,
                        vertex_count
                    )
                }
            }
            self.refresh_scene_geometry(device, cache)
            return cache_index
        }
        let cache_index = self.register_packed_drawing(
            device,
            packed,
            vertex_count,
            vertex_stride
        )
        self.mutable_content_drawings.set(key, cache_index)
        return cache_index
    }

    private func register_packed_drawing(
        device:@GPU.Device,
        packed:str,
        vertex_count:int,
        vertex_stride:int
    ) int {
        let geometry_hash = Hashing.hash(packed)
        var index = 0
        while index < self.scene_drawing_cache.count() {
            var cache = self.scene_drawing_cache[index]
            if !cache.mutable && cache.vertex_stride == vertex_stride &&
                cache.geometry_hash == geometry_hash &&
                cache.packed_vertices == packed
            {
                self.refresh_scene_geometry(device, cache)
                return index
            }
            index++
        }
        var created = CachedSceneDrawing(
            -1,
            1,
            geometry_hash,
            packed,
            vertex_count,
            vertex_stride:vertex_stride
        )
        self.scene_drawing_cache.append(created)
        let created_index = self.scene_drawing_cache.count() - 1
        var retained = self.scene_drawing_cache[created_index]
        self.refresh_scene_geometry(device, retained)
        return created_index
    }

    private func retain_scene_drawing_snapshot(snapshot_id:int, cache_index:int) {
        if !self.scene_drawing_snapshots.contains(snapshot_id) {
            self.scene_drawing_snapshots.set(snapshot_id, cache_index)
        }
        self.scene_drawing_snapshot_generations.set(
            snapshot_id,
            self.prepare_generation
        )
        self.last_scene_snapshot_id = snapshot_id
        self.last_scene_cache_index = cache_index
    }

    private func prune_scene_drawing_snapshots() {
        let snapshots = self.scene_drawing_snapshot_generations.get_keys()
        for snapshot_id in snapshots {
            let generation:int =
                self.scene_drawing_snapshot_generations.get(snapshot_id) + 0
            if generation < self.prepare_generation {
                self.scene_drawing_snapshot_generations.remove(snapshot_id)
                self.scene_drawing_snapshots.remove(snapshot_id)
                if self.last_scene_snapshot_id == snapshot_id {
                    self.last_scene_snapshot_id = -1
                    self.last_scene_cache_index = -1
                }
            }
        }
    }

    private func mutable_scene_drawing(
        entity_index:int,
        canvas:@SceneCanvas
    ) int {
        if self.mutable_scene_drawings.contains(entity_index) {
            let cache_index:int = self.mutable_scene_drawings.get(entity_index) + 0
            self.refresh_mutable_scene_drawing(cache_index, canvas)
            return cache_index
        }
        let cache_index = self.create_mutable_scene_drawing(canvas)
        self.mutable_scene_drawings.set(entity_index, cache_index)
        return cache_index
    }

    private func create_mutable_scene_drawing(canvas:@SceneCanvas) int {
        let geometry = canvas.geometry()
        let packed = Packing.drawing_vertices(geometry)
        var created = CachedSceneDrawing(
            canvas.prepared_revision(),
            canvas.geometry_revision(),
            // Mutable drawings never participate in content-hash deduplication.
            0,
            packed,
            geometry.vertex_count(),
            mutable:true
        )
        self.scene_drawing_cache.append(created)
        return self.scene_drawing_cache.count() - 1
    }

    private func refresh_mutable_scene_drawing(
        cache_index:int,
        canvas:@SceneCanvas
    ) {
        var cache = self.scene_drawing_cache[cache_index]
        if cache.snapshot_id == canvas.prepared_revision() { return }
        if cache.geometry_revision == canvas.geometry_revision() {
            cache.retain_snapshot(canvas.prepared_revision())
            return
        }
        let geometry = canvas.geometry()
        var packed = Packing.drawing_vertices(geometry)
        cache.replace(
            canvas.prepared_revision(),
            canvas.geometry_revision(),
            move packed,
            geometry.vertex_count()
        )
    }

    private func refresh_scene_geometry(
        device:@GPU.Device,
        cache:&CachedSceneDrawing
    ) {
        if !cache.dirty { return }
        if cache.vertex_count == 0 { cache.dirty = false; return }
        let byte_count = cache.vertex_count * cache.vertex_stride
        if cache.vertices == null || cache.vertex_capacity < byte_count {
            cache.upload = device.upload_buffer(
                byte_count,
                "GFX.Scene2D retained drawing upload"
            )
            cache.vertices = device.buffer(GPU.BufferSettings(
                size:byte_count,
                usage:GPU.BufferUsage.vertex(),
                name:"GFX.Scene2D retained drawing vertices"
            ))
            cache.vertex_capacity = byte_count
        }
        if let upload = cache.upload {
            if let destination = cache.vertices {
                upload.write_packed(cache.bytes(), byte_count, cycle:true)
                if var commands = self.upload_commands {
                    copy_buffer_on(commands, upload, destination, byte_count)
                } else {
                    copy_buffer(device, upload, destination, byte_count)
                }
            }
        }
        self.geometry_refreshes++
        cache.dirty = false
    }

    package func drawing_cache_count() int {
        return self.scene_drawing_cache.count()
    }

    package func vector_layer_cache_count() int {
        return self.vector_layer_cache.count()
    }

    package func drawing_snapshot_count() int {
        return self.scene_drawing_snapshots.count()
    }

    package func geometry_refresh_count() int { return self.geometry_refreshes }

    package func canvas_synchronization_count() int {
