    package func image_cache_count() int { return self.image_cache.count() }
    package func image_upload_count() int { return self.image_uploads }

    package func analytic_shadow_draw_count() int {
        var count = 0
        for draw in self.scene_draws {
            if draw.kind == 3 { count++ }
        }
