use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Font
use GFX.Rendering
use GFX.Scene2D
use GFX.Scene2D.Renderer
use GFX.Scene2D.VectorText
use GFX.Window.Plugin as WindowPlugin
use STD.Math
use STD.Text.UTF8

func required_face(result:Result<Font.Face, Font.Error>) Font.Face {
    match result {
        failure(error) => { panic(error.detail) }
        success(face) => { return face }
    }
}

func required_instance(result:Result<Font.Instance, Font.Error>) Font.Instance {
    match result {
        failure(error) => { panic(error.detail) }
        success(instance) => { return instance }
    }
}

func required_run(result:Result<Font.GlyphRun, Font.Error>) Font.GlyphRun {
    match result {
        failure(error) => { panic(error.detail) }
        success(run) => { return run }
    }
}

func required_outline(result:Result<Font.GlyphOutline?, Font.Error>) Font.GlyphOutline {
    match result {
        failure(error) => { panic(error.detail) }
        success(value) => {
            if let outline = value { return outline }
            panic("test glyph has no vector outline")
        }
    }
}

func cross(a:Math.Vec2, b:Math.Vec2, point:Math.Vec2) float {
    return (b.x - a.x) * (point.y - a.y) - (b.y - a.y) * (point.x - a.x)
}

func triangle_contains(point:Math.Vec2, a:Math.Vec2, b:Math.Vec2, c:Math.Vec2) bool {
    let first = cross(a, b, point)
    let second = cross(b, c, point)
    let third = cross(c, a, point)
    let negative = first < 0.0 || second < 0.0 || third < 0.0
    let positive = first > 0.0 || second > 0.0 || third > 0.0
    return !(negative && positive)
}

func mesh_covers(mesh:@Canvas.Mesh, point:Math.Vec2) bool {
    let vertices = mesh.vertices()
    var index = 0
    while index + 2 < vertices.count() {
        let first = vertices[index].position
        let second = vertices[index + 1].position
        let third = vertices[index + 2].position
        if triangle_contains(
            point,
            Math.Vec2(first.x, first.y),
            Math.Vec2(second.x, second.y),
            Math.Vec2(third.x, third.y)
        ) { return true }
        index += 3
    }
    return false
}

func quantized(value:float64) float {
    return (Math.round(value * 65536.0) as int) as float / 65536.0
}

test "tessellate glyph counters with non-zero holes" {
    var face = required_face(Font.Face.default())
    var instance = required_instance(Font.Instance.create(face, size:32.0))
    var run = required_run(instance.shape("O"))
    let outline = required_outline(instance.outline(run.glyphs()[0].id))
    let mesh = VectorText.tessellate(outline, 0.0075)
    assert(mesh.triangle_count() > 0)
    let center = Math.Vec2(
        quantized(outline.bounds.x + outline.bounds.width * 0.5),
        quantized(outline.bounds.y + outline.bounds.height * 0.5)
    )
    assert(!mesh_covers(mesh, center))
}

class VectorProbe {
    var frames:int = 0
    var tessellations:int = 0
    var entity:ECS.Entity? = null
    var expected_meshes:int = 0
}

func vector_mesh_count(drawing:&Canvas) int {
    var layers = drawing.snapshot(160, 40).text_layers()
    var glyphs:uint32[] = []
    match layers[0].vector_outlines() {
        failure(error) => { panic(error.detail) }
        success(placements) => {
            for placement in placements {
                if let outline = placement.glyph.outline {
                    if outline.is_empty() { continue }
                    var known = false
                    for glyph in glyphs {
                        if glyph == placement.glyph.glyph_id { known = true }
                    }
                    if !known { glyphs.append(placement.glyph.glyph_id) }
                }
            }
        }
    }
    return glyphs.count()
}

func create_vector_text(world:&ECS.World, probe:&VectorProbe) {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "office O B á",
            Math.Vec2(4.0, 4.0),
            Canvas.TextStyle(size:18.0, color:Color.cyan_300())
        )
    })
    probe.expected_meshes = vector_mesh_count(drawing)
    probe.entity = world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Canvas(drawing, 160, 32)
            ..space = Components.CanvasSpace.viewport
            ..text_mode = Scene2D.CanvasTextMode.vector
        )
    )
    var large = Canvas()
    large.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "office O B á",
            Math.Vec2(4.0),
            Canvas.TextStyle(size:30.0, color:Color.amber_300())
        )
    })
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Math.Vec2(0.0, 24.0)))
        ..with(Components.Canvas(large, 160, 40)
            ..space = Components.CanvasSpace.viewport
            ..text_mode = Scene2D.CanvasTextMode.automatic
        )
    )
}

func verify_vector_text_cache(
    renderer:@Renderer,
    world:&ECS.World,
    probe:&VectorProbe,
    controller:&Application.Controller
) {
    assert(renderer.vector_instance_count() > 0)
    assert(renderer.coverage_raster_count() == 0)
    assert(renderer.text_uploaded_pixel_count() == 0)
    assert(renderer.glyph_mesh_count() > 0)
    assert(renderer.glyph_mesh_count() <= 2048)
    assert(renderer.glyph_mesh_count() == probe.expected_meshes)
    if probe.frames == 0 {
        probe.tessellations = renderer.vector_tessellation_count()
        assert(probe.tessellations > 0)
        if let entity = probe.entity {
            world.update<Components.Transform2D>(entity, func(transform:&Components.Transform2D) {
                transform.position = Math.Vec2(8.0, 3.0)
                transform.rotation = 0.2
            })
        }
        probe.frames++
        return
    }
    assert(renderer.vector_tessellation_count() == probe.tessellations)
    assert(renderer.vector_outline_cache_hit_count() > 0)
    controller.stop()
}

test "reuse vector glyph meshes across transform changes without raster or upload" {
    var application = Application()
    application.add_resource(VectorProbe())
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "Scene2D vector text"
        ..width = 160
        ..height = 32
        ..hidden = true
    ))
    application.add_plugin(Rendering.Plugin())
    application.add_plugin(Scene2D.Plugin())
    application.add_system(Application.Schedule.startup, create_vector_text)
    application.add_after_system(Application.Schedule.render, verify_vector_text_cache)
    assert(application.run() == 0)
}

class CoverageProbe {
    var frames:int = 0
    var rasters:int = 0
    var uploaded:int = 0
    var instance_uploads:int = 0
    var instance_allocations:int = 0
    var entity:ECS.Entity? = null
}

func create_coverage_text(world:&ECS.World, probe:&CoverageProbe) {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "hinted 12 px",
            Math.Vec2(2.0),
            Canvas.TextStyle(size:12.0),
            clip:Canvas.Rect(Math.Vec2(2.0, 4.0), Math.Vec2(45.0, 12.0))
        )
    })
    probe.entity = world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Canvas(drawing, 128, 24)
            ..space = Components.CanvasSpace.viewport
            // Clipped text resolves through coverage even when the caller
            // otherwise prefers vector outlines.
            ..text_mode = Scene2D.CanvasTextMode.vector
            ..coverage_density = 2.0
        )
    )
}

func verify_coverage_cache(
    renderer:@Renderer,
    world:&ECS.World,
    probe:&CoverageProbe,
    controller:&Application.Controller
) {
    assert(renderer.vector_instance_count() == 0)
    if probe.frames == 0 {
        probe.rasters = renderer.coverage_raster_count()
        probe.uploaded = renderer.text_uploaded_pixel_count()
        probe.instance_uploads = renderer.coverage_instance_upload_count()
        probe.instance_allocations = renderer.coverage_instance_allocation_count()
        assert(probe.rasters > 0)
        assert(probe.uploaded > 0)
        assert(probe.instance_uploads > 0)
        assert(renderer.coverage_atlas_page_count() == 1)
        assert(renderer.coverage_glyph_instance_count() > 0)
        if let entity = probe.entity {
            world.update<Components.Transform2D>(entity, func(transform:&Components.Transform2D) {
                transform.position = Math.Vec2(17.0, 3.0)
            })
        }
        probe.frames++
        return
    }
    assert(renderer.coverage_raster_count() == probe.rasters)
    assert(renderer.text_uploaded_pixel_count() == probe.uploaded)
    assert(renderer.coverage_instance_upload_count() == probe.instance_uploads)
    assert(renderer.coverage_instance_allocation_count() == probe.instance_allocations)
    assert(renderer.coverage_atlas_page_count() == 1)
    assert(renderer.coverage_glyph_instance_count() > 0)
    controller.stop()
}

class CoverageRingProbe {
    var frames:int = 0
    var entity:ECS.Entity? = null
}

func coverage_ring_drawing(frame:int) Canvas {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "bounded coverage stream $(frame)",
            Math.Vec2(2.0),
            Canvas.TextStyle(size:12.0),
            clip:Canvas.Rect(Math.Vec2(), Math.Vec2(150.0, 24.0))
        )
    })
    return drawing
}

func create_coverage_ring_text(world:&ECS.World, probe:&CoverageRingProbe) {
    var drawing = coverage_ring_drawing(0)
    probe.entity = world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Canvas(drawing, 160, 24)
            ..space = Components.CanvasSpace.viewport
            ..text_mode = Scene2D.CanvasTextMode.coverage
            ..coverage_density = 2.0
        )
    )
}

func verify_coverage_ring(
    renderer:@Renderer,
    world:&ECS.World,
    probe:&CoverageRingProbe,
    controller:&Application.Controller
) {
    assert(renderer.coverage_instance_allocation_count() <= 4)
    if probe.frames >= 12 {
        assert(renderer.coverage_instance_allocation_count() == 4)
        assert(renderer.coverage_instance_upload_count() >= 12)
        controller.stop()
        return
    }
    if let entity = probe.entity {
        var drawing = coverage_ring_drawing(probe.frames + 1)
        world.update<Components.Canvas>(entity, func(canvas:&Components.Canvas) {
            canvas.replace(drawing)
        })
    }
    probe.frames++
}

test "retain hinted coverage at explicit density without a second-frame upload" {
    var application = Application()
    application.add_resource(CoverageProbe())
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "Scene2D hinted text"
        ..width = 128
        ..height = 24
        ..hidden = true
    ))
    application.add_plugin(Rendering.Plugin())
    application.add_plugin(Scene2D.Plugin())
    application.add_system(Application.Schedule.startup, create_coverage_text)
    application.add_after_system(Application.Schedule.render, verify_coverage_cache)
    assert(application.run() == 0)
}

test "bound continuously changing coverage instances to a fixed GPU ring" {
    var application = Application()
    application.add_resource(CoverageRingProbe())
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "Scene2D bounded coverage stream"
        ..width = 160
        ..height = 24
        ..hidden = true
    ))
    application.add_plugin(Rendering.Plugin())
    application.add_plugin(Scene2D.Plugin())
    application.add_system(Application.Schedule.startup, create_coverage_ring_text)
    application.add_after_system(Application.Schedule.render, verify_coverage_ring)
    assert(application.run() == 0)
}

class RetainedChurnProbe {
    var frames:int = 0
    var entity:ECS.Entity? = null
    var stable_glyph_slots:int = 0
    var stable_drawing_cache:int = 0
}

func retained_churn_drawing(frame:int) Canvas {
    var block = Canvas.TextBlock(
        "retained viewport block $(frame)",
        Canvas.TextStyle(size:14.0, line_height:19.0)
    )
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text_block(
            block,
            Math.Vec2(4.0),
            clip:Canvas.Rect(Math.Vec2(), Math.Vec2(180.0, 24.0))
        )
    })
    return drawing
}

func create_retained_churn(world:&ECS.World, probe:&RetainedChurnProbe) {
    var drawing = retained_churn_drawing(0)
    probe.entity = world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Canvas(drawing, 180, 24)
            ..space = Components.CanvasSpace.viewport
            ..text_mode = Scene2D.CanvasTextMode.coverage
            ..coverage_density = 2.0
        )
    )
}

func verify_retained_churn(
    renderer:@Renderer,
    world:&ECS.World,
    probe:&RetainedChurnProbe,
    controller:&Application.Controller
) {
    assert(renderer.coverage_block_cache_count() <= 128)
    assert(renderer.coverage_block_cache_index_count() ==
        renderer.coverage_block_cache_count())
    assert(renderer.coverage_block_cache_index_is_consistent())
    assert(renderer.coverage_instance_allocation_count() == 0)
    if probe.frames == 16 {
        probe.stable_glyph_slots = renderer.coverage_glyph_slot_count()
        probe.stable_drawing_cache = renderer.drawing_cache_count()
        assert(probe.stable_glyph_slots > 0)
        assert(probe.stable_drawing_cache == 0)
    }
    if probe.frames > 0 && probe.frames % 64 == 0 {
        print(
            "GFX_SCENE2D retained_depth blocks=$(probe.frames) cache=" +
            "$(renderer.coverage_block_cache_count()) index=" +
            "$(renderer.coverage_block_cache_index_count()) hits=" +
            "$(renderer.coverage_block_cache_hit_count()) misses=" +
            "$(renderer.coverage_block_cache_miss_count()) evictions=" +
            "$(renderer.coverage_block_cache_eviction_count()) allocations=" +
            "$(renderer.coverage_block_allocation_count()) pages=" +
            "$(renderer.coverage_atlas_page_count()) glyph_slots=" +
            "$(renderer.coverage_glyph_slot_count()) draws=" +
            "$(renderer.coverage_glyph_draw_count()) instances=" +
            "$(renderer.coverage_glyph_instance_count()) snapshots=" +
            "$(renderer.drawing_snapshot_count()) drawings=" +
            "$(renderer.drawing_cache_count())"
        )
    }
    if probe.frames >= 256 {
        assert(renderer.coverage_block_cache_count() == 128)
        assert(renderer.coverage_block_cache_index_count() == 128)
        assert(renderer.coverage_block_cache_miss_count() >= 256)
        assert(renderer.coverage_block_cache_eviction_count() ==
            renderer.coverage_block_cache_miss_count() - 128)
        assert(renderer.coverage_block_allocation_count() == 128)
        assert(renderer.coverage_glyph_slot_count() == probe.stable_glyph_slots)
        assert(renderer.coverage_atlas_page_count() == 1)
        assert(renderer.drawing_cache_count() == probe.stable_drawing_cache)
        assert(renderer.drawing_snapshot_count() == 0)
        assert(renderer.coverage_glyph_draw_count() <= renderer.coverage_atlas_page_count())
        controller.stop()
        return
    }
    if let entity = probe.entity {
        var drawing = retained_churn_drawing(probe.frames + 1)
        world.update<Components.Canvas>(entity, func(canvas:&Components.Canvas) {
            canvas.replace(drawing)
        })
    }
    probe.frames++
}

test "bound retained text block GPU caches during long scrolling churn" {
    var application = Application()
    application.add_resource(RetainedChurnProbe())
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "Scene2D retained block churn"
        ..width = 180
        ..height = 24
        ..hidden = true
    ))
    application.add_plugin(Rendering.Plugin())
    application.add_plugin(Scene2D.Plugin())
    application.add_system(Application.Schedule.startup, create_retained_churn)
    application.add_after_system(Application.Schedule.render, verify_retained_churn)
    assert(application.run() == 0)
}

struct AtlasCorpus {
    let ordered:str
    let alternating:str
}

func atlas_scalar_text(scalar:uint32) str {
    var scalars:uint32[] = [scalar]
    match UTF8.from_scalars(@scalars[0:scalars.count()]) {
        failure(error) => { panic("invalid atlas test scalar $(scalar)") }
        success(value) => { return value }
    }
}

func atlas_corpus() AtlasCorpus {
    var face = required_face(Font.Face.default())
    var glyphs:str[] = []
    var scalar:uint32 = 33
    while scalar <= 2_047 as uint32 && glyphs.count() < 20 {
        let control = scalar >= 127 as uint32 && scalar <= 160 as uint32
        if !control && face.supports(scalar) {
            glyphs.append(atlas_scalar_text(scalar))
        }
        scalar++
    }
    assert(glyphs.count() == 20)
    var ordered = ""
    for glyph in glyphs { ordered = ordered + glyph }
    var alternating = ""
    var index = 0
    while index < glyphs.count() / 2 {
        alternating = alternating + glyphs[index]
        alternating = alternating + glyphs[glyphs.count() - index - 1]
        index++
    }
    return AtlasCorpus(ordered:ordered, alternating:alternating)
}

class AtlasBatchProbe {
    var frames:int = 0
    var entity:ECS.Entity? = null
}

func atlas_block_drawing(value:str) Canvas {
    var block = Canvas.TextBlock(
        value,
        Canvas.TextStyle(size:256.0, line_height:292.0)
    )
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text_block(
            block,
            Math.Vec2(),
            clip:Canvas.Rect(Math.Vec2(), Math.Vec2(256.0, 64.0))
        )
    })
    return drawing
}

func create_atlas_batch_text(world:&ECS.World, probe:&AtlasBatchProbe) {
    let corpus = atlas_corpus()
    var drawing = atlas_block_drawing(corpus.ordered)
    probe.entity = world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Canvas(drawing, 256, 64)
            ..space = Components.CanvasSpace.viewport
            ..text_mode = Scene2D.CanvasTextMode.coverage
            ..coverage_density = 2.0
        )
    )
}

func verify_atlas_page_batching(
    renderer:@Renderer,
    world:&ECS.World,
    probe:&AtlasBatchProbe,
    controller:&Application.Controller
) {
    if probe.frames == 0 {
        assert(renderer.coverage_atlas_page_count() > 1)
        if let entity = probe.entity {
            let corpus = atlas_corpus()
            var drawing = atlas_block_drawing(corpus.alternating)
            world.update<Components.Canvas>(entity, func(canvas:&Components.Canvas) {
                canvas.replace(drawing)
            })
        }
        probe.frames++
        return
    }
    assert(renderer.coverage_glyph_draw_count() > 1)
    assert(renderer.coverage_glyph_draw_count() <= renderer.coverage_atlas_page_count())
    controller.stop()
}

test "batch retained coverage by atlas page after the atlas grows" {
    var application = Application()
    application.add_resource(AtlasBatchProbe())
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "Scene2D atlas page batching"
        ..width = 256
        ..height = 64
        ..hidden = true
    ))
    application.add_plugin(Rendering.Plugin())
    application.add_plugin(Scene2D.Plugin())
    application.add_system(Application.Schedule.startup, create_atlas_batch_text)
    application.add_after_system(Application.Schedule.render, verify_atlas_page_batching)
    assert(application.run() == 0)
}
