use GFX.Assets.Image
use GFX.Color
use GFX.ECS
use GFX.GPU
use GFX.Scene2D
use GFX.Scene2D.Renderer
use STD.Math

func stripes() Image {
    var pixels:uint8[] = []
    for y in 0...4 {
        for x in 0...8 {
            if x < 4 {
                pixels.append(255 as uint8); pixels.append(0 as uint8); pixels.append(0 as uint8)
            } else {
                pixels.append(0 as uint8); pixels.append(0 as uint8); pixels.append(255 as uint8)
            }
            pixels.append(255 as uint8)
        }
    }
    return Image.rgba8(8, 4, pixels)
}

test "parallax repeats sprites and tile maps in two batches and retains visible cell data" {
    // No Application or Window: render directly into a GPU texture.
    var device = GPU.Device()
    var renderer = Renderer()
    renderer.start_offscreen(device, GPU.TextureFormat.rgba8_unorm)
    var images = Image.Store()
    let image = images.add(stripes())
    var world = ECS.World()
    let sprite_entity = world.spawn(ECS.EntityRecipe())
    let tile_entity = world.spawn(ECS.EntityRecipe())
    var sprite = Scene2D.Sprite(image:image, size:Math.Vec2(8.0, 4.0), pivot:Math.Vec2(0.0, 1.0))
    sprite.sampling(Scene2D.Sampling.pixelated)
    var tiles = Scene2D.TileMap(Scene2D.TileAtlas(image, 4, 4), 2, 1)
    tiles.set(0, 0, 0)
    tiles.set(1, 0, 1)
    let effect = Scene2D.Parallax(factor:Math.Vec2(0.2, 0.0), repeat_size:Math.Vec2(8.0, 0.0))
    var target = device.texture(GPU.TextureSettings(format:GPU.TextureFormat.rgba8_unorm,
        width:64, height:32, usage:GPU.TextureUsage.as_color_target()))
    var download = device.download_buffer(64 * 32 * 4)
    let cameras:float[] = [0.25, 0.5, 20.25, -19.75, 20.25, 20.25]
    var initial_builds = 0
    for frame, x in cameras.indexed() {
        if frame == 5 { tiles.set(0, 0, 1); tiles.set(1, 0, 0) }
        device.reset_command_stats()
        renderer.begin_prepare(Math.Vec2(64.0, 32.0), 1.0)
        // Vary camera Y too: the horizon must stay vertically fixed.
        renderer.consider_camera(Scene2D.Transform(position:Math.Vec2(x, frame as float * 3.0)), Scene2D.Camera())
        renderer.collect_sprite(device, sprite_entity,
            Scene2D.Transform(position:Math.Vec2(0.0, 4.0)), sprite, images, effect)
        renderer.collect_tile_map(device, tile_entity,
            Scene2D.Transform(position:Math.Vec2(0.0, -8.0)), tiles, images, effect)
        renderer.finish_prepare(device)
        assert(renderer.tile_draw_count() == 1)
        assert(renderer.tile_instance_count() >= 16 && renderer.tile_instance_count() <= 18)
        if frame == 0 { initial_builds = renderer.tile_preparation_build_count() }
        if frame == 1 {
            assert(renderer.tile_preparation_build_count() == initial_builds)
            assert(renderer.tile_instance_upload_count() == 1)
        }
        var commands = device.commands()
        var pass = commands.render(GPU.ColorTarget(texture:target, clear:Color.black()))
        renderer.draw(pass)
        pass.finish()
        assert(device.command_stats().draw_calls == 2)
        var transfer = commands.copy()
        transfer.download(GPU.TextureRegion(texture:target, width:64, height:32), download, 64, 32)
        transfer.finish()
        var complete = commands.submit_and_track()
        complete.wait()
        let pixels = download.read()
        for column in 0...64 {
            let position = column as float + 0.5 - 32.0 + x * 0.2
            let phase = position - Math.floor(position / 8.0) * 8.0
            let red = phase < 4.0
            for row in [10, 22] {
                let index = (row * 64 + column) * 4
                var expected_red = red
                if frame == 5 && row == 22 { expected_red = !red }
                if expected_red { assert(pixels[index] == 255 && pixels[index + 2] == 0) }
                else { assert(pixels[index] == 0 && pixels[index + 2] == 255) }
            }
        }
    }
    device.wait_until_idle()
}

test "world repetition covers rotated mirrored tile maps on both axes" {
    var device = GPU.Device()
    var renderer = Renderer()
    renderer.start_offscreen(device, GPU.TextureFormat.rgba8_unorm)
    var images = Image.Store()
    let image = images.add(Image.solid(Color.white()))
    var world = ECS.World()
    let entity = world.spawn(ECS.EntityRecipe())
    var tiles = Scene2D.TileMap(Scene2D.TileAtlas(image, 1, 1), 1, 1)
    tiles.set(0, 0, 0)
    let transform = Scene2D.Transform(rotation:Math.pi() * 0.5, scale:Math.Vec2(-8.0, 4.0))
    let effect = Scene2D.Parallax(factor:Math.Vec2(0.3, 0.1), repeat_size:Math.Vec2(4.0, 8.0))
    var target = device.texture(GPU.TextureSettings(format:GPU.TextureFormat.rgba8_unorm,
        width:32, height:32, usage:GPU.TextureUsage.as_color_target()))
    var download = device.download_buffer(32 * 32 * 4)
    let positions:float[] = [-50.25, -2.25, 60.25]
    for position in positions {
        device.reset_command_stats()
        renderer.begin_prepare(Math.Vec2(32.0), 1.0)
        renderer.consider_camera(Scene2D.Transform(position:Math.Vec2(position), rotation:0.2),
            Scene2D.Camera(zoom:1.25))
        renderer.collect_tile_map(device, entity, transform, tiles, images, effect)
        renderer.finish_prepare(device)
        var commands = device.commands()
        var pass = commands.render(GPU.ColorTarget(texture:target, clear:Color.black()))
        renderer.draw(pass)
        pass.finish()
        assert(device.command_stats().draw_calls == 1)
        var transfer = commands.copy()
        transfer.download(GPU.TextureRegion(texture:target, width:32, height:32), download, 32, 32)
        transfer.finish()
        var complete = commands.submit_and_track()
        complete.wait()
        let pixels = download.read()
        for pixel in 0...1024 { assert(pixels[pixel * 4] == 255) }
    }
    device.wait_until_idle()
}
