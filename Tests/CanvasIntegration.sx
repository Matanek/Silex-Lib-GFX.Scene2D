use GFX.Application
use GFX.Assets.Image
use GFX.Color
use GFX.Canvas
use GFX.Components
use GFX.ECS
use GFX.Rendering
use GFX.Scene2D
use GFX.Scene2D.Renderer
use GFX.Window.Plugin as WindowPlugin
use STD.Math

func create_scene(world:&ECS.World, images:&Image.Store) {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(Math.Vec2(16.0), 12.0),
            Canvas.Fill.solid(Color.sky_400())
        )
        painter.stroke(
            Canvas.Line(Math.Vec2(4.0, 16.0), Math.Vec2(28.0, 16.0)),
            Canvas.Stroke(Color.white(), 2.0)..cap = Canvas.StrokeCap.round
        )
        painter.text(
            "2D",
            Math.Vec2(8.0, 9.0),
            Canvas.TextStyle(size:9.0, color:Color.white(), font:Canvas.Font.default())
        )
    })
    world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(drawing, 32, 32)
            ..anchor = Math.Vec2(0.5)
            ..pivot = Math.Vec2(0.5)
            ..space = Scene2D.CanvasSpace.viewport
        )
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Math.Vec2(-12.0, 0.0)))
        ..with(Components.Canvas(drawing, 32, 32))
    )
    var local_drawing = Canvas()
    local_drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(Math.Vec2(), 6.0),
            Canvas.Fill.solid(Color.amber_400())
        )
        painter.text(
            "origin",
            Math.Vec2(-8.0, -4.0),
            Canvas.TextStyle(size:6.0, color:Color.white())
        )
    })
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Math.Vec2(12.0, 12.0)))
        ..with(Components.Canvas(local_drawing)..layer = 1)
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Math.Vec2(-16.0, -16.0)))
        ..with(Components.Canvas(drawing, 32, 32)
            ..space = Components.CanvasSpace.viewport
            ..anchor = Math.Vec2(1.0)
        )
    )
    var transformed = Scene2D.Canvas(drawing, 32, 32)
    transformed.size = Math.Vec2(24.0, 18.0)
    transformed.pivot = Math.Vec2(0.25, 0.75)
    transformed.color = Color.violet_400()
    transformed.layer = 2
    transformed.depth = 0.5
    world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform(
            position:Math.Vec2(12.0, 0.0),
            rotation:Math.pi() * 0.25,
            scale:Math.Vec2(1.5, 0.75)
        ))
        ..with(transformed)
    )
    let image = images.add(Image.solid(Color.cyan_400()))
    world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform(position:Math.Vec2(0.0, 16.0)))
        ..with(Scene2D.Sprite(image:image, size:Math.Vec2(8.0)))
    )
    var tiles = Scene2D.TileMap(Scene2D.TileAtlas(image, 1, 1), 8, 8)
    tiles.set(0, 0, 0)
    tiles.set(7, 7, 0)
    world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform(position:Math.Vec2(-4.0, -4.0)))
        ..with(tiles)
    )
}

struct FrameCount { var value:int }

func verify_after_render(
    renderer:@Renderer,
    frames:&FrameCount,
    controller:&Application.Controller
) {
    frames.value++
    if frames.value < 2 { return }
    assert(renderer.tile_instance_count() == 2)
    assert(renderer.tile_draw_count() == 1)
    assert(renderer.tile_instance_upload_count() == 1)
    assert(renderer.tile_instance_allocation_count() == 1)
    controller.stop()
}

test "render retained canvases and sprites through Scene2D" {
    var application = Application()
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "Scene2D Canvas integration"
        ..width = 64
        ..height = 64
        ..hidden = true
    ))
    application.add_plugin(Rendering.Plugin(Rendering.Plugin.Settings()
        ..clear = Color.black()
    ))
    application.add_plugin(Scene2D.Plugin())
    application.add_resource(FrameCount())
    application.add_system(Application.Schedule.startup, create_scene)
    application.add_after_system(Application.Schedule.render, verify_after_render)
    assert(application.run() == 0)
}
