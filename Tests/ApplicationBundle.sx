use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.ECS
use GFX.Plugins
use GFX.Resources
use GFX.Scene2D
use GFX.Scene2D.Renderer
use GFX.Window.Plugin as WindowPlugin
use STD.Math

struct SceneNumber { let value:int }
struct LocalCanvas { let scene:int }

class Probe {
    var frames:int
    var cache_counts:int[]
    var snapshot_counts:int[]
    var geometry_refresh_counts:int[]

    init() {
        self.frames = 0
        self.cache_counts = []
        self.snapshot_counts = []
        self.geometry_refresh_counts = []
    }
}

func create_canvas(number:@SceneNumber, world:&ECS.World) {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(Math.Vec2(8.0), 6.0),
            Canvas.Fill.solid(Color.cyan_400())
        )
    })
    world.spawn(ECS.EntityRecipe()
        ..with(LocalCanvas(scene:number.value))
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(drawing, 16, 16))
    )
}

func inspect_canvas(
    number:@SceneNumber,
    query:ECS.Query<(@LocalCanvas, @Scene2D.Canvas)>,
    renderer:@Renderer,
    probe:&Probe,
    bundles:&Application.BundleManager,
    controller:&Application.Controller
) {
    var count = 0
    for (marker, canvas) in query {
        assert(marker.scene == number.value)
        assert(canvas.width() == 16)
        count++
    }
    assert(count == 1)
    probe.frames++
    probe.cache_counts.append(renderer.drawing_cache_count())
    probe.snapshot_counts.append(renderer.drawing_snapshot_count())
    probe.geometry_refresh_counts.append(renderer.geometry_refresh_count())
    if number.value == 1 && probe.frames == 2 {
        bundles.replace(bundles.create()
            ..add_resource(SceneNumber(value:2))
            ..add_system(Application.Schedule.startup, create_canvas)
            ..add_after_system(Application.Schedule.render, inspect_canvas)
        )
    } elif number.value == 2 {
        controller.stop()
    }
}

test "reuse Canvas geometry across unchanged frames and scene replacement" {
    var application = Application()
    var probe = Probe()
    var bundle = Application.Bundle(application)
        ..add_resource(SceneNumber(value:1))
        ..add_system(Application.Schedule.startup, create_canvas)
        ..add_after_system(Application.Schedule.render, inspect_canvas)

    application
        ..add_resource(probe)
        ..add_plugin(WindowPlugin(WindowPlugin.Settings()
            ..title = "Scene2D application scene"
            ..width = 32
            ..height = 32
            ..hidden = true
        ))
        ..add_plugin(Scene2D.Plugin())
        ..add_plugin(Application.BundleManager(bundle))

    assert(application.run() == 0)
    assert(probe.frames == 3)
    assert(probe.cache_counts.count() == 3)
    assert(probe.snapshot_counts.count() == 3)
    assert(probe.geometry_refresh_counts.count() == 3)
    for index in 0...3 {
        assert(probe.cache_counts[index] == 1)
        assert(probe.snapshot_counts[index] == 1)
        assert(probe.geometry_refresh_counts[index] == 1)
    }
}

func inspect_direct_canvas(
    query:ECS.Query<(@LocalCanvas, @Scene2D.Canvas)>,
    renderer:@Renderer,
    controller:&Application.Controller
) {
    var count = 0
    for (marker, canvas) in query {
        assert(marker.scene == 1)
        assert(canvas.width() == 16)
        count++
    }
    assert(count == 1)
    assert(renderer.drawing_cache_count() == 1)
    controller.stop()
}

test "install Scene2D directly inside an Application Bundle" {
    var application = Application()
    var bundle = Application.Bundle(application)
        ..add_resource(SceneNumber(value:1))
        ..add_plugin(WindowPlugin(WindowPlugin.Settings()
            ..title = "Bundle-owned Scene2D"
            ..width = 32
            ..height = 32
            ..hidden = true
        ))
        ..add_plugin(Scene2D.Plugin())
        ..add_system(Application.Schedule.startup, create_canvas)
        ..add_after_system(Application.Schedule.render, inspect_direct_canvas)

    application.add_plugin(Application.BundleManager(bundle))
    assert(application.run() == 0)
    assert(bundle.is_finalized())
}

func inspect_bundle_camera(
    camera:@Resources.ViewportCamera2D,
    cameras:ECS.Query<(@Scene2D.Transform, @Scene2D.Camera)>,
    controller:&Application.Controller
) {
    var count = 0
    for (transform, component) in cameras {
        assert(component.is_active())
        assert(transform.position.x == camera.position().x)
        assert(transform.position.y == camera.position().y)
        assert(transform.position.x == 96.0)
        assert(transform.position.y == 64.0)
        count++
    }
    assert(count == 1)
    controller.stop()
}

test "propagate ViewportCamera2D into an Application Bundle world" {
    var application = Application()
    var bundle = Application.Bundle(application)
        ..add_system(Application.Schedule.update, inspect_bundle_camera)

    application
        ..add_plugin(WindowPlugin(WindowPlugin.Settings()
            ..title = "Bundle-local Scene2D camera"
            ..width = 64
            ..height = 64
            ..hidden = true
        ))
        ..add_plugin(Plugins.ViewportCamera2D(
            Plugins.ViewportCamera2D.Settings()
                ..position = Math.Vec2(96.0, 64.0)
        ))
        ..add_plugin(Application.BundleManager(bundle))

    assert(application.run() == 0)
    assert(bundle.is_finalized())
}
