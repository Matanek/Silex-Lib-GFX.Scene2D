use GFX.Application
use GFX.Assets.Image
use GFX.Color
use GFX.ECS
use GFX.Rendering
use GFX.Scene2D
use GFX.Window.Plugin as WindowPlugin
use STD.Math

func create_compatible_sprites(world:&ECS.World, images:&Image.Store) {
    let image = images.add(Image.solid(Color.white()))
    world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform(position:Math.Vec2(-4.0, 0.0)))
        ..with(Scene2D.Sprite(image:image, size:Math.Vec2(4.0)))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform(position:Math.Vec2(4.0, 0.0)))
        ..with(Scene2D.Sprite(image:image, size:Math.Vec2(4.0)))
    )
}

func create_split_sprites(world:&ECS.World, images:&Image.Store) {
    let image = images.add(Image.solid(Color.white()))
    world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform(position:Math.Vec2(-4.0, 0.0)))
        ..with(Scene2D.Sprite(image:image, size:Math.Vec2(4.0)))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform())
        ..with(Scene2D.Sprite(image:image, size:Math.Vec2(4.0)))
    )
    var pixelated = Scene2D.Sprite(image:image, size:Math.Vec2(4.0))
    pixelated.sampling(Scene2D.Sampling.pixelated)
    world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform(position:Math.Vec2(4.0, 0.0)))
        ..with(pixelated)
    )
}

func require_one_sprite_batch(
    renderer:@Rendering.Renderer,
    controller:&Application.Controller
) {
    assert(renderer.stats().draw_calls() == 1)
    assert(renderer.stats().instances() == 2)
    controller.stop()
}

func require_sampler_split(
    renderer:@Rendering.Renderer,
    controller:&Application.Controller
) {
    assert(renderer.stats().draw_calls() == 2)
    assert(renderer.stats().instances() == 3)
    controller.stop()
}

func sprite_application(title:str) Application {
    var application = Application()
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = title
        ..width = 32
        ..height = 32
        ..hidden = true
    ))
    application.add_plugin(Rendering.Plugin(Rendering.Plugin.Settings()
        ..clear = Color.black()
    ))
    application.add_plugin(Scene2D.Plugin())
    return application
}

test "batch adjacent sprites sharing texture sampler and scene space" {
    var application = sprite_application("Scene2D sprite batching")
    application.add_system(Application.Schedule.startup, create_compatible_sprites)
    application.add_after_system(
        Application.Schedule.render,
        require_one_sprite_batch
    )
    assert(application.run() == 0)
}

test "split sprite batches when their samplers differ" {
    var application = sprite_application("Scene2D sprite sampler batches")
    application.add_system(Application.Schedule.startup, create_split_sprites)
    application.add_after_system(
        Application.Schedule.render,
        require_sampler_split
    )
    assert(application.run() == 0)
}
