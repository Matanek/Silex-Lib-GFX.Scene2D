use GFX.Scene2D.SurfaceCachePolicy.SurfaceCachePolicy

test "a cached header stays leased while preparing new rows" {
    var cache = SurfaceCachePolicy(4)
    cache.enter()
    for expected in [0,1,2,3] { assert(cache.acquire() == expected) }
    assert(cache.leave() == 4)
    cache.enter()
    cache.pin(0)
    assert(cache.acquire() == 1, "row preparation evicted the pending header")
    assert(cache.leased(0))
    assert(cache.leave() == 4)
}

test "nested preparation may exceed cache capacity until the enclosing draw completes" {
    var cache = SurfaceCachePolicy(128)
    cache.enter()
    var index = 0
    while index < 144 {
        cache.enter()
        assert(cache.acquire() == index, "a dependency was replaced before its parent was drawn")
        assert(cache.leave() == index + 1)
        index++
    }
    assert(cache.count() == 144 && cache.leased(0) && cache.leased(143))
    assert(cache.leave() == 128)
    assert(cache.count() == 128 && !cache.leased(0))
}

test "a frame retains leases across separate canvas preparations and then bounds the idle cache" {
    var cache = SurfaceCachePolicy(2)
    cache.enter()
    cache.enter()
    let header = cache.acquire()
    assert(cache.leave() == 1 && cache.leased(header))
    cache.enter()
    assert(cache.acquire() == 1)
    assert(cache.acquire() == 2)
    assert(cache.leave() == 3 && cache.leased(header))
    assert(cache.leave() == 2 && !cache.leased(header))
    cache.enter()
    assert(cache.acquire() < 2)
    assert(cache.leave() == 2)
}

test "repeated cache hits do not consume another lease and completed scopes release overflow" {
    var cache = SurfaceCachePolicy(2)
    for cycle in [0,1,2,3] {
        cache.enter()
        if cache.count() == 0 { assert(cache.acquire() == 0); assert(cache.acquire() == 1) }
        assert(cache.leave() == 2)
        cache.enter()
        cache.pin(0); cache.pin(0); cache.pin(0)
        assert(cache.acquire() == 1)
        assert(cache.acquire() == 2)
        assert(cache.acquire() == 3)
        assert(cache.leave() == 2)
    }
}
