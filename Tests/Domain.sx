use GFX.Scene2D.Camera
use GFX.Scene2D.Canvas as SceneCanvas
use GFX.Scene2D.Grid
use GFX.Scene2D.Sampling
use GFX.Scene2D.Sprite
use GFX.Scene2D.Transform
use GFX.Scene2D.TileAtlas
use GFX.Scene2D.TileMap
use GFX.Assets.Image
use STD.Math
use GFX.Canvas.Canvas as AuthoredCanvas

test "name 2D concepts through their domain instead of their declarations" {
    let transform = Transform(position:Math.Vec2(12.0, 8.0))
    let camera = Camera(zoom:2.0)
    let grid = Grid(spacing:0.5)
    var drawing = SceneCanvas(AuthoredCanvas(), 16, 16)
    var sprite = Sprite(size:Math.Vec2(32.0, 16.0))
    sprite.sampling(Sampling.pixelated)

    assert(transform.position == Math.Vec2(12.0, 8.0))
    assert(camera.is_active())
    assert(grid.spacing == 0.5)
    assert(drawing.width() == 16)
    assert(sprite.sampling() == Sampling.pixelated)
}

test "share one retained compilation across static Canvas placements" {
    var source = AuthoredCanvas()
    var first = SceneCanvas(source)
    var second = SceneCanvas(source)

    assert(first.prepared_revision() == second.prepared_revision())
}

test "separate static and mutable Canvas cache identities" {
    var source = AuthoredCanvas()
    var placement = SceneCanvas(source)
    let placement_revision = placement.revision()
    let retained_revision = placement.prepared_revision()

    source.clear()
    assert(placement.revision() > placement_revision)
    placement.synchronize()

    assert(placement.prepared_revision() != retained_revision)
}

test "project positive world Y toward the top of the viewport" {
    let camera = Camera()
    let transform = Transform()
    let viewport = Math.Vec2(100.0)
    let center = camera.project(Math.Vec2(), transform, viewport)!
    let above = camera.project(Math.Vec2(0.0, 10.0), transform, viewport)!

    assert(center.nearly_equal(Math.Vec2(50.0)))
    assert(above.y < center.y)
}

test "canvas model preserves 2D pivot scale rotation and depth" {
    var drawing = SceneCanvas(AuthoredCanvas(), 20, 10)
    drawing.size = Math.Vec2(40.0, 30.0)
    drawing.pivot = Math.Vec2(0.25, 0.5)
    drawing.depth = 0.75
    let transform = Transform(
        position:Math.Vec2(12.0, 8.0),
        rotation:Math.pi() * 0.5,
        scale:Math.Vec2(2.0, 3.0)
    )
    let model = drawing.model(transform, Math.Vec2(100.0))
    let origin = model.multiply(Math.Vec4(0.0, 0.0, 0.0, 1.0))
    let horizontal = model.multiply(Math.Vec4(1.0, 0.0, 0.0, 0.0))
    let vertical = model.multiply(Math.Vec4(0.0, 1.0, 0.0, 0.0))

    assert(origin.nearly_equal(Math.Vec4(-33.0, -12.0, 0.75, 1.0)))
    assert(horizontal.nearly_equal(Math.Vec4(0.0, 4.0, 0.0, 0.0)))
    assert(vertical.nearly_equal(Math.Vec4(9.0, 0.0, 0.0, 0.0)))
}

test "place an unbounded canvas directly from its local origin" {
    var drawing = SceneCanvas(AuthoredCanvas())
    assert(!drawing.is_framed())
    assert(drawing.width() == 0)
    assert(drawing.height() == 0)

    let transform = Transform(
        position:Math.Vec2(20.0, 30.0),
        rotation:Math.pi() * 0.5,
        scale:Math.Vec2(2.0, 3.0)
    )
    let model = drawing.model(transform, Math.Vec2(100.0))
    let origin = model.multiply(Math.Vec4(0.0, 0.0, 0.0, 1.0))
    let horizontal = model.multiply(Math.Vec4(1.0, 0.0, 0.0, 0.0))
    let vertical = model.multiply(Math.Vec4(0.0, 1.0, 0.0, 0.0))

    assert(origin.nearly_equal(Math.Vec4(20.0, 30.0, 0.0, 1.0)))
    assert(horizontal.nearly_equal(Math.Vec4(0.0, 2.0, 0.0, 0.0)))
    assert(vertical.nearly_equal(Math.Vec4(3.0, 0.0, 0.0, 0.0)))
    assert(drawing.text_size(Math.Vec2(12.0, 8.0)) == Math.Vec2(12.0, 8.0))
    assert(drawing.text_pivot(
        Math.Vec2(-6.0, -2.0),
        Math.Vec2(12.0, 8.0)
    ) == Math.Vec2(0.5, 0.25))
}

test "retain sparse tile fields and map local coordinates" {
    var images = Image.Store()
    let image = images.add(Image())
    let atlas = TileAtlas(image, 8, 8)
    var field = TileMap(atlas, 64, 48)

    assert(field.columns() == 64)
    assert(field.rows() == 48)
    assert(field.size() == Math.Vec2(512.0, 384.0))
    assert(field.tile(7, 3) == null)
    let original_revision = field.revision()
    field.set(7, 3, 5)
    assert(field.tile(7, 3)! == 5)
    assert(field.revision() == original_revision + 1)
    field.set(7, 3, 5)
    assert(field.revision() == original_revision + 1)
    field.clear(7, 3)
    assert(field.tile(7, 3) == null)

    let coordinate = field.coordinate_at(Math.Vec2(63.0, 31.0))!
    assert(coordinate.column == 7)
    assert(coordinate.row == 3)
    assert(field.cell_origin(7, 3) == Math.Vec2(56.0, 24.0))
    assert(field.cell_center(7, 3) == Math.Vec2(60.0, 28.0))
    assert(field.coordinate_at(Math.Vec2(-0.1, 0.0)) == null)
    assert(field.coordinate_at(field.size()) == null)
}

test "bound tile preparation to the guarded visible cell range" {
    var images = Image.Store()
    let atlas = TileAtlas(images.add(Image()), 16, 16)
    let field = TileMap(atlas, 10_000, 10_000)

    let middle = field.visible_range(
        Math.Vec2(1600.0, 3200.0),
        Math.Vec2(1760.0, 3360.0)
    )
    assert(middle.first_column == 99)
    assert(middle.first_row == 199)
    assert(middle.last_column == 111)
    assert(middle.last_row == 211)

    let edge = field.visible_range(Math.Vec2(-100.0), Math.Vec2(8.0))
    assert(edge.first_column == 0)
    assert(edge.first_row == 0)
    assert(edge.last_column == 2)
    assert(edge.last_row == 2)
}
