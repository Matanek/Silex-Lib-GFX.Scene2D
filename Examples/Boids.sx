use GFX.Application
use GFX.Color
use GFX.Canvas
use GFX.Components
use GFX.ECS
use GFX.Plugins
use GFX.Resources
use STD.Math
use STD.Process
use STD.Randomizer
use STD.Time.Clock

static struct Constants {
    let canvas_width:int = 960
    let canvas_height:int = 640
    let boid_count:int = 2000
    let neighborhood_radius:float = 48.0
    let separation_radius:float = 22.0
    let minimum_speed:float = 50.0
    let maximum_speed:float = 115.0
    let maximum_steering:float = 150.0
    let visible_half_width:float = Constants.canvas_width as float * 0.5 - 8.0
    let visible_half_height:float = Constants.canvas_height as float * 0.5 - 8.0
    let boundary_margin:float = 84.0
}

struct Boid {
    var velocity:Math.Vec2
}

struct Sample {
    let position_x:float
    let position_y:float
    let velocity_x:float
    let velocity_y:float
}

struct FlockSnapshot {
    var boids:Sample[]

    init() { self.boids = [] }
}

struct Benchmark {
    var clock:Clock
    var elapsed:float
    var frames:int
    var started:bool

    init() {
        self.clock = Clock()
        self.elapsed = 0.0
        self.frames = 0
        self.started = false
    }
}

func random_range(randomizer:Randomizer, minimum:float, maximum:float) float {
    return minimum + randomizer.get_float() * (maximum - minimum)
}

func boid_color(index:int) Color {
    if index % 3 == 0 { return Color.sky_300() }
    if index % 3 == 1 { return Color.cyan_400() }
    return Color.indigo_400()
}

func boid_drawing() Canvas {
    var shape = Canvas.Path()
        ..move_to(Math.Vec2(16.0, 8.0))
        ..line_to(Math.Vec2(1.0, 14.0))
        ..line_to(Math.Vec2(5.0, 8.0))
        ..line_to(Math.Vec2(1.0, 2.0))
        ..close()
    return Canvas()
        ..paint(func(painter:&Canvas.Painter) {
            painter.fill(shape, Canvas.Fill.solid(Color.white()))
        })
}

func create_flock(world:&Resources.World) {
    var randomizer = Randomizer(0x51_1E_80_1D)
    var drawing = boid_drawing()
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Camera2D())
    )
    for index in 0...Constants.boid_count {
        let position = Math.Vec2(
            random_range(
                randomizer,
                -Constants.visible_half_width,
                Constants.visible_half_width
            ),
            random_range(
                randomizer,
                -Constants.visible_half_height,
                Constants.visible_half_height
            )
        )
        let angle = random_range(randomizer, 0.0, Math.two_pi())
        let speed = random_range(
            randomizer,
            Constants.minimum_speed,
            Constants.maximum_speed
        )
        let velocity = Math.Vec2(Math.cos(angle), Math.sin(angle)).multiply(speed)
        world.spawn(ECS.EntityRecipe()
            ..with(Boid(velocity:velocity))
            ..with(Components.Transform2D(position:position, rotation:angle))
            ..with(Components.Canvas(drawing, 16, 16)
                ..color = boid_color(index)
                ..layer = 1
            )
        )
    }
}

func capture_flock(
    snapshot:&FlockSnapshot,
    query:ECS.Query<(@Boid, @Components.Transform2D)>
) {
    snapshot.boids.clear()
    for (boid, transform) in query {
        snapshot.boids.append(Sample(
            position_x:transform.position.x,
            position_y:transform.position.y,
            velocity_x:boid.velocity.x,
            velocity_y:boid.velocity.y
        ))
    }
}

func flock_steering(
    position:Math.Vec2,
    velocity:Math.Vec2,
    boids:@Sample[..]
) Math.Vec2 {
    var separation_x = 0.0
    var separation_y = 0.0
    var center_x = 0.0
    var center_y = 0.0
    var heading_x = 0.0
    var heading_y = 0.0
    var neighbors = 0
    let neighborhood_squared = Constants.neighborhood_radius *
        Constants.neighborhood_radius
    let separation_squared = Constants.separation_radius *
        Constants.separation_radius

    for other in boids {
        let offset_x = position.x - other.position_x
        let offset_y = position.y - other.position_y
        let distance_squared = offset_x * offset_x + offset_y * offset_y
        if distance_squared > 0.0 && distance_squared < neighborhood_squared {
            if distance_squared < separation_squared {
                var divisor = 1.0
                if distance_squared > 1.0 { divisor = distance_squared }
                separation_x += offset_x / divisor
                separation_y += offset_y / divisor
            }
            let facing = velocity.x * -offset_x + velocity.y * -offset_y
            if facing > 0.0 {
                center_x += other.position_x
                center_y += other.position_y
                heading_x += other.velocity_x
                heading_y += other.velocity_y
                neighbors++
            }
        }
    }

    var cohesion_x = 0.0
    var cohesion_y = 0.0
    var alignment_x = 0.0
    var alignment_y = 0.0
    if neighbors > 0 {
        let count = neighbors as float
        cohesion_x = (center_x / count - position.x) * 0.65
        cohesion_y = (center_y / count - position.y) * 0.65
        alignment_x = (heading_x / count - velocity.x) * 0.85
        alignment_y = (heading_y / count - velocity.y) * 0.85
    }

    return Math.Vec2(
        cohesion_x + alignment_x + separation_x * 1350.0,
        cohesion_y + alignment_y + separation_y * 1350.0
    )
}

func boundary_steering(position:Math.Vec2) Math.Vec2 {
    let inner_width = Constants.visible_half_width - Constants.boundary_margin
    let inner_height = Constants.visible_half_height - Constants.boundary_margin
    var x = 0.0
    var y = 0.0
    if position.x < -inner_width { x = (-inner_width - position.x) * 3.0 }
    else if position.x > inner_width { x = (inner_width - position.x) * 3.0 }
    if position.y < -inner_height { y = (-inner_height - position.y) * 3.0 }
    else if position.y > inner_height { y = (inner_height - position.y) * 3.0 }
    return Math.Vec2(x, y)
}

func limit(value:Math.Vec2, maximum:float) Math.Vec2 {
    let length = value.length()
    if length > maximum { return value.multiply(maximum / length) }
    return value
}

func keep_speed(value:Math.Vec2) Math.Vec2 {
    let speed = value.length()
    if speed > Constants.maximum_speed {
        return value.multiply(Constants.maximum_speed / speed)
    }
    if speed < Constants.minimum_speed && speed > 0.0 {
        return value.multiply(Constants.minimum_speed / speed)
    }
    return value
}

func keep_inside(position:Math.Vec2, boid:&Boid) Math.Vec2 {
    var contained = position
    if contained.x < -Constants.visible_half_width {
        contained.x = -Constants.visible_half_width
        if boid.velocity.x < 0.0 { boid.velocity.x = -boid.velocity.x }
    } else if contained.x > Constants.visible_half_width {
        contained.x = Constants.visible_half_width
        if boid.velocity.x > 0.0 { boid.velocity.x = -boid.velocity.x }
    }
    if contained.y < -Constants.visible_half_height {
        contained.y = -Constants.visible_half_height
        if boid.velocity.y < 0.0 { boid.velocity.y = -boid.velocity.y }
    } else if contained.y > Constants.visible_half_height {
        contained.y = Constants.visible_half_height
        if boid.velocity.y > 0.0 { boid.velocity.y = -boid.velocity.y }
    }
    return contained
}

func benchmark(benchmark:&Benchmark, controller:&Application.Controller) {
    let delta = benchmark.clock.tick()
    if !benchmark.started {
        benchmark.started = true
        return
    }
    benchmark.elapsed += delta
    benchmark.frames++
    if benchmark.elapsed >= 5.0 {
        print("SILEX_GFX_BOIDS count=$(Constants.boid_count) fps=$(benchmark.frames as float / benchmark.elapsed)")
        controller.stop()
    }
}

func option_requested(expected:str) bool {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == expected { return true }
            }
        }
    }
    return false
}

func move_flock(
    time:@Resources.FrameTime,
    snapshot:@FlockSnapshot,
    query:ECS.Query<(&Boid, &Components.Transform2D)>
) {
    let samples = @snapshot.boids[0:snapshot.boids.count()]
    for (boid, transform) in query {
        let flock_acceleration = limit(
            flock_steering(transform.position, boid.velocity, samples),
            Constants.maximum_steering * 0.7
        )
        let acceleration = limit(
            flock_acceleration.add(boundary_steering(transform.position)),
            Constants.maximum_steering
        )
        boid.velocity = keep_speed(
            boid.velocity.add(acceleration.multiply(time.delta))
        )
        transform.position = keep_inside(
            transform.position.add(boid.velocity.multiply(time.delta)),
            boid
        )
        transform.rotation = Math.atan2(boid.velocity.y, boid.velocity.x)
    }
}

func main() {
    var application = Application()

    // Keep the historical switch to compare the parallel query path with its
    // single-worker baseline when investigating scheduler performance.
    if option_requested("--one-worker") {
        application = Application(1)
    }

    application
        ..add_resource(FlockSnapshot())
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "Boids"
            ..width = Constants.canvas_width
            ..height = Constants.canvas_height
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_950()
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.Time())
        ..add_system(Application.Schedule.startup, create_flock)
        ..add_system(Application.Schedule.update, capture_flock)
        ..add_system(Application.Schedule.update, move_flock)

    let benchmark_requested = option_requested("--benchmark")
    if !benchmark_requested {
        application.add_plugin(Plugins.FPSPanel())
    }
    if benchmark_requested {
        application.add_resource(Benchmark())
        application.add_after_system(Application.Schedule.render, benchmark)
    }

    application.run()
}
